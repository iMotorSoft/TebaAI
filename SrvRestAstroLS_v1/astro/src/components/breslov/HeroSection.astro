---
import RebbeNajmanIdentity from "./RebbeNajmanIdentity.astro";
import FloralMark from "./FloralMark.astro";
import HeroQuote from "./HeroQuote.astro";
import BriCollaborationCard from "./BriCollaborationCard.astro";
---

<section class="hero-section" id="acerca" aria-labelledby="breslov-title">
  <div class="hero-copy">
    <div class="hero-identity"><RebbeNajmanIdentity /></div>
    <h1 id="breslov-title"><span>BRESLOV</span> <span>RESEARCH</span></h1>
    <div class="gold-divider" aria-hidden="true"><i></i><FloralMark size={22} /><i></i></div>
    <p class="hero-tagline">Investigación verdadera. Fuentes originales. Comprensión más profunda.</p>
    <p class="hero-description">Una plataforma de investigación conversacional basada en el corpus auténtico de las enseñanzas de Rebe Najmán de Breslov y sus discípulos.</p>
    <div class="hero-bri"><BriCollaborationCard /></div>
  </div>
  <div class="hero-visual">
    <img src="/breslov/contemplative-valley-1200.webp" srcset="/breslov/contemplative-valley-768.webp 768w, /breslov/contemplative-valley-1200.webp 1200w, /breslov/contemplative-valley-1600.webp 1600w" sizes="(max-width: 959px) 100vw, 52vw" width="1672" height="941" alt="Sendero rural junto a un valle en luz dorada" loading="eager" fetchpriority="high" />
    <HeroQuote />
  </div>
  <div class="mobile-bri"><BriCollaborationCard /></div>
</section>

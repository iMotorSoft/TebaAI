---
import "../assets/app.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Breslov Research — Investigación de fuentes y conceptos en la literatura Breslov",
  description = "Herramienta de investigación para localizar conceptos, citas y relaciones en obras de Breslov, con referencias verificables en español, inglés y hebreo.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://breslov.tebaai.live");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#061f3b" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Breslov Research" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir al contenido principal</a>
    <slot />
  </body>
</html>

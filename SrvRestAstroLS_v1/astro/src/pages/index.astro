---
import PublicLayout from "../layouts/PublicLayout.astro";
import HomeHeader from "../components/breslov/HomeHeader.astro";
import HeroSection from "../components/breslov/HeroSection.astro";
import CapabilityGrid from "../components/breslov/CapabilityGrid.astro";
import StudyCta from "../components/breslov/StudyCta.astro";
import HomeFooter from "../components/breslov/HomeFooter.astro";
import "../assets/investigative-home.css";
---

<PublicLayout
  title="Breslov Research — Investigación de fuentes y conceptos en la literatura Breslov"
  description="Herramienta de investigación para localizar conceptos, citas y relaciones en obras de Breslov, con referencias verificables en español, inglés y hebreo."
>
  <main class="breslov-home" id="main-content">
    <div class="hero-shell">
      <HomeHeader />
      <HeroSection />
    </div>
    <CapabilityGrid />
    <StudyCta />
  </main>
  <HomeFooter />
</PublicLayout>

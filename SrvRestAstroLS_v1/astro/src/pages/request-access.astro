---
import PublicLayout from "../layouts/PublicLayout.astro";
---
<PublicLayout title="Solicitar acceso — Breslov Research">
  <main class="access-page">
    <a href="/" class="access-back">← Breslov Research</a>
    <section aria-labelledby="access-title">
      <p class="section-kicker">Acceso privado</p>
      <h1 id="access-title">Solicitar acceso</h1>
      <p>El espacio de investigación está reservado para investigadores y estudiosos. Escribinos para iniciar el proceso de acceso.</p>
      <a class="login-button" href="mailto:acceso@tebaai.live?subject=Solicitud%20de%20acceso%20a%20Breslov%20Research">Solicitar acceso por correo <span aria-hidden="true">→</span></a>
    </section>
  </main>
</PublicLayout>

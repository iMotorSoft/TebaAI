    "chunk_index": 380,
    "page_start": 117,
    "page_end": 117,
    "content": "> **Halakhah 3** ������ **Halajá 3**",
    "content_sha256": "d67ae45a4885f9e59ad60792b013c20f966754285b72f9a0d168d8b3e58f70f1",
    "printed_page_label": null

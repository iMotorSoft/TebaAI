            "bbox": [
              56.6929931640625,
              340.71795654296875,
              445.15301513671875,
              350.85797119140625
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "alma - como nosotros hoy en día, en esta era anterior a la llegada del Mashíaj, ",
            "sizes": [
              10.0
            ]
          },

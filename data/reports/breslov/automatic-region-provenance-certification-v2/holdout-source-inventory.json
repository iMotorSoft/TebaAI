              424.8489990234375,
              485.81500244140625
            ],
            "ids": [
              [
                17,
                0
              ]
            ],
            "text": "“Pero los sabios ",
            "sizes": [
              8.0
            ]
          },
          {
            "bbox": [
              367.93701171875,
              489.3349609375,
              422.61700439453125,
              496.9509582519531
            ],
            "ids": [
              [
                17,
                1
              ]
            ],
            "text": "resplandecerán ",
            "sizes": [
              8.0
            ]
          },
          {
            "bbox": [
              367.93701171875,

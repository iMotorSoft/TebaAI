              445.15570068359375,
              240.0769500732422
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "esto podemos ver que al juzgar favorablemente, incluso un pequeño punto es ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693603515625,
              241.8069610595703,
              215.2115936279297,
              252.06695556640625
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "sufi ciente para instilar santidad.",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.6929931640625,
          254.96194458007812,
          445.1666564941406,
          326.9119873046875
        ],
        "lines": [
          {
            "bbox": [
              85.09359741210938,
              254.96194458007812,
              445.16558837890625,
              266.9119567871094
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "Ésta es también la idea de que todos dicen “¡Santifi cado! ¡Santifi cado!” ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693634033203125,
              268.6419372558594,
              445.0697326660156,
              278.9119567871094
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "- signifi cando que mediante sus palabras, i.e., elevando los puntos buenos ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.69361877441406,
              280.7055358886719,
              445.1666564941406,
              290.9019470214844
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "hacia la dimensión del dibur, elevan a la luna desde un estado de defecto y de ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.69361877441406,
              292.7419738769531,
              445.166015625,
              302.9019775390625
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "disminución.[113 ]Sus palabras llevan a la luna a un estado de tikún y de plenitud, ",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              304.6419677734375,
              445.1640319824219,
              314.9119873046875
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "que es su santifi cación. Y todo esto se produjo a través de un mero punto de luz ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693023681640625,
              317.0519714355469,
              211.79306030273438,
              326.9119873046875
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "que vieron en la luna creciente.",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          85.09302520751953,
          334.5909729003906,
          414.1949157714844,
          381.3110046386719
        ],
        "lines": [
          {
            "bbox": [
              85.09302520751953,
              334.5909729003906,
              414.1730651855469,
              344.1109924316406
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Después de explicar la disminución de la luna como su defecto y el crecer ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              85.09302520751953,
              346.3509826660156,
              414.1809997558594,
              356.1609802246094
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "de la luna como su tikún, el Rabí Natán agrega que las estrellas que creó ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              85.09302520751953,
              358.5909729003906,
              414.1949157714844,
              368.1609802246094
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "HaShem para apaciguar a la luna son los puntos buenos que asisten a la luna ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              85.09302520751953,
              371.7909851074219,
              201.2629852294922,
              381.3110046386719
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "en su retorno a la plenitud.",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.6929931640625,
          389.5899963378906,
          445.18206787109375,
          471.4399719238281
        ],
        "lines": [
          {
            "bbox": [
              85.09302520751953,
              389.5899963378906,
              445.1590881347656,
              399.44000244140625
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Vemos que esta idea de la plenitud de la luna se expresa en el concepto ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693023681640625,
              401.1291809082031,
              445.16302490234375,
              411.44000244140625
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "de los puntos buenos efectuando el tikún. Esto debe ser claro para nosotros pues ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693023681640625,
              413.29998779296875,
              445.1091003417969,
              423.45001220703125
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "sabemos que aunque la luna fue disminuida debido a su queja, HaShem le otorgó ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693023681640625,
              425.5899963378906,
              445.1470031738281,
              435.44000244140625
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "entonces las estrellas para conciliarla, como enseñan Jazal y como trae Rashi en ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.693023681640625,
              437.4590148925781,
              445.1609802246094,
              447.4399719238281
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "su comentario.[114]Las estrellas, como puntos de luz, aluden de hecho al aspecto de ",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              449.2999572753906,
              445.18206787109375,
              459.4499816894531
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "los puntos buenos que se encuentran dentro de cada judío, mediante los cuales ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              461.2999572753906,
              439.7300720214844,
              471.4399719238281
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "la gente pasa hacia una posición de mérito al ser juzgada de manera favorable.",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.6929931640625,
          474.3349609375,
          362.3951110839844,
          582.2850952148438
        ],
        "lines": [
          {
            "bbox": [
              85.0929946899414,
              474.3349609375,
              362.3929748535156,
              486.28497314453125
            ],
            "ids": [
              [
                7,
                7
              ]
            ],
            "text": "Ésta es la explicación de “y aquellos que matzdik al ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              488.13494873046875,
              362.30206298828125,
              498.27496337890625
            ],
            "ids": [
              [
                7,
                8
              ]
            ],
            "text": "pueblo [brillarán] como las estrellas”. Interpretado de manera ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              500.3149719238281,
              362.3951110839844,
              510.28497314453125
            ],
            "ids": [
              [
                7,
                9
              ]
            ],
            "text": "homilética, “aquellos que matzdik” hace referencia a los ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.69300842285156,
              512.1349487304688,
              362.3030090332031,
              522.2749633789062
            ],
            "ids": [
              [
                7,
                10
              ]
            ],
            "text": "Tzadikim de la generación.[115] Ellos encuentran el bien en todos ",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              524.4151000976562,
              362.39202880859375,
              534.2850952148438
            ],
            "ids": [
              [
                7,
                11
              ]
            ],
            "text": "y juzgan a todos de manera favorable, de modo que incluso ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              536.1350708007812,
              362.38507080078125,
              546.2750854492188
            ],
            "ids": [
              [
                7,
                12
              ]
            ],
            "text": "los pecadores entre el pueblo judío pasan genuinamente hacia ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              548.1350708007812,
              362.3890380859375,
              558.2750854492188
            ],
            "ids": [
              [
                7,
                13
              ]
            ],
            "text": "una posición de mérito. Este bien corresponde a las estrellas, ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              560.1350708007812,
              362.3910217285156,
              570.2850952148438
            ],
            "ids": [
              [
                7,
                14
              ]
            ],
            "text": "como en “aquellos que matzdik al pueblo [brillarán] como las ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              572.4251098632812,
              362.3030090332031,
              582.2850952148438
            ],
            "ids": [
              [
                7,
                15
              ]
            ],
            "text": "estrellas”, dado que las estrellas se asemejan a puntos de luz. ",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          367.93701171875,
          479.7349853515625,
          444.0570373535156,
          573.1910400390625
        ],
        "lines": [
          {
            "bbox": [
              367.93701171875,

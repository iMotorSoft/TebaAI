            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "4 La palabra rúaj ( )רוחtiene dos signifi cados separados pero ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,

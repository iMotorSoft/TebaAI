            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "mencionados en la lección del Rebe. Por el contrario, la necesidad de dormir ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              53.858306884765625,
              383.0279846191406,
              442.2403564453125,
              393.18798828125
            ],
            "ids": [
              [
                11,
                2
              ]
            ],

              10.0
            ]
          },
          {
            "bbox": [
              56.78700256347656,
              256.4936218261719,
              445.25799560546875,
              266.8349609375
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "identificadas con su propia alma, cada Tzadik construye ese mishkán y de allí los ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.787017822265625,
              268.85400390625,
              445.1690368652344,
              278.844970703125
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "pequeños escolares reciben el aliento incontaminado de sus bocas.[9] El Midrash ",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          },
          {
            "bbox": [
              56.787017822265625,
              280.9849548339844,
              445.1611022949219,
              290.8349609375
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "dice de esos escolares, “Que aquellos que son puros vengan y se ocupen de aquello ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.787017822265625,
              292.9849548339844,
              445.1760559082031,
              302.8349609375
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "que es puro”. Para esto, los maestros que introducen a los pequeños escolares a la ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              56.787017822265625,
              304.6749572753906,
              271.8768005371094,
              312.574951171875
            ],
            "ids": [
              [
                3,
                10
              ]
            ],
            "text": "Torá comienzan desde Vaikrá. Estudia allí.[10]",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          }
        ]
      },

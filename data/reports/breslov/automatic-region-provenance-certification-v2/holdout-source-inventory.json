            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "haciendo referencia a la búsqueda del Tzadik, cuya cercanía le permite a la ",
            "sizes": [
              10.0
            ]
          },
          {
            "bbox": [
              85.09269714355469,
              424.8779602050781,
              414.1805725097656,
              434.3979797363281
            ],
            "ids": [
              [
                7,
                2

              278.85797119140625
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "antigua gloria”.[51]Y debemos rogarle para que rápidamente nos envíe otra vez ",
            "sizes": [
              5.829999923706055,
              10.0
            ]
          },
          {
            "bbox": [
              56.6929931640625,
              280.59796142578125,

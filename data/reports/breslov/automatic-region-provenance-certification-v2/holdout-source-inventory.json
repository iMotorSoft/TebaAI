              367.8189697265625,
              445.26031494140625,
              377.6789855957031
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "todos los aspectos de los mishkanot que construyen los Tzadikim, de los cuales ",
            "sizes": [
              10.0
            ]
          },

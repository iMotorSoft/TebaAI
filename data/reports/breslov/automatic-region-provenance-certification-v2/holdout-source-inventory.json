              440.35687255859375
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "favorable, aunque se encuentren físicamente muy apartados. ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              252.37879943847656,
              442.52703857421875,
              441.03204345703125,
              449.35687255859375
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "Ello es posible precisamente pues cada judío está incluido ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              252.37879943847656,
              451.53070068359375,
              441.0150146484375,
              458.35687255859375
            ],
            "ids": [
              [
                12,
                2
              ]

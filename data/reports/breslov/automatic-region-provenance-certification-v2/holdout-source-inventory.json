              ]
            ],
            "text": "está apegado a HaShem - allí en donde se encuentre, estáperpetuamente con Él.",
            "sizes": [
              10.0
            ]
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.69281005859375,

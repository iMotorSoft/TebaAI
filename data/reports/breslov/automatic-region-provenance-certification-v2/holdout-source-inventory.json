              242.2830352783203,
              449.3636474609375
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "interrelacionados: aire/viento y espíritu. Aquí el Rebe Najmán ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,
              451.5374755859375,
              242.26808166503906,
              456.8621826171875
            ],
            "ids": [
              [
                10,
                2
              ]
            ],
            "text": "alterna entre los dos. Un instrumento musical crea sonidos ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,
              460.5374755859375,
              242.27554321289062,
              467.3489990234375
            ],
            "ids": [
              [
                10,
                3
              ]
            ],
            "text": "cuando parte de este vibra haciendo que el aire alrededor ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,
              469.5374755859375,
              242.25979614257812,
              476.3636474609375
            ],
            "ids": [
              [
                10,
                4
              ]
            ],
            "text": "vibre también. Oímos ese rúaj vibrante, u ondas de sonido, ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,
              478.5338134765625,
              242.27932739257812,
              485.3636474609375
            ],
            "ids": [
              [
                10,
                5
              ]
            ],
            "text": "como notas musicales. La habilidad consiste en ejecutar ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62200164794922,
              487.5374755859375,
              242.26052856445312,
              494.3636474609375
            ],
            "ids": [
              [
                10,
                6
              ]
            ],
            "text": "el instrumento seleccionando el “buen rúaj”, la música, y ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62275695800781,
              496.5374755859375,
              242.2763214111328,
              503.3636474609375
            ],
            "ids": [
              [
                10,
                7
              ]
            ],
            "text": "evitando la disonancia y el ruido, que el Rebe equipara con un ",
            "sizes": [
              7.5
            ]
          },
          {
            "bbox": [
              53.62275695800781,
              505.5374755859375,
              236.07530212402344,
              512.3636474609375
            ],
            "ids": [
              [
                10,
                8
              ]
            ],
            "text": "espíritu melancólico, un “rúaj de la depresión y de la culpa”.",
            "sizes": [
              7.5
            ]
          }
        ]
      },
      {
        "index": 9,
        "class": "text",

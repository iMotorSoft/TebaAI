              393.0464782714844,
              442.3323059082031,
              405.26617431640625
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "consecuencia del daño del daat por parte de Sitra Ájara. Esto proviene del hecho ",
            "sizes": [
              10.0

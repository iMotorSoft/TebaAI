  "PASS": true,
  "rules": [
    "The certifier output is authoritative; no consumer may upgrade a region.",
    "A region is textually publishable only when quality_status == ACCEPTED and provenance_status == CERTIFIED and its ownership is bound and non-overlapping.",
    "Every other region is quarantined: QUARANTINED, UNRESOLVED, SOURCE_PDF_ERROR, PLATFORM_EXTRACTION_ERROR, UNKNOWN, missing certificate or mismatched ownership.",
    "Page status is derived: no publishable region -> UNUSABLE; all publishable -> FULL; otherwise -> PARTIAL.",
    "Quarantined text never enters canonical Markdown, searchable metadata, chunks, embeddings or citations; it remains reachable only through the visual source reference.",
    "A fixture label such as GOOD_A is a declared input, never evidence of live quality."
  ],
  "decision_source": "modules.library.automatic_region_certification_v5",
  "FIXTURE_GOOD_ACCEPTANCE_NOT_REQUIRED": true

    {
      "table_name": "library_document_generations",
      "conname": "library_document_generations_logical_document_id_fkey",
      "definition": "FOREIGN KEY (logical_document_id) REFERENCES library_logical_documents(id) ON DELETE CASCADE"
    },
    {
      "table_name": "library_document_generations",
      "conname": "library_document_generations_run_id_fkey",

            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "que todo aquel cuyo corazón haya sido tocado por el temor a HaShem está ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {
            "bbox": [

              343.99298095703125
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "que uno depende de lo otro.",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ]
            ]
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          85.09298706054688,
          351.6719665527344,
          414.1769104003906,

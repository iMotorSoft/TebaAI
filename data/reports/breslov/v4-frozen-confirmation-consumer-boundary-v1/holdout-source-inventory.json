              470.4429626464844,
              411.3478698730469,
              479.9629821777344
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "enseña que el momento óptimo para dedicarse al perfeccionamiento de la ",
            "styles": [
              [
                "Optima",
                10.0
              ]
            ]
          },
          {
            "bbox": [
              82.25799560546875,
              482.36297607421875,
              411.3499450683594,
              491.9629821777344
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "emuná es después de la medianoche, mediante el daat que uno adquiere al ",
            "styles": [
              [
                "Optima",
                10.0
              ],
              [
                "Optima-Italic",
                10.0
              ]
            ]
          },

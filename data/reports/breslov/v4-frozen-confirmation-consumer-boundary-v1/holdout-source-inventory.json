              533.573486328125,
              441.2726135253906,
              540.385009765625
            ],
            "ids": [
              [
                6,
                9
              ]
            ],
            "text": "HaShaná (ver la nota §5 más arriba para la conexión entre esta ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61399841308594,
              542.56982421875,
              441.2471923828125,
              549.399658203125
            ],
            "ids": [
              [
                6,
                10
              ]
            ],
            "text": "lección y Rosh HaShaná). El Rebe Najmán enseña que erev ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61398315429688,
              551.573486328125,
              441.2449951171875,
              558.399658203125
            ],
            "ids": [
              [
                6,
                11
              ]
            ],
            "text": "Rosh HaShaná es un buen momento para presentar un pidion y ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61398315429688,
              560.56982421875,
              441.2472229003906,
              567.399658203125
            ],
            "ids": [
              [
                6,
                12
              ]
            ],
            "text": "redimirse a los ojos del Cielo, limpiando el alma (Sabiduría y ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },

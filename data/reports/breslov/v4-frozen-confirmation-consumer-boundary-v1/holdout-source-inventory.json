              441.39495849609375,
              442.3331298828125,
              451.53497314453125
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "decir sus puntos buenos, inclinándose hacia la bondad y juzgándose a sí misma ",
            "styles": [
              [
                "StoneSerif",
                10.0
              ],
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]
          },
          {
            "bbox": [
              53.85801696777344,
              453.39495849609375,
              442.31298828125,
              463.54498291015625
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "de manera favorable. Por este motivo fue Abraham quien trajo prosélitos al ",
            "styles": [
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]
          },
          {
            "bbox": [
              53.85801696777344,

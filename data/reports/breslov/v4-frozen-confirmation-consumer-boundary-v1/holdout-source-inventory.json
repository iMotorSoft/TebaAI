              482.82794189453125,
              445.40740966796875,
              492.97796630859375
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "fervor y concentración, queda un poco más claro por qué uno tiene prohibido ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {
            "bbox": [

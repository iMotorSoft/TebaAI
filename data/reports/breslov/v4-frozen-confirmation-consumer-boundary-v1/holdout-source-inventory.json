              441.2718200683594,
              522.38525390625
            ],
            "ids": [
              [
                6,
                7
              ]
            ],
            "text": "Otra posible razón por la cual el Rabí Natán introduce ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.6164093017578,

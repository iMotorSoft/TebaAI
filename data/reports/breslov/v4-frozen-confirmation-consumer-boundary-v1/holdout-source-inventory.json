              468.39990234375
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "55 Para el papel que juega la tzedaka en quebrar el deseo ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]

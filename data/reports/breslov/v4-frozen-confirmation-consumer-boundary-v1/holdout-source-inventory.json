              321.84295654296875,
              445.1610107421875,
              331.99298095703125
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "de mí” -que significa saber que “la tierra entera está llena de Su gloria”- dado ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {
            "bbox": [

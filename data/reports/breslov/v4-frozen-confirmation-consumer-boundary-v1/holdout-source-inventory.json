              442.15386962890625,
              94.067138671875
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "a desarrollar sus propios jidushei Torá. El Rabí Natán comenzó a hacerlo, aunque sólo ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]

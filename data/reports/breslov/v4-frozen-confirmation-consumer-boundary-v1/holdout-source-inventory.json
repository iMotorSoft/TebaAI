              497.57373046875,
              441.25262451171875,
              504.39990234375
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "quiebra su deseo de dinero y le da un pidion a un Tzadik, ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [

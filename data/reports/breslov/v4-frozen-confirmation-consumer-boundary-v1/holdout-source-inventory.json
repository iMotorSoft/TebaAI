              445.3132019042969,
              555.802978515625
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "bebida, las klipot se fortalecen. Esto es especialmente así con respecto a las fuerzas ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ],
              [
                "StoneSerif-SemiboldItali",

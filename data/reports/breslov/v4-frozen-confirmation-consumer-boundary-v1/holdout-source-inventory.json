              446.4429626464844,
              411.3498840332031,
              456.0129699707031
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "y que, por lo tanto, nos levantamos antes del alba para elevar y magnificar ",
            "styles": [
              [
                "Optima",
                10.0
              ]
            ]
          },
          {
            "bbox": [
              82.25801086425781,
              458.4429626464844,
              411.349853515625,
              468.0129699707031
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "a la emuná a través de nuestro estudio de Torá y plegaria. A continuación ",
            "styles": [
              [
                "Optima",
                10.0
              ],
              [
                "Optima-Italic",
                10.0
              ]
            ]
          },
          {
            "bbox": [

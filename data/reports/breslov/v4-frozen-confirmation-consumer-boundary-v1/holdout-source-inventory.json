              132.37823486328125,
              400.699951171875
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "caída espiritual.",
            "styles": [
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]

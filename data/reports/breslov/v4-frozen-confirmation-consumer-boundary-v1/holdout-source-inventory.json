              295.9830627441406
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "pues se han ido todas sus dudas y cuestiones sobre la emuná, como se explicó ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ],
              [
                "StoneSerifMediumItalic",

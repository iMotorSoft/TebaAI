              504.0129699707031
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "estudiar las reglamentaciones de la ley judía.",
            "styles": [
              [
                "Optima",
                10.0
              ]
            ]
          }
        ]
      },
      {

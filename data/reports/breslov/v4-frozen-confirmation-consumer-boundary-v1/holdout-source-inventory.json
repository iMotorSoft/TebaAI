              632.5804443359375,
              242.523681640625,
              639.4066162109375
            ],
            "ids": [
              [
                5,
                20
              ]
            ],
            "text": "como catalizador a través del cual se mitigan para la persona ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              53.86116027832031,

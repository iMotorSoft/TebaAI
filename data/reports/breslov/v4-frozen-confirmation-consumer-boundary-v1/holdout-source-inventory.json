              441.25103759765625,
              531.38525390625
            ],
            "ids": [
              [
                6,
                8
              ]
            ],
            "text": "aquí el tema del pidion se basa en su conexión con Rosh ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [

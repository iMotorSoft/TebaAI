              444.99163818359375,
              472.1705017089844
            ],
            "ids": [
              [
                1,
                24
              ]
            ],
            "text": "general de las lecciones de su maestro y cómo sus construcciones conceptuales dan luz ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              56.690399169921875,
              475.3587646484375,
              445.0092468261719,
              483.1468505859375
            ],
            "ids": [
              [
                1,
                25
              ]
            ],
            "text": "a tantas otras facetas de la Torá. A través de esas enseñanzas comenzamos a detectar la ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              56.690399169921875,
              488.55877685546875,
              445.0124816894531,
              496.34686279296875
            ],
            "ids": [
              [
                1,
                26
              ]
            ],
            "text": "sabiduría Divina inherente a cada elemento de la existencia. Descubrimos la conexión ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              56.690399169921875,
              501.7587890625,
              444.9926452636719,
              511.7705078125
            ],
            "ids": [
              [
                1,
                27
              ]
            ],
            "text": "de cada uno de los componentes de la creación con su Creador y en particular el lazo ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              56.690399169921875,
              514.953369140625,
              314.55242919921875,
              524.970458984375
            ],
            "ids": [
              [
                1,
                28
              ]
            ],
            "text": "especial que nosotros, como judíos, tenemos con HaShem.",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          }
        ]
      },

            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "mitiga los dinim.",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]

              533.8429565429688,
              445.406982421875,
              543.802978515625
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "esta elevación mediante el ayuno. Pues al dejarse llevar por el deseo de comida y ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {

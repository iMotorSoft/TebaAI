            ],
            "ids": [
              [
                4,
                6
              ],
              [
                13,
                5
              ]
            ],
            "text": "Beit HaMikdash, la “casa de plegaria para todos los pueblos”, Quien reúne a los ",
            "styles": [
              [
                "Optima",
                8.0
              ],
              [
                "StoneSerif",
                10.0

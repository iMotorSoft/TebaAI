              427.53497314453125
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "despertarse del sueño es el concepto de “la mañana de Abraham”, quien es ",
            "styles": [
              [
                "StoneSerif",
                10.0
              ],
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]
          },
          {

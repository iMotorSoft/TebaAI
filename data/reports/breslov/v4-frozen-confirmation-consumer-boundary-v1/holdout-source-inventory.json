              445.3180236816406,
              531.802978515625
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "elevando las chispas del habla y restaurándolas en la santidad. Uno merece lograr ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {
            "bbox": [

              309.84295654296875,
              445.1661682128906,
              319.98297119140625
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "esta ley de despertar el alba, está la glosa “He puesto a HaShem siempre delante ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                10.0
              ]
            ]
          },
          {
            "bbox": [

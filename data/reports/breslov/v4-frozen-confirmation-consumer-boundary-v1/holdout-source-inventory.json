              180.13583374023438,
              365.0389709472656
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "otros textos kabalísticos.[68]",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                5.829999923706055
              ],
              [
                "StoneSerif",

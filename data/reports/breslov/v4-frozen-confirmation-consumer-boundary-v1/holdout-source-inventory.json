              445.0103454589844,
              458.97052001953125
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "En el Likutey Halajot el Rabí Natán también demuestra la naturaleza abarcadora y ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]

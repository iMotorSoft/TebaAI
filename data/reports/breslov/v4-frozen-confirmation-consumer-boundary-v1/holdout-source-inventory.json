            ]
          },
          {
            "bbox": [
              252.61398315429688,
              596.573486328125,
              441.2449951171875,
              603.399658203125
            ],
            "ids": [
              [
                6,
                16
              ]
            ],
            "text": "sin embargo un letargo de los mojín y la suspensión del daat. ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61398315429688,
              605.573486328125,
              441.26568603515625,
              612.385009765625
            ],
            "ids": [
              [
                6,
                17
              ]
            ],
            "text": "El tiempo que uno pasa durmiendo es un tiempo transcurrido ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61398315429688,
              614.56982421875,
              441.2591857910156,
              621.399658203125
            ],
            "ids": [
              [
                6,
                18
              ]
            ],
            "text": "bajo el poder de los dinim. El quebrar la garra del sueño y ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61473083496094,
              623.573486328125,
              441.2755432128906,
              630.399658203125
            ],
            "ids": [
              [
                6,
                19
              ]
            ],
            "text": "levantarse a medianoche construye la conciencia de HaShem y ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]
          },
          {
            "bbox": [
              252.61473083496094,
              632.573486328125,
              441.2621765136719,
              639.399658203125
            ],
            "ids": [
              [
                6,
                20
              ]
            ],
            "text": "libera a la persona de todos los infortunios y sufrimientos que ",
            "styles": [
              [

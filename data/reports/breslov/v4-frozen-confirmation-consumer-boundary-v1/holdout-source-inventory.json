              495.1179504394531,
              195.45445251464844,
              502.59796142578125
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "comer o beber antes de orar.",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ]
            ]
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.93499755859375,
          509.6429748535156,
          445.406982421875,

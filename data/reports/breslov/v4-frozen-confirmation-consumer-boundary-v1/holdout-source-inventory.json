              445.3870544433594,
              413.8569641113281
            ],
            "ids": [
              [
                4,
                12
              ]
            ],
            "text": "enteramente con la llegada del Mashíaj, que suceda pronto y en nuestros días. ",
            "styles": [
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]
          },

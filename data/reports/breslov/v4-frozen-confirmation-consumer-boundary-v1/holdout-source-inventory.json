            "text": "de orar. ¡Ay de ellos! ¡Ay de sus almas! Pues ésta es una prohibición muy grave, ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ]
            ]
          },
          {
            "bbox": [
              56.93504333496094,

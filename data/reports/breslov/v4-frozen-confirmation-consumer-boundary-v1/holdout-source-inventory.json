              475.53497314453125
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "judaísmo.[32]Él se inclinaba hacia la bondad y encontraba el punto bueno en ",
            "styles": [
              [
                "StoneSerif",
                5.829999923706055
              ],
              [
                "StoneSerifStd-Semibold",
                10.0
              ]

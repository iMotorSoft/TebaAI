              239.2672119140625
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "halajá del Shuljan Aruj, una festividad del calendario judío o las noticias del mundo - el ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858917236328,
              242.45013427734375,
              442.1697082519531,
              252.46722412109375
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "Rabí Natán era capaz de derivar de allí nuevos fundamentos y consejos prácticos en el ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858917236328,
              255.655517578125,
              139.7025909423828,
              263.459716796875
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "servicio a HaShem.",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.85858154296875,
          271.6902160644531,
          442.1763000488281,
          334.5019836425781
        ],
        "lines": [
          {
            "bbox": [
              82.25839233398438,
              271.6902160644531,
              442.126708984375,
              281.7019348144531
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": "El Likutey Halajot atraviesa las cuatro secciones del Shuljan Aruj y sirve como ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858154296875,
              284.8902282714844,
              442.1763000488281,
              294.9019470214844
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "la fuente primaria para comprender las lecciones del Rebe y cómo aplicarlas de manera ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858154296875,
              298.0848693847656,
              442.1564025878906,
              308.1019592285156
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "práctica. Los jasidim de Breslov siempre han considerado los discursos del Rabí Natán ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858154296875,
              311.2848815917969,
              442.17181396484375,
              321.3019714355469
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "como la lente más clara a través de la cual percibir las enseñanzas del Rebe Najmán en ",
            "styles": [
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },
          {
            "bbox": [
              53.85858154296875,
              324.4902648925781,
              145.2102813720703,
              334.5019836425781
            ],
            "ids": [
              [
                1,
                19
              ]
            ],
            "text": "su Likutey Moharán.",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]

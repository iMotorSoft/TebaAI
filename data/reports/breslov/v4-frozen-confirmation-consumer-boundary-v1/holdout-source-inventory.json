              519.81298828125
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "Se explica en la lección del Rebe[70]que el tikún de la emuná se logra ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                5.829999923706055
              ],

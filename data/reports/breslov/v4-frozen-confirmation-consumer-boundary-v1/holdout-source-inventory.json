              442.1399841308594,
              390.1376037597656
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "alusivo), drush (signifi cado homilético) y sod (signifi cado esotérico o kabalístico). Fue ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                11.0
              ],
              [
                "TimesNewRomanPSMT",
                11.0
              ]
            ]
          },

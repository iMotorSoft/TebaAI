              377.8569641113281
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "Él encuentra los puntos buenos incluso en los desterrados y en aquellos que ",
            "styles": [
              [
                "StoneSerifStd-Semibold",
                10.0
              ]
            ]
          },
          {
            "bbox": [

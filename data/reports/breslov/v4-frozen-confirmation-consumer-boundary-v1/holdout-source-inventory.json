            "ids": [
              [
                5,
                15
              ]
            ],
            "text": "53 Un pidion, una redención, hace referencia a dinero o a ",
            "styles": [
              [
                "TimesNewRomanPS-ItalicMT",
                7.5
              ],
              [
                "TimesNewRomanPSMT",
                7.5
              ]
            ]

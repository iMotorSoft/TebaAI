              445.406982421875,
              355.2989807128906
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "como se explica en las enseñanzas de Jazal[67] y en especial en el santo Zohar y ",
            "styles": [
              [
                "ITCStoneSerif-SemiBold",
                10.0
              ],
              [
                "StoneSerif",
                5.829999923706055
              ],

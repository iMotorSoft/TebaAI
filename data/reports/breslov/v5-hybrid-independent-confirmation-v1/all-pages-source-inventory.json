            "bbox": [
              85.09269714355469,
              272.4449768066406,
              414.19061279296875,
              281.9649963378906
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "requiere encontrar los propios puntos buenos. A continuación demostrará la "
          },
          {
            "bbox": [
              85.09269714355469,
              285.6449890136719,
              411.4125671386719,
              295.1650085449219
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "conexión entre los puntos buenos de la persona y el despertar antes del alba."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [

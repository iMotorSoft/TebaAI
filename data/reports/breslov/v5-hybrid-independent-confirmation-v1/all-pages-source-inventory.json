          },
          {
            "bbox": [
              53.85801696777344,
              408.2769470214844,
              368.8659362792969,
              417.68695068359375
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "entonces de entre ellas, brillando con una luz Divina. Esto está "
          },
          {
            "bbox": [
              53.858001708984375,
              420.1569519042969,
              442.33306884765625,
              430.4169616699219
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "refl ejado en la ley del encendido de las velas en honor del Shabat y del Iom Tov. "
          },
          {
            "bbox": [
              53.858001708984375,
              432.2663269042969,
              442.24102783203125,
              442.4951477050781
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "Las encendemos en su lugar, más arriba de diez palmos, donde Maljut se encuentra "
          },
          {
            "bbox": [
              53.858001708984375,
              444.56695556640625,
              200.0580291748047,
              452.1569519042969
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": "en el momento de su ascenso."
          }

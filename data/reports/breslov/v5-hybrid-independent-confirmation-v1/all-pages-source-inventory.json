              242.5133056640625,
              405.0866394042969
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "precisión el carácter de una persona y sus rasgos de personalidad "
          },
          {
            "bbox": [
              53.858299255371094,
              407.2604675292969,
              242.50588989257812,
              414.0866394042969
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "a partir de sus cabellos, de los rasgos faciales y de las líneas "
          },
          {
            "bbox": [
              53.858299255371094,
              414.8871765136719,
              242.4923095703125,
              423.0866394042969
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "de sus dedos y manos. Éste es el arte de jojmat ha-partzuf "
          },
          {
            "bbox": [
              53.85829162597656,
              423.7854919433594,
              242.4960479736328,
              432.0879821777344
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "(fi sionomía). El Tikuney Zohar (#70, p. 122a-124a) habla de "
          },
          {
            "bbox": [
              53.859046936035156,
              432.7854919433594,
              242.51040649414062,
              441.0879821777344
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "esto también, identifi cando el cabello negro y el cabello que "
          },
          {
            "bbox": [
              53.859046936035156,
              443.2604675292969,
              242.52159118652344,
              448.5705261230469
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "rodea a la cabeza como indicativos de las cualidades asociadas "
          },
          {
            "bbox": [
              53.859046936035156,
              452.2604675292969,
              88.43629455566406,
              459.0866394042969
            ],
            "ids": [
              [
                8,
                6
              ]
            ],
            "text": "con Maljut."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.85902404785156,
          461.2604675292969,
          242.5110321044922,
          520.570556640625
        ],
        "lines": [
          {
            "bbox": [
              53.85904312133789,
              461.2604675292969,
              242.50051879882812,
              468.0866394042969
            ],
            "ids": [
              [
                8,
                7
              ]
            ],
            "text": "9 El Tikuney Zohar (#70, p. 124a) enseña que la persona digna "
          },
          {
            "bbox": [
              53.85904312133789,
              470.2604675292969,
              242.4900360107422,
              477.0866394042969
            ],
            "ids": [
              [
                8,
                8
              ]
            ],
            "text": "que posee cabellos negros tiene rasgos similares a la Shejiná, "
          },
          {
            "bbox": [
              53.85902404785156,
              479.2604675292969,
              242.50582885742188,
              486.0866394042969
            ],
            "ids": [
              [
                8,
                9
              ]
            ],
            "text": "es decir a Maljut, de quien está escrito, “Soy negra pero "
          },
          {
            "bbox": [
              53.85976791381836,
              488.2604675292969,
              242.5012664794922,
              495.0866394042969
            ],
            "ids": [
              [
                8,
                10
              ]
            ],
            "text": "agradable”. En el contexto aquí, la Shejiná declara, “soy negra” "
          },
          {
            "bbox": [
              53.85975646972656,
              495.7854919433594,
              242.50425720214844,
              504.0879821777344
            ],
            "ids": [
              [
                8,
                11
              ]
            ],
            "text": "- en este mundo me manifi esto a través de constricciones, "
          },
          {
            "bbox": [
              53.860504150390625,
              506.2604675292969,
              242.5110321044922,
              513.086669921875
            ],
            "ids": [
              [
                8,
                12
              ]
            ],
            "text": "como sabiduría inferior - “pero agradable” - pues mi esencia "
          },
          {
            "bbox": [
              53.860504150390625,
              515.260498046875,
              149.67303466796875,
              520.570556640625
            ],
            "ids": [
              [
                8,
                13
              ]
            ],
            "text": "de hecho es la sabiduría Divina."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          53.860504150390625,
          524.260498046875,
          242.5117950439453,
          540.086669921875
        ],
        "lines": [
          {
            "bbox": [
              53.860504150390625,
              524.260498046875,
              242.5117950439453,
              531.086669921875
            ],
            "ids": [
              [
                8,
                14
              ]
            ],
            "text": "10 Berajot 26b enseña que cada uno de los patriarcas instituyó "
          },
          {
            "bbox": [
              53.86125183105469,
              533.260498046875,
              149.25376892089844,
              540.086669921875
            ],
            "ids": [
              [
                8,
                15
              ]
            ],
            "text": "una de las tres plegarias diarias."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.861236572265625,
          542.260498046875,
          242.508056640625,
          565.570556640625
        ],
        "lines": [
          {
            "bbox": [
              53.86125183105469,
              542.260498046875,
              242.508056640625,
              549.086669921875
            ],
            "ids": [
              [
                8,
                16
              ]
            ],
            "text": "11 La palabra ShaJaRit ( )שחריתestá etimológicamente "
          },
          {
            "bbox": [
              53.86125183105469,
              551.260498046875,
              242.5005340576172,
              558.086669921875
            ],
            "ids": [
              [
                8,
                17
              ]
            ],
            "text": "relacionada con ShaJaRut ( ,שחרותnegrura) y así alude a la "
          },
          {
            "bbox": [
              53.861236572265625,
              560.260498046875,
              92.396240234375,
              565.570556640625
            ],
            "ids": [
              [
                8,
                18
              ]
            ],
            "text": "constricción."
          }
        ]
      },

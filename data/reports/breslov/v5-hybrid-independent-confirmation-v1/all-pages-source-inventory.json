          184.35699462890625
        ],
        "lines": [
          {
            "bbox": [
              203.6179962158203,
              174.21498107910156,
              295.2810363769531,
              184.35699462890625
            ],
            "ids": [
              [
                0,
                0
              ]
            ],
            "text": "INTRODUCCIÓN"
          }
        ]
      },
      {
        "index": 1,
        "class": "text",
        "bbox": [
          82.40450286865234,
          202.26498413085938,
          416.9404296875,
          318.3370666503906
        ],
        "lines": [
          {
            "bbox": [
              82.40450286865234,
              202.26498413085938,
              416.9106750488281,
              225.9919891357422
            ],
            "ids": [
              [
                0,
                1
              ]
            ],
            "text": "El Rabí Natán basa este primer discurso en la enseñanza fundacional del Rebe Najmán sobre el juzgarse a uno mismo y a los demás de "
          },
          {
            "bbox": [
              85.04299926757812,
              228.66500854492188,
              416.9141540527344,
              239.1370086669922
            ],
            "ids": [
              [
                0,
                4
              ]
            ],
            "text": "manera favorable. Conocida popularmente como Azamra (Cantaré), "
          },
          {
            "bbox": [
              85.04299926757812,
              241.86502075195312,
              416.90966796875,
              252.33702087402344
            ],
            "ids": [
              [
                0,
                5
              ]
            ],
            "text": "la lección del Rebe enseña que el hecho de buscar el bien en los "
          },
          {
            "bbox": [
              85.04299926757812,
              254.801025390625,
              416.9404296875,
              265.5370178222656
            ],
            "ids": [
              [
                0,
                6
              ]
            ],
            "text": "demás -encontrando la nekudá tová, el punto bueno, que todos tienen "
          },
          {
            "bbox": [
              85.04409790039062,
              268.2650451660156,
              416.9096374511719,
              278.7370300292969
            ],
            "ids": [
              [
                0,
                7
              ]
            ],
            "text": "en su interior- es la clave para acercarse a HaShem. El Rabí Natán "
          },
          {
            "bbox": [
              85.04409790039062,
              281.4650573730469,
              416.90631103515625,
              291.9370422363281
            ],
            "ids": [
              [
                0,
                8
              ]
            ],
            "text": "demuestra que el despertar esos puntos buenos es el medio principal "
          },
          {
            "bbox": [
              85.04409790039062,
              294.6650695800781,
              416.90753173828125,
              305.19207763671875
            ],
            "ids": [
              [
                0,
                9
              ]
            ],
            "text": "para despertar del sueño espiritual en el cual cae la gente debido a "
          },
          {
            "bbox": [
              85.04409790039062,
              307.8650817871094,
              393.5126037597656,
              318.3370666503906
            ],
            "ids": [
              [
                0,
                10
              ]
            ],
            "text": "sus pecados - es decir, la clave para “levantarse por la mañana”."
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          85.0440902709961,
          321.0650939941406,
          416.925048828125,
          463.53717041015625
        ],
        "lines": [
          {
            "bbox": [
              113.44389343261719,
              321.0650939941406,
              416.911865234375,
              329.43609619140625
            ],
            "ids": [
              [
                0,
                11
              ]
            ],
            "text": "En el curso de este extenso discurso el Rabí Natán conectará "
          },
          {
            "bbox": [
              85.04409790039062,
              334.2651062011719,
              416.907470703125,
              344.7370910644531
            ],
            "ids": [
              [
                0,
                12
              ]
            ],
            "text": "el descubrir los propios puntos buenos -y el descubrir los ocultos "
          },
          {
            "bbox": [
              85.04409790039062,
              347.4651184082031,
              416.90625,
              357.9371032714844
            ],
            "ids": [
              [
                0,
                13
              ]
            ],
            "text": "puntos buenos en los demás, incluso en los pecadores judíos- con un "
          },
          {
            "bbox": [
              85.04409790039062,
              358.8501281738281,
              416.91412353515625,
              371.1371154785156
            ],
            "ids": [
              [
                0,
                14
              ]
            ],
            "text": "conjunto de temas adicionales. Éstos incluyen: construir un mishkán, "
          },
          {
            "bbox": [
              85.04409790039062,
              373.8651428222656,
              416.90740966796875,
              384.39215087890625
            ],
            "ids": [
              [
                0,
                15
              ]
            ],
            "text": "un espacio sagrado para la manifestación de la Presencia de HaShem "
          },
          {
            "bbox": [
              85.04409790039062,
              387.0651550292969,
              416.92169189453125,
              397.5371398925781
            ],
            "ids": [
              [
                0,
                16
              ]
            ],
            "text": "en este mundo; transformar las chispas de santidad en melodía y "
          },
          {
            "bbox": [
              85.04409790039062,
              400.2651672363281,
              416.9107360839844,
              410.7371520996094
            ],
            "ids": [
              [
                0,
                17
              ]
            ],
            "text": "canción; refinar y elevar el habla a través de las diferentes etapas de "
          },
          {
            "bbox": [
              85.04409790039062,
              413.2891845703125,
              416.925048828125,
              424.5091857910156
            ],
            "ids": [
              [
                0,
                18
              ]
            ],
            "text": "la plegaria de Shajarit; el vestirse y el recitado de las bendiciones de "
          },
          {
            "bbox": [
              85.0440902709961,
              426.6651916503906,
              416.9140625,
              437.1371765136719
            ],
            "ids": [
              [
                0,
                19
              ]
            ],
            "text": "la mañana; las cuatro lecturas especiales de la Torá durante el mes "
          },
          {
            "bbox": [
              85.0440902709961,
              439.689208984375,
              416.9152526855469,
              450.9092102050781
            ],
            "ids": [
              [
                0,
                20
              ]
            ],
            "text": "de Adar conocidas como las Arba Parashiot; y levantarse para jatzot, "
          },
          {
            "bbox": [
              85.04522705078125,
              453.065185546875,
              337.1761779785156,
              463.53717041015625
            ],
            "ids": [
              [
                0,
                21
              ]
            ],
            "text": "para la medianoche y su conexión con la redención."
          }
        ]
      }
    ]
  },

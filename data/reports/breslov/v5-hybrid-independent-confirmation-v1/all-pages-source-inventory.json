              53.85830307006836,
              586.3224487304688,
              242.5020751953125,
              593.1486206054688
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "extremo din las guevurot (severidades; ver la nota siguiente), "
          },
          {
            "bbox": [
              53.857566833496094,
              595.3224487304688,
              242.5186004638672,
              602.1486206054688
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "en la forma de un fuego proveniente del norte, golpean las alas "
          },
          {
            "bbox": [
              53.857566833496094,
              604.3224487304688,
              242.48928833007812,
              611.1486206054688
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "del “gallo” arriba, que es igualmente un símbolo de guevurá (y "
          },

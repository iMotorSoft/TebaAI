              [
                12,
                3
              ]
            ],
            "text": "lugar”."
          },
          {
            "bbox": [
              363.3070068359375,
              387.82598876953125,
              402.9220275878906,
              394.44097900390625
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "(ibid. 19:16)"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          53.85820007324219,
          388.386962890625,
          357.76715087890625,
          445.7969665527344
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              388.386962890625,
              357.7582702636719,
              398.5369873046875
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Pues HaShem sólo desea que hablemos favorablemente "
          },
          {
            "bbox": [
              53.85820007324219,
              400.386962890625,
              357.7562255859375,
              410.5269775390625
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "del pueblo judío y le mostremos compasión -incluso hasta "
          },
          {
            "bbox": [
              53.85820007324219,
              410.58697509765625,
              357.76025390625,
              422.5369873046875
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "a los peores- para acercar a todos a Él. Al igual que Moshé "
          },
          {
            "bbox": [
              53.85820007324219,
              424.2669677734375,
              357.76715087890625,
              434.5369873046875
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "Rabeinu, quien sacrifi có su vida por el pueblo judío y dijo, "
          },
          {
            "bbox": [
              53.85919189453125,
              436.386962890625,
              195.1388397216797,
              445.7969665527344
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "“Pero si no, bórrame a mí”.[97]"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          363.3070068359375,
          405.82598876953125,
          442.5070495605469,
          457.44097900390625
        ],
        "lines": [
          {
            "bbox": [
              363.3070068359375,
              405.82598876953125,
              442.5070495605469,
              412.9659729003906
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "“Ahora bien, si soportas "
          },
          {
            "bbox": [
              363.3070068359375,
              414.82598876953125,
              424.1695556640625,
              421.9659729003906
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "su pecado. Pero si "
          },
          {
            "bbox": [
              363.3070068359375,
              423.82598876953125,
              431.24200439453125,
              430.69598388671875
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "no, bórrame a mí de "
          },
          {
            "bbox": [
              363.3070068359375,
              432.82598876953125,
              428.3470764160156,
              439.9659729003906
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "Tu libro que Tú has "
          },
          {
            "bbox": [
              363.3070068359375,
              442.0959777832031,
              389.97698974609375,
              447.5259704589844
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "escrito”."
          },
          {
            "bbox": [
              363.3070068359375,
              450.7059631347656,
              412.6037902832031,
              457.44097900390625
            ],
            "ids": [
              [
                13,
                5
              ]
            ],
            "text": "(Shemot 32:32)"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          53.85820388793945,
          451.511962890625,
          442.33123779296875,
          508.6319580078125
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              450.7059631347656,
              412.6037902832031,
              461.3619689941406
            ],
            "ids": [
              [
                3,
                0
              ],
              [
                13,
                5
              ]
            ],
            "text": "Este papel de los Tzadikim de acercar a HaShem a aquellos (Shemot 32:32)"
          },
          {
            "bbox": [
              53.85820388793945,
              461.6019592285156,
              442.33123779296875,
              473.3619689941406
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "que están lejos de Él se relaciona con el principio de “En temas de santidad "
          },
          {
            "bbox": [
              53.85821533203125,
              475.2219543457031,
              442.3312072753906,
              485.3619689941406
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "elevamos a un nivel superior”. Cuanto más logran los Tzadikim y cuanto más "
          },
          {
            "bbox": [
              53.85821533203125,
              487.2219543457031,
              442.32037353515625,
              497.3719787597656
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "quedan absorbidos en la santidad, alcanzando una mayor percepción de "
          },
          {
            "bbox": [
              53.85821533203125,
              499.2219543457031,
              327.20526123046875,
              508.6319580078125
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "Divinidad, más necesitan elevar las almas, acercándolas."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.85820007324219,
          513.9359741210938,
          442.33123779296875,
          584.1959838867188
        ],
        "lines": [
          {
            "bbox": [
              82.25820922851562,
              513.9359741210938,
              442.240234375,
              524.2059936523438
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "Por contraste, “y no disminuimos el grado de santidad” signifi ca que los "
          },
          {
            "bbox": [
              53.85821533203125,
              526.3460083007812,
              442.3193359375,
              536.2059936523438
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "Tzadikim deben ser muy cuidadosos en no hacer que desciendan las almas "
          },
          {
            "bbox": [
              53.858211517333984,
              538.2359619140625,
              442.32135009765625,
              548.1959838867188
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "alejándolas en virtud de su propia y gran santidad. Es decir, no deben permitir "
          },
          {
            "bbox": [
              53.85820770263672,
              550.0559692382812,
              442.2412414550781,
              560.2059936523438
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "que su gran santidad y percepción de Divinidad los vuelva estrictos y rigurosos "
          },
          {
            "bbox": [
              53.85821533203125,
              562.0559692382812,
              442.33123779296875,
              572.1959838867188
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "con el pueblo judío. Esto puede llevar a los Tzadikim a ser incapaces de tolerar a la "
          },
          {
            "bbox": [
              53.85820007324219,
              574.3460083007812,
              442.3301696777344,
              584.1959838867188
            ],
            "ids": [
              [
                3,
                10
              ]
            ],
            "text": "peor gente, al punto de enojarse tanto con ella como para hacerla descender, jas "
          }
        ]
      },

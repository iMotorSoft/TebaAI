              568.5374755859375,
              245.34120178222656,
              575.3489990234375
            ],
            "ids": [
              [
                11,
                15
              ]
            ],
            "text": "9 Jazal enseñan que el mundo existe sólo en mérito al estudio "
          },
          {
            "bbox": [
              56.69215393066406,
              577.5374755859375,
              245.3441925048828,
              584.3636474609375
            ],
            "ids": [
              [
                11,
                16
              ]
            ],
            "text": "de la Torá de los pequeños escolares, cuyo aliento está "
          },
          {
            "bbox": [
              56.69215393066406,
              586.5374755859375,
              245.3577117919922,
              593.3489990234375
            ],
            "ids": [
              [
                11,
                17
              ]
            ],
            "text": "incontaminado por el pecado. La Guemará explica que una vez "
          },
          {
            "bbox": [
              56.69215393066406,
              595.5374755859375,
              245.3524627685547,
              602.3636474609375
            ],
            "ids": [
              [
                11,
                18
              ]
            ],
            "text": "que la persona ha transgredido, el aliento de su estudio de Torá "
          },
          {
            "bbox": [
              56.69215393066406,
              604.5374755859375,
              245.3464813232422,
              611.3636474609375
            ],
            "ids": [
              [
                11,
                19
              ]
            ],
            "text": "ya no puede compararse con el aliento puro e incontaminado "
          },
          {
            "bbox": [
              56.69215393066406,
              613.5374755859375,
              245.32540893554688,
              620.3636474609375
            ],
            "ids": [
              [
                11,
                20
              ]
            ],
            "text": "de los pequeños escolares (Shabat 119b y Maharsha, v.i. eino "
          },
          {
            "bbox": [
              56.692901611328125,
              622.5374755859375,
              245.35537719726562,
              629.3489990234375
            ],
            "ids": [
              [
                11,
                21
              ]
            ],
            "text": "dome). El mérito del estudio de Torá de esa persona carece del "
          }
        ]
      },

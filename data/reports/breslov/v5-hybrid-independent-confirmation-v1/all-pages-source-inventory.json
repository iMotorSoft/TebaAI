              400.0628967285156,
              245.7869873046875
            ],
            "ids": [
              [
                14,
                1
              ]
            ],
            "text": "yugo de la soberanía del Cielo de una manera completa debe "
          },
          {
            "bbox": [
              99.2428970336914,
              247.46090698242188,
              400.07489013671875,
              257.9643249511719
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "evacuar el vientre y lavarse las manos, colocarse los tefilín y "
          },
          {
            "bbox": [
              99.24288940429688,
              258.0269775390625,
              400.07794189453125,
              269.7869873046875
            ],
            "ids": [
              [
                14,
                3
              ]
            ],
            "text": "luego recitar el Kriat Shemá y orar. Ésta es una aceptación plena "
          },
          {
            "bbox": [
              99.24288940429688,
              271.9369812011719,
              330.2389831542969,
              281.7869873046875
            ],
            "ids": [
              [
                14,
                4
              ]
            ],
            "text": "[del yugo] de la soberbia del Cielo (Berajot 14b-15a)"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.69300842285156,
          295.4761657714844,
          445.1691589355469,
          351.5269775390625
        ],
        "lines": [
          {
            "bbox": [
              85.09300231933594,
              295.4761657714844,
              445.15899658203125,
              305.7969970703125
            ],
            "ids": [
              [
                15,
                0
              ]
            ],
            "text": "Este tikún del daat de cada mañana se relaciona con lo que enseñaron "
          },

              [
                9,
                0
              ]
            ],
            "text": "mundo cuando las acciones indignas del hombre generan la ira "
          },
          {
            "bbox": [
              255.4496612548828,
              619.2914428710938,
              444.0968017578125,
              626.1029663085938
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "de HaShem, si así pudiera decirse, haciendo que se oculten la "
          },
          {
            "bbox": [
              255.4496612548828,
              626.8164672851562,
              444.0895690917969,
              635.1189575195312
            ],
            "ids": [

              445.166015625,
              245.49114990234375
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Esto ocurre cuando la Shejiná Se enorgullece delante del HaKadosh Baruj Hu, si así "
          },
          {
            "bbox": [
              56.693023681640625,
              247.27296447753906,
              340.865234375,
              257.4229736328125
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "pudiera expresarse, diciendo, “Mira qué niño Te he traído”.[75]"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.692962646484375,
          262.3979797363281,

              ]
            ],
            "text": "234  LIKUTEY HALAJOT"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          53.858299255371094,
          73.20018005371094,
          442.2444152832031,
          95.53580474853516
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              73.20018005371094,
              442.2444152832031,
              83.52054595947266
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "de Nukva, lo femenino, (la hermana) de Zeir Anpin, que incluso luego de volverse "
          },
          {
            "bbox": [
              53.85833740234375,
              85.17729949951172,
              253.38133239746094,
              95.53580474853516
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "un partzuf es también denominada Maljut."
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.8582763671875,
          102.84630584716797,
          442.2474365234375,
          266.7774658203125
        ],
        "lines": [
          {
            "bbox": [
              82.25833129882812,
              102.84630584716797,
              442.244384765625,
              113.2048110961914
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Cada uno de los tres primeros partzufim, estando enraizado en una de las tres "
          },
          {
            "bbox": [
              53.85833740234375,
              114.8310546875,
              442.2433776855469,
              125.2048110961914
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "sefirot superiores, comienza en un estado de gadlut, de madurez, como un grupo "
          },
          {
            "bbox": [
              53.858306884765625,
              126.84630584716797,
              442.2393798828125,
              137.20481872558594
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "completo de diez sefirot. No sucede lo mismo con los dos partzufim inferiores, cuyos "
          },
          {
            "bbox": [
              53.858306884765625,
              138.7166290283203,
              441.56732177734375,
              149.0274658203125
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "recipientes soportaron la carga del Shevirat HaKeilim. Incluso en el Olam HaTikún "
          },
          {
            "bbox": [
              53.858306884765625,
              150.8691864013672,
              442.2383117675781,
              161.18955993652344
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "emergen en un estado de katnut, de inmadurez, con Zeir Anpin comenzando con "
          },
          {
            "bbox": [
              53.858306884765625,
              162.73951721191406,
              441.5823059082031,
              173.20481872558594
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "seis sefirot y Nukva/Maljut con sólo una. El Ari zal enseña que Zeir Anpin y Nukva "
          },
          {
            "bbox": [
              53.8582763671875,
              175.13746643066406,
              442.2284851074219,
              185.0274658203125
            ],
            "ids": [
              [
                2,
                6
              ]
            ],
            "text": "fueron creados incompletos para servir como paradigma de todo el desarrollo "
          },
          {
            "bbox": [
              53.8582763671875,
              187.0674591064453,
              442.2342834472656,
              197.0274658203125
            ],
            "ids": [
              [
                2,
                7
              ]
            ],
            "text": "humano y para que el hombre, a través de sus acciones, pueda llevarlos hacia su "
          },
          {
            "bbox": [
              53.8582763671875,
              198.8463134765625,
              442.2372741699219,
              209.20481872558594
            ],
            "ids": [
              [
                2,
                8
              ]
            ],
            "text": "forma final. Con ese objetivo, esos dos partzufim interactúan entre sí de una manera "
          },
          {
            "bbox": [
              53.85829162597656,
              211.0674591064453,
              442.2373046875,
              221.0274658203125
            ],
            "ids": [
              [
                2,
                9
              ]
            ],
            "text": "antropomórfica, expandiéndose y disminuyéndose, uniéndose y separándose. La "
          },
          {
            "bbox": [
              53.85829162597656,
              223.0674591064453,
              442.2273254394531,
              233.0274658203125
            ],
            "ids": [
              [
                2,
                10
              ]
            ],
            "text": "Kabalá identifica sus estados de desarrollo, implementados a través de la Persona "
          },
          {
            "bbox": [
              53.85829162597656,
              235.0674591064453,
              442.2474365234375,
              245.0274658203125
            ],
            "ids": [
              [
                2,
                11
              ]
            ],
            "text": "Divina de Ima, como gestación, nacimiento, nutrición y madurez. Esos términos "
          },
          {
            "bbox": [
              53.85829162597656,
              246.8691864013672,
              442.2373352050781,
              257.1895446777344
            ],
            "ids": [
              [
                2,
                12
              ]
            ],
            "text": "indican la capacidad de Zeir Anpin y de Nukva de transmitir la influencia Divina "
          },
          {
            "bbox": [
              53.8582763671875,
              258.8768310546875,
              255.21484375,
              266.7774658203125
            ],
            "ids": [
              [
                2,
                13
              ]
            ],
            "text": "desde Atzilut hacia los mundos inferiores.[12]"
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          53.85523986816406,
          276.35565185546875,
          442.24310302734375,
          512.4469604492188
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              276.35565185546875,
              442.2373046875,
              286.87432861328125
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Aunque en un sentido general cada sefirá es reconstituida como un solo "
          },
          {
            "bbox": [
              53.85821533203125,
              288.35565185546875,
              442.2392272949219,
              298.87432861328125
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "partzuf, en el estado rectificado del Olam HaTikún la sefirá de Kéter está compuesta "
          },
          {
            "bbox": [
              53.857208251953125,
              300.40142822265625,
              442.2383117675781,
              310.87432861328125
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "por dos grupos de diez sefirot. Esto refleja el papel de Kéter como el intermediario "
          },
          {
            "bbox": [
              53.857208251953125,
              312.84698486328125,
              442.24310302734375,
              322.6969909667969
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "entre mundos adyacentes, como Emanador y como lo que es emanado. Un grupo de "
          },
          {
            "bbox": [
              53.857208251953125,
              324.35565185546875,
              442.23834228515625,
              334.87432861328125
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "la sefirá de Kéter representa la parte inferior del mundo superior, mientras que el otro "
          },
          {
            "bbox": [
              53.85621643066406,
              336.5005798339844,
              442.23822021484375,
              346.6969909667969
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "grupo representa la parte superior del mundo inferior. Así en la etapa de berudim, "
          },
          {
            "bbox": [
              53.85626220703125,
              348.40142822265625,
              442.2373046875,
              358.87432861328125
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "Kéter de hecho está reconstituido como dos partzufim diferentes. La primera Persona "
          },
          {
            "bbox": [
              53.855255126953125,
              360.40142822265625,
              442.240234375,
              370.6969909667969
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "Divina de Kéter, superior e interna, es llamada Atik Iomim, el Anciano de Días. Dado "
          },
          {
            "bbox": [
              53.855255126953125,
              372.4929504394531,
              442.2361755371094,
              382.6969909667969
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "que es representativa de la absoluta trascendencia, el Zohar (III, 288b) hace referencia "
          },
          {
            "bbox": [
              53.855255126953125,
              384.5158386230469,
              442.232177734375,
              394.87432861328125
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "a los varios niveles de ese partzuf de diferentes maneras, incluyendo el nombrar a "
          },
          {
            "bbox": [
              53.855255126953125,
              396.4929504394531,
              442.2393493652344,
              406.87432861328125
            ],
            "ids": [
              [
                3,
                10
              ]
            ],
            "text": "sus sefirot más elevadas como Atika Kadisha, el Santo Anciano, indicando que se "
          },
          {
            "bbox": [
              53.85528564453125,
              408.84698486328125,
              442.2272644042969,
              418.6969909667969
            ],
            "ids": [
              [
                3,
                11
              ]
            ],
            "text": "encuentra por encima y separada de toda realidad conocida. La segunda Persona "
          },
          {
            "bbox": [
              53.85528564453125,
              420.40142822265625,
              442.2383117675781,
              430.85906982421875
            ],
            "ids": [
              [
                3,
                12
              ]
            ],
            "text": "Divina de Kéter, más inferior y externa, es llamada Arij Anpin. Representativa de la "
          },
          {
            "bbox": [
              53.855255126953125,
              432.5158386230469,
              442.23828125,
              442.87432861328125
            ],
            "ids": [
              [
                3,
                13
              ]
            ],
            "text": "voluntad Divina de crear, es la interfaz fundamental entre el Ein Sof y Su creación "
          },
          {
            "bbox": [
              53.855255126953125,
              444.5158386230469,
              442.2372741699219,
              454.87432861328125
            ],
            "ids": [
              [
                3,
                14
              ]
            ],
            "text": "finita. En la medida en que un partzuf es una figura metafórica de similitud humana, "
          },
          {
            "bbox": [
              53.85523986816406,
              456.4929504394531,
              442.2381591796875,
              466.6969909667969
            ],
            "ids": [
              [
                3,
                15
              ]
            ],
            "text": "Atik Iomim es “retratado” como Reisha deLo Isiada, la Cabeza que no Conoce ni es "
          },
          {
            "bbox": [
              53.85523986816406,
              468.7141418457031,
              442.2400817871094,
              478.85906982421875
            ],
            "ids": [
              [
                3,
                16
              ]
            ],
            "text": "Conocida. Arij Anpin, cuyo nombre indica paciencia y compasión,[13 ]está asociado "
          },
          {
            "bbox": [
              53.8580322265625,
              480.50054931640625,
              442.2401123046875,
              490.8742980957031
            ],
            "ids": [
              [
                3,
                17
              ]
            ],
            "text": "con la Barba Superior, cuyas trece facetas son los tikuney dikna, los niveles de "
          },
          {
            "bbox": [
              53.858001708984375,
              492.7369689941406,
              442.2321472167969,
              502.69696044921875
            ],
            "ids": [
              [
                3,
                18
              ]
            ],
            "text": "rectificación [canalizados a través de los pelos] de la barba, correspondientes a los "
          },
          {
            "bbox": [
              53.858001708984375,
              504.8469543457031,
              201.74801635742188,
              512.4469604492188
            ],
            "ids": [
              [
                3,
                19
              ]
            ],
            "text": "Trece Atributos de Misericordia."
          }
        ]
      },
      {
        "index": 5,
        "class": "section-header",
        "bbox": [
          53.85820007324219,
          529.0794677734375,
          289.7806091308594,
          538.9600219726562
        ],
        "lines": [
          {
            "bbox": [
              53.85820007324219,
              529.0794677734375,
              289.7806091308594,
              538.9600219726562
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Arba Olamot: ABIA (Cuatro Mundos de ABIA)"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.85821533203125,
          546.6245727539062,
          442.2431945800781,
          580.9659423828125
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              546.6245727539062,
              442.240234375,
              556.9659423828125
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "De los incalculables mundos que emergieron de Adam Kadmón, los cuatro "
          },
          {
            "bbox": [
              53.85821533203125,
              558.6245727539062,
              442.2412109375,
              568.9659423828125
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "primarios en orden descendente son: Atzilut, el Mundo de la Emanación; Beriá, el "
          },
          {
            "bbox": [
              53.85821533203125,
              570.6245727539062,
              442.2431945800781,
              580.9659423828125
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "Mundo de la Creación; Ietzirá, el Mundo de la Formación; y Asiá, el Mundo de la "
          }
        ]
      },
      {
        "index": 7,
        "class": "page-footer",
        "bbox": [
          223.1020050048828,
          605.7279663085938,
          271.0730285644531,
          612.8259887695312
        ],
        "lines": [
          {
            "bbox": [

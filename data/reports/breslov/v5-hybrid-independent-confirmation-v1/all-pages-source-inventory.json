            "bbox": [
              56.69389343261719,
              363.6509704589844,
              445.0760498046875,
              373.7909851074219
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "tierra entera está llena de Su gloria”, entonces los senderos de su intelecto nunca "
          },

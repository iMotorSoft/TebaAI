              452.5804443359375,
              242.49209594726562,
              459.3919677734375
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "52 La Kabalá enseña que la estructura interna de Daat está "
          },
          {
            "bbox": [
              53.85884094238281,
              460.10546875,
              242.49810791015625,
              468.407958984375
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "formada por la confl uencia de jasadim, benevolencias, "
          },
          {
            "bbox": [
              53.859588623046875,
              469.10546875,
              242.4913330078125,
              477.407958984375
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "los elementos fundamentales de la sefi rá de Jesed que se "
          },
          {
            "bbox": [
              53.859588623046875,
              478.10546875,
              242.49362182617188,
              486.407958984375
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "extienden desde Jojmá en el lado derecho de la confi guración "
          },
          {
            "bbox": [
              53.85960388183594,
              487.10546875,
              242.5004119873047,
              495.407958984375
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "de las sefi rot, y por las guevurot, las severidades, los elementos "
          },
          {
            "bbox": [
              53.85961151123047,
              497.5804443359375,
              242.49061584472656,
              504.3919677734375
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "fundamentales de Guevurá que se extienden desde Biná sobre "
          },
          {
            "bbox": [
              53.859619140625,
              505.10546875,
              242.49136352539062,
              513.407958984375
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "el lado izquierdo (ver Diagramas). El paralelo de la sefi rá de "
          },
          {
            "bbox": [
              53.859619140625,
              515.5804443359375,
              242.50938415527344,
              522.3919677734375
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "Daat es el daat en la mente del hombre (ver la nota 13 más "
          },
          {
            "bbox": [
              53.859622955322266,
              523.10546875,
              242.49514770507812,
              531.407958984375
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "arriba). El daat del hombre está formado por la confl uencia "
          },
          {
            "bbox": [
              53.85963439941406,
              533.5804443359375,
              242.51168823242188,
              540.4066162109375
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "de los jasadim, la cualidad de la bondad y de la generosidad, "
          },
          {
            "bbox": [
              53.85963439941406,
              542.5804443359375,
              242.50192260742188,
              549.4066162109375
            ],
            "ids": [
              [
                5,
                10
              ]
            ],
            "text": "que se desenvuelven a partir de jojmá de la sabiduría humana, "
          },
          {
            "bbox": [
              53.85962677001953,
              551.5767822265625,
              242.51397705078125,
              558.4066162109375
            ],
            "ids": [
              [
                5,
                11
              ]
            ],
            "text": "y de las guevurot, las cualidades del juicio y de la restricción "
          },
          {
            "bbox": [
              53.85962677001953,
              560.5804443359375,
              242.4913787841797,
              567.3919677734375
            ],
            "ids": [
              [
                5,
                12
              ]
            ],
            "text": "que se desenvuelven desde biná, la comprensión humana (Etz "
          },
          {
            "bbox": [
              53.859619140625,
              569.5767822265625,
              242.50790405273438,
              576.4066162109375
            ],
            "ids": [
              [
                5,
                13
              ]
            ],
            "text": "Jaim 25:2 y 34:3). En el LM I, 10:6, el Rebe Najmán conecta "
          },
          {
            "bbox": [
              53.859622955322266,
              578.5804443359375,
              131.97662353515625,
              585.4066162109375
            ],
            "ids": [
              [
                5,

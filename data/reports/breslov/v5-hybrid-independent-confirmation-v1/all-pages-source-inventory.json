              413.6240539550781,
              120.44195556640625
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "de HaShem trayendo los dinim,[8] los agentes del sufrimiento y del infortunio."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          56.6929931640625,
          125.08056640625,
          445.0790100097656,
          183.2769775390625
        ],
        "lines": [
          {
            "bbox": [
              85.0929946899414,
              125.08056640625,
              445.0760192871094,
              135.2769775390625
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "La forma de quebrar la pasión por el dinero es a través de la tzedaka. El dar "
          },
          {
            "bbox": [
              56.6929931640625,
              136.9661407470703,
              445.0729675292969,
              147.35516357421875
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "tzedaka genera un rúaj de generosidad en la persona, un rúaj que sopla sobre su "
          },
          {
            "bbox": [
              56.6929931640625,
              148.93563842773438,
              444.406005859375,
              159.2769775390625
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "corazón y enfría el ardiente deseo de dinero.[9] También debe dedicarse al masá "
          },
          {
            "bbox": [
              56.6929931640625,
              160.93563842773438,
              445.0790100097656,
              171.2769775390625
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "u-matán ve-emuná.[10] Contento con lo que le ha tocado y con lo que HaShem lo ha "
          },
          {
            "bbox": [
              56.69300079345703,
              173.29600524902344,
              280.351806640625,
              183.2769775390625
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "favorecido, su pasión por el dinero desaparece.[11]"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.6929931640625,
          188.26095581054688,
          445.08795166015625,
          255.8609619140625
        ],
        "lines": [
          {
            "bbox": [
              85.09310150146484,
              188.26095581054688,
              445.0550842285156,
              198.1109619140625
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "En la medida en que el ardiente deseo de riqueza se ve atemperado, de la "
          },
          {
            "bbox": [
              56.69309997558594,
              200.1509552001953,
              445.05706787109375,
              210.1109619140625
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "misma manera lo es la ira ardiente de HaShem. Los orígenes espirituales de la ira, "
          },
          {
            "bbox": [
              56.69309997558594,
              211.91455078125,
              445.08795166015625,
              222.18914794921875
            ],
            "ids": [
              [
                9,
                2
              ]
            ],
            "text": "los dinim, son mitigados y el jesed, la bondad, fluye libremente en el mundo.[12] Esta "
          },
          {
            "bbox": [
              56.6929931640625,
              223.91455078125,
              445.0749816894531,
              234.18914794921875
            ],
            "ids": [
              [
                9,
                3
              ]
            ],
            "text": "proliferación de los elementos de jesed lleva a su vez a la manifestación del daat, el "
          },
          {
            "bbox": [
              56.6929931640625,
              236.22096252441406,
              445.0690002441406,
              246.1109619140625
            ],
            "ids": [
              [
                9,
                4
              ]
            ],
            "text": "conocimiento unificador y la conciencia de que la inmanencia de HaShem llena "
          },
          {
            "bbox": [
              56.6929931640625,
              248.13002014160156,
              140.12484741210938,
              255.8609619140625
            ],
            "ids": [
              [
                9,
                5
              ]
            ],
            "text": "toda la creación.[13]"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.693115234375,
          262.7496643066406,
          445.0749816894531,
          285.0242614746094
        ],
        "lines": [
          {
            "bbox": [
              85.09310150146484,
              262.7496643066406,
              444.3951110839844,
              272.9460754394531
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "Jazal enseñan que el adquirir daat es análogo a la construcción del Beit "
          },
          {
            "bbox": [
              56.693115234375,
              274.604736328125,
              445.0749816894531,
              285.0242614746094
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "HaMikdash.[14] Así como el Beit HaMikdash es la morada de la Shejiná en el mundo, "
          }
        ]
      },
      {
        "index": 7,
        "class": "section-header",
        "bbox": [
          225.79400634765625,
          303.60198974609375,
          273.7650451660156,
          310.6999816894531
        ],
        "lines": [
          {
            "bbox": [
              225.79400634765625,
              303.60198974609375,
              273.7650451660156,
              310.6999816894531
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.69288635253906,
          324.4044494628906,
          245.3524627685547,
          412.2159729003906
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              322.9294738769531,
              245.33145141601562,
              331.2319641113281
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "que se preocupa y se angustia por no tener sufi ciente dinero. Su "
          },
          {
            "bbox": [
              56.69291687011719,
              333.4044494628906,
              245.32467651367188,
              340.2306213378906
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "preocupación indica una falta en su emuná y en su bitajón, una "
          },
          {
            "bbox": [
              56.69293212890625,
              340.9294738769531,
              245.3374481201172,
              349.2319641113281
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "incapacidad de confi ar en que HaShem le proveerá del sustento "
          },
          {
            "bbox": [
              56.692935943603516,
              349.9294738769531,
              223.31370544433594,
              358.2319641113281
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "sin que tenga que sacrifi car toda su vida para obtenerlo."
          },
          {
            "bbox": [
              56.69293212890625,
              360.4044494628906,
              245.33145141601562,
              367.2306213378906
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "8 Ver LM I, 180, que el dinero y los dinim comparten la "
          },
          {
            "bbox": [
              56.69291687011719,
              369.4044494628906,
              245.32391357421875,
              376.2159729003906
            ],
            "ids": [
              [
                11,
                5
              ]
            ],
            "text": "misma raíz espiritual; así, para la persona con taavat mamón, "
          },
          {
            "bbox": [
              56.692901611328125,
              378.4044494628906,
              245.34495544433594,
              385.2306213378906
            ],
            "ids": [
              [
                11,
                6
              ]
            ],
            "text": "ganarse la vida es una lucha dura y difícil. Al igual que Adam "
          },
          {
            "bbox": [
              56.692901611328125,
              387.4044494628906,
              245.3524627685547,
              394.2306213378906
            ],
            "ids": [
              [
                11,
                7
              ]
            ],
            "text": "después de haber pecado, el sustento le llegará “mediante el "
          },
          {
            "bbox": [
              56.692901611328125,
              396.4044494628906,
              245.32615661621094,
              403.2306213378906
            ],
            "ids": [
              [
                11,
                8
              ]
            ],
            "text": "sufrimiento… y con el sudor de la frente” (Bereshit 3:17, 19; "
          },
          {
            "bbox": [
              56.69288635253906,
              405.4044494628906,
              168.9604034423828,
              412.2159729003906
            ],
            "ids": [
              [
                11,
                9
              ]
            ],
            "text": "ver también la nota 33 más adelante)."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.69288635253906,
          414.4007873535156,
          245.3539581298828,
          473.7145080566406
        ],
        "lines": [
          {
            "bbox": [
              56.69288635253906,
              414.4007873535156,
              245.34796142578125,
              421.2306213378906
            ],
            "ids": [
              [
                11,
                10
              ]
            ],
            "text": "9 El Rebe Najmán habla del deseo de dinero como una "
          },
          {
            "bbox": [
              56.69288635253906,
              421.9294738769531,
              245.3261260986328,
              430.2319641113281
            ],
            "ids": [
              [
                11,
                11
              ]
            ],
            "text": "confl agración del corazón. En base al Zohar (III, 224a), el "
          },
          {
            "bbox": [
              56.69288635253906,
              432.4007873535156,
              245.35018920898438,
              439.2306213378906
            ],
            "ids": [
              [
                11,
                12
              ]
            ],
            "text": "consejo del Rebe para enfriar la llama del ansia de dinero es "
          },
          {
            "bbox": [
              56.69288635253906,
              441.4044494628906,
              245.326904296875,
              448.2306213378906
            ],
            "ids": [
              [
                11,
                13
              ]
            ],
            "text": "entregarlo para tzedaka. Dar tzedaka crea un rúaj (espíritu) "
          },
          {
            "bbox": [
              56.69288635253906,
              450.4044494628906,
              245.33663940429688,
              457.2306213378906
            ],
            "ids": [
              [
                11,
                14
              ]
            ],
            "text": "de generosidad, un rúaj (viento) que sopla sobre el corazón "
          },
          {
            "bbox": [
              56.692893981933594,
              459.4044494628906,
              245.3539581298828,
              466.2306213378906
            ],
            "ids": [
              [
                11,
                15
              ]
            ],
            "text": "y aplaca su ardiente deseo de riquezas y la ira Divina que ello "
          },
          {
            "bbox": [
              56.692893981933594,
              470.1549377441406,
              76.05789947509766,
              473.7145080566406
            ],
            "ids": [
              [
                11,
                16
              ]
            ],
            "text": "evoca."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          56.6928825378418,
          477.4044494628906,
          245.35696411132812,
          574.2159423828125
        ],
        "lines": [
          {
            "bbox": [
              56.692893981933594,
              477.4044494628906,
              245.35092163085938,
              484.2306213378906
            ],
            "ids": [
              [
                11,
                17
              ]
            ],
            "text": "10 Dedicarse al “toma y daca del comercio con fe” y/o “con "
          },
          {
            "bbox": [
              56.692893981933594,
              486.4044494628906,
              245.34349060058594,
              493.2306213378906
            ],
            "ids": [
              [
                11,
                18
              ]
            ],
            "text": "honestidad”. Lo primero surge de la fe de la persona en que el "
          },
          {
            "bbox": [
              56.692893981933594,
              495.4044494628906,
              245.33444213867188,
              502.2306213378906
            ],
            "ids": [
              [
                11,
                19
              ]
            ],
            "text": "sustento del hombre sólo proviene de HaShem. Lo segundo "
          },
          {
            "bbox": [
              56.692893981933594,
              504.4044494628906,
              245.35696411132812,
              511.2159729003906
            ],
            "ids": [
              [
                11,
                20
              ]
            ],
            "text": "implica llevar a cabo todas las transacciones comerciales con "
          },
          {
            "bbox": [
              56.692893981933594,
              513.4044189453125,
              245.3531951904297,
              520.2305908203125
            ],
            "ids": [
              [
                11,
                21
              ]
            ],
            "text": "integridad. Tan importante es ser moralmente correctos al "
          },
          {
            "bbox": [
              56.692893981933594,
              522.4044189453125,
              245.336669921875,
              529.2305908203125
            ],
            "ids": [
              [
                11,
                22
              ]
            ],
            "text": "ganarse el sustento que enseñan Jazal: La primera pregunta "
          },
          {
            "bbox": [
              56.69288635253906,
              531.4044189453125,
              245.35092163085938,
              538.2159423828125
            ],
            "ids": [
              [
                11,
                23
              ]
            ],
            "text": "que le hacen a la persona frente a la Corte Celestial después "
          },
          {
            "bbox": [
              56.69288635253906,
              540.4044189453125,
              243.4496307373047,
              547.2305908203125
            ],
            "ids": [
              [
                11,
                24
              ]
            ],
            "text": "de haber fallecido es “¿Has llevado a cabo tus negocios be-"
          },
          {
            "bbox": [
              56.69288635253906,
              549.4044189453125,
              245.33212280273438,
              556.2159423828125
            ],
            "ids": [
              [
                11,
                25
              ]
            ],
            "text": "emuná?” (Shabat 31a). Sólo aquellos que han vivido una "
          },
          {
            "bbox": [
              56.6928825378418,
              558.4044189453125,
              245.33139038085938,
              565.2305908203125
            ],
            "ids": [
              [
                11,
                26
              ]
            ],
            "text": "vida de emuná y de bitajón serán capaces de responder "
          },
          {
            "bbox": [
              56.693641662597656,
              565.929443359375,
              226.43289184570312,
              574.23193359375
            ],
            "ids": [
              [
                11,
                27
              ]
            ],
            "text": "afi rmativamente. (Ver también LH, Avedá u-Metziá 3:3)."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          56.693634033203125,
          576.4044189453125,
          245.35545349121094,
          646.2305908203125
        ],
        "lines": [
          {
            "bbox": [
              56.693634033203125,
              576.4044189453125,
              245.35247802734375,
              583.2305908203125
            ],
            "ids": [
              [
                11,
                28
              ]
            ],
            "text": "11 El Rabí Natán incluye esta idea en la plegaria que compuso "
          },
          {
            "bbox": [
              56.693634033203125,
              585.4044189453125,
              245.3374481201172,
              592.2305908203125
            ],
            "ids": [
              [
                11,
                29
              ]
            ],
            "text": "en base al LM I, 13. Le ruega a HaShem que lo ayude a "
          },
          {
            "bbox": [
              56.693634033203125,
              594.4044189453125,
              245.336669921875,
              601.2305908203125
            ],
            "ids": [
              [
                11,
                30
              ]
            ],
            "text": "dedicarse al masá u-matán be-emuná y que le permita hacer "
          },
          {
            "bbox": [
              56.693634033203125,
              603.4044189453125,
              245.35545349121094,
              610.2305908203125
            ],
            "ids": [
              [
                11,
                31
              ]
            ],
            "text": "del estudio de la Torá su ocupación principal y del ganarse el "
          },
          {
            "bbox": [
              56.693634033203125,
              612.4044189453125,
              245.35023498535156,
              619.2159423828125
            ],
            "ids": [
              [
                11,
                32
              ]
            ],
            "text": "sustento una tarea ocasional. Pide también la sabiduría para "
          },
          {
            "bbox": [
              56.693634033203125,
              621.4044189453125,
              245.34646606445312,
              628.2305908203125
            ],
            "ids": [
              [
                11,
                33
              ]
            ],
            "text": "no agotar su mente al ganarse el sustento y, al dedicarse a los "
          },
          {
            "bbox": [
              56.693634033203125,
              630.4044189453125,
              245.3389129638672,
              637.2305908203125
            ],
            "ids": [
              [
                11,
                34
              ]
            ],
            "text": "negocios, ser capaz de apegar sus pensamientos a HaShem y "
          },
          {
            "bbox": [
              56.693634033203125,
              639.4044189453125,
              245.35317993164062,
              646.2305908203125
            ],
            "ids": [
              [
                11,
                35
              ]
            ],
            "text": "a la sagrada Torá que está embebida dentro del toma y daca "
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          255.4496307373047,

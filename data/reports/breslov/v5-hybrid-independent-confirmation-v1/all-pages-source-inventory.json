              401.0989685058594
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.692901611328125,
          414.9808044433594,
          245.35018920898438,
          438.2945251464844
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              414.9808044433594,
              245.34799194335938,
              421.8106384277344
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "moral instila en las almas judías un aroma placentero - i.e., "
          },
          {
            "bbox": [
              56.692901611328125,
              423.9844665527344,
              245.35018920898438,
              430.7959899902344
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "el sustento espiritual para el alma, sobre lo cual continuará "
          },
          {
            "bbox": [
              56.692901611328125,
              432.9844665527344,
              126.26290893554688,
              438.2945251464844
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "tratando el Rabí Natán."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.69288635253906,
          441.9844665527344,
          245.34042358398438,
          493.7959899902344
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              441.9844665527344,
              245.34042358398438,
              448.8106384277344
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "29 El Tikuney Zohar enseña que cada persona recibe el "
          },
          {
            "bbox": [
              56.692893981933594,
              450.9844665527344,
              245.3321533203125,
              457.8106384277344
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "sustento que merece [de acuerdo a la shefa, a la abundancia "
          },
          {
            "bbox": [
              56.69288635253906,
              459.9844665527344,
              245.32313537597656,
              466.8106384277344
            ],
            "ids": [
              [
                13,
                5
              ]
            ],
            "text": "que evoca mediante sus plegarias]. Para algunos esta shefa es "
          },
          {
            "bbox": [
              56.69288635253906,
              468.9844665527344,
              245.32989501953125,
              475.8106384277344
            ],
            "ids": [
              [
                13,
                6
              ]
            ],
            "text": "Torá, el sustento para el alma. Para otros la shefa que desciende "
          },
          {
            "bbox": [
              56.69288635253906,
              477.9844665527344,
              245.32537841796875,
              484.8106384277344
            ],
            "ids": [
              [
                13,
                7
              ]
            ],
            "text": "se transforma en pan, el sustento para el cuerpo (Tikuney Zohar "
          },
          {
            "bbox": [
              56.69288635253906,
              486.9844665527344,
              151.69537353515625,
              493.7959899902344
            ],
            "ids": [
              [
                13,
                8
              ]
            ],
            "text": "#21, p. 45b; ibid. #69, p. 101b)."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          56.69288635253906,
          495.9844665527344,
          245.35540771484375,
          574.7960205078125
        ],
        "lines": [
          {
            "bbox": [
              77.99288940429688,
              494.5094909667969,
              245.326904296875,
              502.8119812011719
            ],
            "ids": [
              [
                13,
                9
              ]
            ],
            "text": "El Rebe enseña que el alma es sustentada por la “fl ora” "
          },
          {
            "bbox": [
              56.692901611328125,
              504.9808044433594,
              245.35238647460938,
              511.8106384277344
            ],
            "ids": [
              [
                13,
                10
              ]
            ],
            "text": "que crece en el jardín regado por la voz - es decir la fragancia "
          },
          {
            "bbox": [
              56.692901611328125,
              513.9844970703125,
              245.33590698242188,
              520.8106689453125
            ],
            "ids": [
              [
                13,
                11
              ]
            ],
            "text": "y el temor a HaShem. Jazal enseñan que la fragancia es la "
          },
          {
            "bbox": [
              56.693641662597656,
              522.9844970703125,
              245.32765197753906,
              529.8106689453125
            ],
            "ids": [
              [
                13,
                12
              ]
            ],
            "text": "fuente de la cual deriva placer el alma en este mundo (Berajot "
          },
          {
            "bbox": [
              56.693634033203125,
              531.9844970703125,
              245.33370971679688,
              538.7960205078125
            ],
            "ids": [
              [
                13,
                13
              ]
            ],
            "text": "43b), pues el olfato es el más espiritual de todos los sentidos "
          },
          {
            "bbox": [
              56.693634033203125,
              540.9844970703125,
              245.336669921875,
              547.7960205078125
            ],
            "ids": [
              [
                13,
                14
              ]
            ],
            "text": "físicos (Maharsha, loc. cit., v.i. tahará). También crece en este "
          },
          {
            "bbox": [
              56.69288635253906,
              549.9808349609375,
              245.3553924560547,
              556.8106689453125
            ],
            "ids": [
              [
                13,
                15
              ]
            ],
            "text": "jardín el temor a HaShem, que está asociado con la fragancia, "
          },
          {
            "bbox": [
              56.69288635253906,
              557.6112060546875,
              245.35540771484375,
              565.7960205078125
            ],
            "ids": [
              [
                13,
                16
              ]
            ],
            "text": "como en “Él estará imbuido del perfume del temor a HaShem” "
          },
          {
            "bbox": [
              56.69288635253906,
              567.9844970703125,
              95.5721435546875,
              574.7960205078125
            ],
            "ids": [
              [
                13,
                17
              ]
            ],
            "text": "(Isaías 11:3)."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          56.69288635253906,
          576.9844970703125,
          245.35543823242188,
          646.8106689453125
        ],
        "lines": [
          {
            "bbox": [
              56.69288635253906,
              576.9844970703125,
              245.35400390625,
              582.2945556640625
            ],
            "ids": [
              [
                13,
                18
              ]
            ],
            "text": "30 Antitético al sustento del alma se encuentra el sustento del "
          },
          {
            "bbox": [
              56.69288635253906,
              585.9844970703125,
              245.347900390625,
              592.8106689453125
            ],
            "ids": [
              [
                13,
                19
              ]
            ],
            "text": "cuerpo, el alimento y la bebida que, cuando son ingeridos en "
          },
          {
            "bbox": [
              56.69288635253906,
              594.9844970703125,
              245.3329620361328,
              601.7960205078125
            ],
            "ids": [
              [
                13,
                20
              ]
            ],
            "text": "exceso, nutren los deseos físicos. Un aumento en el poder de "
          },
          {
            "bbox": [
              56.69288635253906,
              603.9844970703125,
              245.34417724609375,
              610.8106689453125
            ],
            "ids": [
              [
                13,
                21
              ]
            ],
            "text": "uno genera una disminución equivalente en el poder del otro. "
          },
          {
            "bbox": [
              56.69288635253906,
              611.509521484375,
              245.3343963623047,
              619.81201171875
            ],
            "ids": [
              [
                13,
                22
              ]
            ],
            "text": "Así, por ejemplo, el aumento de la infl uencia del sustento del "
          },
          {
            "bbox": [
              56.69288635253906,
              621.9844970703125,
              245.35543823242188,
              628.8106689453125
            ],
            "ids": [
              [
                13,
                23
              ]
            ],
            "text": "cuerpo debilita la conexión del alma arriba y su capacidad de "
          },
          {
            "bbox": [
              56.69288635253906,
              630.9844970703125,
              245.3524169921875,
              637.8106689453125
            ],
            "ids": [
              [
                13,
                24
              ]
            ],
            "text": "recibir abundancia espiritual, haciendo que la gula sea una "
          },
          {
            "bbox": [
              56.69288635253906,
              638.509521484375,
              235.41868591308594,
              646.81201171875
            ],
            "ids": [
              [
                13,
                25
              ]
            ],
            "text": "importante difi cultad para el logro de objetivos espirituales."
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          255.44961547851562,
          414.9844665527344,
          444.112548828125,
          466.8106384277344
        ],
        "lines": [
          {
            "bbox": [
              255.44961547851562,
              414.9844665527344,
              444.08135986328125,
              421.7959899902344
            ],
            "ids": [
              [
                14,
                0
              ]
            ],
            "text": "31 Esto como en “La voz es la voz de Iaacov” (Bereshit 27:22). "
          },
          {
            "bbox": [
              255.44961547851562,
              423.9808044433594,
              444.1094970703125,
              430.8106384277344
            ],
            "ids": [
              [
                14,
                1
              ]
            ],
            "text": "Itzjak también bendijo a Iaacov, diciendo, “Mira, la fragancia "
          },
          {
            "bbox": [
              255.44961547851562,
              432.9808044433594,
              444.112548828125,
              439.8106384277344
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "de mi hijo es como el perfume del campo” (ibid. 27:27). Rashi "
          },
          {
            "bbox": [
              255.44961547851562,
              441.9844665527344,
              444.10430908203125,
              448.8106384277344
            ],
            "ids": [
              [
                14,
                3
              ]
            ],
            "text": "(loc. cit.) agrega que HaShem instiló en Iaacov la fragancia "
          },
          {
            "bbox": [
              255.44961547851562,
              450.9844665527344,
              444.09674072265625,
              457.7959899902344
            ],
            "ids": [
              [
                14,
                4
              ]
            ],
            "text": "del Gan Edén. En el contexto aquí, esto fue porque Iaacov "
          },
          {
            "bbox": [
              255.44961547851562,
              459.9808044433594,
              364.3719177246094,
              466.8106384277344
            ],
            "ids": [
              [
                14,
                5
              ]
            ],
            "text": "representa la voz que riega el jardín."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          255.4495849609375,
          468.9844665527344,
          444.1094970703125,
          538.7960205078125
        ],
        "lines": [
          {
            "bbox": [
              255.44961547851562,
              468.9844665527344,
              444.1094970703125,
              475.8106384277344
            ],
            "ids": [
              [
                14,
                6
              ]
            ],
            "text": "32 Iaacov es la voz y así está asociado con el sustento del alma. "
          },
          {
            "bbox": [
              255.44961547851562,
              477.9844665527344,
              444.0902404785156,
              484.8106384277344
            ],
            "ids": [
              [
                14,
                7
              ]
            ],
            "text": "Esaú corresponde al cuerpo y a sus deseos (Rabeinu Bejaie al "
          },
          {
            "bbox": [
              255.44961547851562,
              486.9844665527344,
              444.0916442871094,
              493.8106384277344
            ],
            "ids": [
              [
                14,
                8
              ]
            ],
            "text": "HaTorá, Bereshit 25:27) y así está asociado con el sustento del "
          },
          {
            "bbox": [
              255.44961547851562,
              495.9844665527344,
              444.1056823730469,
              502.8106384277344
            ],
            "ids": [
              [
                14,
                9
              ]
            ],
            "text": "cuerpo, el alimento y la bebida que al ser ingeridos en exceso "
          },
          {
            "bbox": [
              255.44961547851562,
              503.5928649902344,
              444.096923828125,
              511.8106384277344
            ],
            "ids": [
              [
                14,
                10
              ]
            ],
            "text": "“le dan fuerza al talón del Sitra Ájara”, como el Rebe explica "
          },
          {
            "bbox": [
              255.4495849609375,
              513.9808349609375,
              444.1072692871094,
              520.8106689453125
            ],
            "ids": [
              [
                14,
                11
              ]
            ],
            "text": "en su lección. Cuando el alma y el cuerpo entran juntos al "
          },
          {
            "bbox": [
              255.4495849609375,
              522.9844970703125,
              444.09686279296875,
              529.8106689453125
            ],
            "ids": [
              [
                14,
                12
              ]
            ],
            "text": "mundo, lo espiritual subyuga a los físico, algo representado "
          },
          {
            "bbox": [
              255.4495849609375,
              531.9844970703125,
              410.81182861328125,
              538.7960205078125
            ],
            "ids": [
              [
                14,
                13
              ]
            ],
            "text": "por “la mano de Iaacov aferrando el talón de Esaú”."
          }
        ]
      },

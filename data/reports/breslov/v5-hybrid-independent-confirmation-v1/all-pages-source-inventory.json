              423.8549499511719
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "“He puesto a HaShem "
          },
          {
            "bbox": [
              360.0,
              425.8389587402344,
              440.9119873046875,
              433.4549560546875
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "siempre delante de mí; "
          },
          {
            "bbox": [
              360.0,
              434.1189880371094,
              428.4639892578125,
              442.7669677734375
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "Él está a mi diestra, "
          },
          {
            "bbox": [
              360.0,
              445.32696533203125,
              409.343994140625,
              452.65496826171875
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "no tropezaré”."
          },
          {
            "bbox": [
              360.0,
              455.1189880371094,
              401.4079895019531,
              461.6949768066406
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "(Salmos 16:8)Salmos 16:8))"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.85699462890625,
          416.53997802734375,
          442.3350524902344,
          560.4801025390625
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              416.23895263671875,
              438.68798828125,
              428.47998046875
            ],
            "ids": [
              [
                4,
                0
              ],
              [
                13,
                0
              ]
            ],
            "text": "Ésta es, entonces, la explicación de este versículo. “He “He puesto a HaShem "
          },
          {
            "bbox": [
              360.0,
              425.8389587402344,
              440.9119873046875,
              433.4549560546875
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "siempre delante de mí; "
          },
          {
            "bbox": [
              53.858116149902344,
              430.3399658203125,
              428.4639892578125,
              442.7669677734375
            ],
            "ids": [
              [
                4,
                1
              ],
              [
                13,
                2
              ]
            ],
            "text": "puesto a HaShem siempre delante de mí” -es decir, puedo fijar Él está a mi diestra, "
          },
          {
            "bbox": [
              53.858123779296875,
              440.53997802734375,
              409.343994140625,
              452.65496826171875
            ],
            "ids": [
              [
                4,
                2
              ],
              [
                13,
                3
              ]
            ],
            "text": "mi mente en percepciones de Divinidad- y “Él está a mi diestra, no tropezaré”."
          },
          {
            "bbox": [
              53.85810852050781,
              454.3399658203125,
              401.4079895019531,
              464.47998046875
            ],
            "ids": [
              [
                4,
                3
              ],
              [
                13,
                4
              ]
            ],
            "text": "no tropezaré”. Uno alcanza esas percepciones y está protegido (Salmos 16:8)Salmos 16:8))"
          },
          {
            "bbox": [
              53.85810852050781,
              466.3399658203125,
              442.236083984375,
              476.489990234375
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "mediante la “diestra”, dado que Maljut -i.e., la sabiduría inferior, a través de la "
          },
          {
            "bbox": [
              53.85809326171875,
              478.6299743652344,
              442.3350524902344,
              488.47998046875
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "cual se obtienen las percepciones de Divinidad- se construye principalmente por "
          },
          {
            "bbox": [
              53.85809326171875,
              490.298828125,
              442.2330627441406,
              500.6573181152344
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "medio del lado derecho de la configuración de las sefirot, especialmente a través "
          },
          {
            "bbox": [
              53.858062744140625,
              502.3399658203125,
              442.3290100097656,
              512.4599609375
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "de la revelación de jesed, como el Rebe escribe allí en su lección.[33 ]Pues mediante "
          },
          {
            "bbox": [
              53.858001708984375,
              514.3294677734375,
              442.3249816894531,
              524.5582885742188
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "los actos de jesed separamos a Maljut de los Cuatro Reinos del mal y Lo elevamos "
          },
          {
            "bbox": [
              53.858001708984375,
              526.630126953125,
              442.3290100097656,
              536.4801025390625
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "hacia el Or HaPanim que brilla durante los Shalosh Regalim. Esta luz surge de la "
          },
          {
            "bbox": [
              53.85699462890625,
              538.340087890625,
              442.3279724121094,
              548.4901123046875
            ],
            "ids": [
              [
                4,
                10
              ]
            ],
            "text": "alegría en el corazón engendrada por las mitzvot que llevamos a cabo a lo largo "
          },
          {
            "bbox": [
              53.85699462890625,
              550.340087890625,
              296.9676513671875,
              560.4801025390625
            ],
            "ids": [
              [
                4,
                11
              ]
            ],
            "text": "del año. Estudia allí las palabras del Rebe Najmán.[34]"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",

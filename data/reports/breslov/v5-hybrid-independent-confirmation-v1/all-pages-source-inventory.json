            "bbox": [
              56.6929931640625,
              394.4819641113281,
              445.0749816894531,
              404.6219787597656
            ],
            "ids": [
              [
                15,
                8
              ]
            ],
            "text": "del alimento cuyo efecto espiritual negativo es la raíz de todos los excesos.[93] De "
          },
          {
            "bbox": [

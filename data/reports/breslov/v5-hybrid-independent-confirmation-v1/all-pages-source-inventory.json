              445.07391357421875,
              292.5589904785156
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "Casa, el Beit HaMikdash, para recibir el Or HaPanim, tal como decimos en la "
          },
          {
            "bbox": [
              56.692901611328125,
              294.3778381347656,
              445.1598815917969,
              304.736328125
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "plegaria de Musaf de las festividades, “Debido a nuestros pecados hemos sido "
          },
          {
            "bbox": [
              56.692901611328125,
              306.708984375,
              445.1630554199219,
              316.5589904785156
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "exiliados de nuestra tierra y alejados… Somos incapaces [de ascender para "
          },
          {
            "bbox": [
              56.692901611328125,
              318.708984375,
              262.48492431640625,
              328.5589904785156
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "presentarnos y postrarnos delante de Ti]”."
          }

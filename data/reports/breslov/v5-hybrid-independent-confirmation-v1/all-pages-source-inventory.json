              353.5142822265625,
              387.25396728515625
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "Pues en temas de santidad, todo daño es resultado de "
          },
          {
            "bbox": [
              53.85829162597656,
              389.7875671386719,
              353.4203796386719,
              399.9839782714844
            ],
            "ids": [
              [
                12,
                1

        "lines": [
          {
            "bbox": [
              82.25830078125,
              249.37496948242188,
              442.3302917480469,
              259.53497314453125
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "Es por ello que esta festividad es denominada Jánuca, a partir de janucá, "
          },
          {
            "bbox": [
              53.858306884765625,
              261.39495849609375,
              442.32904052734375,
              271.54498291015625
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "la dedicación del Beit HaMikdash que tuvo lugar durante ese período.[99]Pues la "
          },
          {
            "bbox": [
              53.8580322265625,
              273.5749816894531,
              442.33099365234375,
              283.53497314453125
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "principal revelación del Or HaPanim se encuentra en el Beit HaMikdash, al cual "
          },
          {
            "bbox": [
              53.8580322265625,
              285.39495849609375,
              439.37054443359375,
              295.53497314453125
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "ascendían los peregrinos en los Shalosh Regalim para recibir el Or HaPanim.[100]"
          },
          {
            "bbox": [
              53.85797119140625,
              295.594970703125,
              442.33099365234375,
              307.53497314453125
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "Éste es el concepto de Jánuca, es decir el infundirle vitalidad a Maljut proveniente "
          },
          {
            "bbox": [
              53.85797119140625,
              309.39495849609375,
              442.3349914550781,
              319.53497314453125
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "del Or HaPanim y así merecer una percepción de Divinidad - siendo ésta la "
          },
          {
            "bbox": [
              53.85797119140625,
              321.39495849609375,
              274.28802490234375,
              330.85498046875
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "esencia del encendido de las velas de Jánuca."
          }
        ]
      },

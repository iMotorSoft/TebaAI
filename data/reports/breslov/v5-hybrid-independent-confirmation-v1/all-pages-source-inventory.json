      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          82.20800018310547,
          254.19598388671875,
          397.5321044921875,
          312.5159912109375
        ],
        "lines": [
          {
            "bbox": [
              82.20829772949219,
              254.19598388671875,
              397.5281066894531,
              264.5159912109375
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "La persona debe fortalecerse como un león para levantarse por la "
          },
          {
            "bbox": [
              82.20829772949219,
              266.19598388671875,
              397.5302734375,
              276.5959777832031
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "mañana en el servicio a su Creador, de modo que sea ella quien "
          },
          {
            "bbox": [
              82.20829772949219,
              278.19598388671875,
              397.5321044921875,
              288.5159912109375
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "despierte el alba. Glosa: “He puesto a HaShem siempre delante "
          },
          {
            "bbox": [
              82.20830535888672,
              290.19598388671875,
              397.5289001464844,
              300.5159912109375
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "de mí”(Tehilim 16:8) - éste es un principio muy importante en el "
          },
          {
            "bbox": [
              82.20800018310547,
              302.19598388671875,
              308.26702880859375,
              312.5159912109375
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "cumplimiento de la Torá(Shuljan Aruj, Oraj Jaim 1:1)."
          }
        ]
      },

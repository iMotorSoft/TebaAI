              279.4009704589844,
              442.32232666015625,
              289.2509765625
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "todo el tiempo. El sueño espiritual amenaza constantemente con abrumar a "
          },
          {
            "bbox": [
              53.8582763671875,
              291.1109619140625,
              442.3311767578125,
              301.260986328125
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "la persona, hasta que ésta llega casi a sucumbir, que HaShem nos salve. En ese "
          },
          {
            "bbox": [
              53.8582763671875,
              303.4009704589844,
              246.00831604003906,
              313.2509765625
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "momento debe buscar su punto bueno."
          }
        ]
      },

            "bbox": [
              252.61642456054688,
              504.792236328125,
              441.2579040527344,
              513.0947265625
            ],
            "ids": [
              [
                9,
                12
              ]
            ],
            "text": "aquella que recibe de las otras sefi rot. Así, la luz que ilumina "
          },
          {
            "bbox": [
              252.6171875,
              515.2672119140625,
              441.2644348144531,
              522.0933837890625
            ],
            "ids": [
              [
                9,
                13
              ]
            ],
            "text": "a Maljut es una que ha sido disminuida mediante repetidas "
          },
          {
            "bbox": [
              252.6171875,
              522.792236328125,
              441.251953125,
              531.0947265625
            ],
            "ids": [
              [
                9,
                14
              ]
            ],
            "text": "constricciones. Este “empobrecimiento” está refl ejado en el "
          },

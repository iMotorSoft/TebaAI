      {
        "index": 1,
        "class": "page-header",
        "bbox": [
          351.63800048828125,
          48.250152587890625,
          441.9107666015625,
          54.962154388427734
        ],
        "lines": [
          {
            "bbox": [
              351.63800048828125,
              48.250152587890625,

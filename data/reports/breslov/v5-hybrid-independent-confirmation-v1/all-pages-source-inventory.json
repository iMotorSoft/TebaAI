            "bbox": [
              82.25810241699219,
              388.8299560546875,
              411.3460693359375,
              398.3499755859375
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "los conceptos que ha tratado hasta aquí en su discurso. Comienza con el "
          },
          {
            "bbox": [
              82.25810241699219,
              400.8299560546875,
              245.6480712890625,
              410.39996337890625
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "versículo citado de la glosa del Rama."
          }

              299.3719177246094,
              351.5320129394531,
              309.6541442871094
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "mishkán y habiendo generado el ijud de HaKadosh Baruj Hu con "
          },
          {
            "bbox": [
              53.80401611328125,
              311.234619140625,
              351.531005859375,
              321.6541442871094
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "Su Shejiná, podemos abrir nuestras bocas y decir palabras de "
          },
          {
            "bbox": [
              53.80400085449219,
              321.6359558105469,
              402.4649963378906,
              336.1770935058594
            ],
            "ids": [
              [
                1,
                10
              ],
              [
                10,
                3
              ]
            ],
            "text": "santidad. Éste es el principal ascenso del bien - es decir que (Salmos 51:17)Salmos 51:17))"
          },
          {
            "bbox": [
              53.80400085449219,
              335.4359436035156,
              351.5320129394531,
              345.5859680175781
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "se eleva a la dimensión del dibur. Y así esto es lo que ahora "
          },

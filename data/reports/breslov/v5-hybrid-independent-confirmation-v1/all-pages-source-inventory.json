            "bbox": [
              53.857513427734375,
              557.1387939453125,
              242.51712036132812,
              563.9686279296875
            ],
            "ids": [
              [
                10,
                26
              ]
            ],
            "text": "judíos que retornan a HaShem. (Es axiomático de las lecciones "

              441.25628662109375,
              609.44384765625
            ],
            "ids": [
              [
                14,
                8
              ]
            ],
            "text": "122 Ya hemos visto (§2 más arriba) que este “gran bien” es "
          },
          {
            "bbox": [
              252.61279296875,
              611.61767578125,
              441.2631530761719,
              618.42919921875
            ],
            "ids": [
              [
                14,
                9
              ]
            ],
            "text": "la Divinidad, los puntos buenos, implantados dentro de cada "
          },
          {
            "bbox": [
              252.61279296875,
              620.614013671875,
              269.9078063964844,
              627.44384765625
            ],
            "ids": [
              [
                14,
                10
              ]
            ],
            "text": "judío."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          252.61279296875,
          629.61767578125,
          441.26763916015625,
          645.42919921875
        ],
        "lines": [
          {
            "bbox": [
              252.61279296875,
              629.61767578125,
              441.2475280761719,
              636.44384765625
            ],
            "ids": [
              [
                14,
                11
              ]
            ],
            "text": "123 Rashi lee este versículo basado en la Mejilta: “Cuando "
          },
          {
            "bbox": [
              252.61282348632812,
              638.61767578125,
              441.26763916015625,
              645.42919921875
            ],
            "ids": [
              [
                14,
                12
              ]
            ],
            "text": "la luna se renueve será para ustedes el comienzo del mes”. "
          }
        ]
      }
    ]

              56.804779052734375,
              484.1109619140625,
              445.2767639160156,
              494.2509765625
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "donde se dedicaban a recitar pasajes de la Torá mientras se presentaba la ofrenda. "
          }
        ]
      },

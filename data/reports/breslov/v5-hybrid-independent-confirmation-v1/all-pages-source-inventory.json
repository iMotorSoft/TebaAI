              53.80401611328125,
              261.72900390625,
              412.36505126953125,
              273.5859680175781
            ],
            "ids": [
              [
                1,
                5
              ],
              [
                9,
                3
              ]
            ],
            "text": "específi camente como resultado de todo lo que se mencionó que el Mishkán "
          },
          {
            "bbox": [
              357.16497802734375,
              271.52099609375,
              400.7249755859375,
              279.1369934082031
            ],
            "ids": [
              [
                9,
                4
              ]
            ],
            "text": "[completo]”."
          },

              457.1809997558594
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "12 ■JÁNUCA Y EL BEIT HAMIKDASH"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          85.09249877929688,
          471.5509948730469,
          414.18450927734375,
          529.3610229492188
        ],
        "lines": [
          {
            "bbox": [
              85.09249877929688,
              471.5509948730469,
              414.1645812988281,
              481.83099365234375
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Habiendo enseñado anteriormente que jesed libera a Maljut del maljut "
          },
          {
            "bbox": [
              85.092529296875,
              483.7909851074219,
              414.1784973144531,
              493.3609924316406
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "del imperio griego -i.e., libera la sabiduría inferior de la influencia de la "
          },
          {
            "bbox": [
              85.092529296875,
              495.7909851074219,
              414.18450927734375,
              505.3110046386719
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "sabiduría externa- de modo que pueda ser fortalecida con el Or HaPanim, "
          },
          {
            "bbox": [
              85.092529296875,
              507.71099853515625,
              414.1835021972656,
              517.8309936523438
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "el Rabí Natán conecta aquí a jesed y el Or HaPanim con dos componentes "
          },
          {
            "bbox": [
              85.092529296875,
              519.551025390625,
              360.9105529785156,
              529.3610229492188
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "claves del milagro de Jánuca: los Kohanim y el Beit HaMikdash."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          56.6925048828125,
          537.289306640625,
          445.1654968261719,
          607.449951171875
        ],
        "lines": [
          {
            "bbox": [
              85.09255981445312,
              537.289306640625,
              445.0736083984375,
              547.5181274414062
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Por lo tanto el milagro de Jánuca, el triunfo de Maljut de santidad sobre "
          },
          {
            "bbox": [
              56.692535400390625,
              549.2999267578125,
              445.1654968261719,
              559.43994140625
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "los Cuatro Reinos, se produjo específicamente a través de los Kohanim. Pues el "
          },
          {
            "bbox": [
              56.692535400390625,
              561.4799194335938,
              445.07159423828125,
              571.43994140625
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "Kohen representa jesed, correspondiente a Abraham, la personificación de este "
          },
          {
            "bbox": [
              56.6925048828125,
              573.2999267578125,
              445.16455078125,
              583.43994140625
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "rasgo. Como se trató anteriormente, a través de esta revelación de jesed separamos "
          },
          {
            "bbox": [
              56.692535400390625,
              585.5899658203125,
              445.16455078125,
              595.43994140625
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "a Maljut de los Cuatro Reinos y le damos vida con la vida proveniente del Or "
          },
          {
            "bbox": [
              56.69256591796875,
              597.4590454101562,
              303.6217956542969,
              607.449951171875
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "HaPanim que brilla durante los Shalosh Regalim.[98]"
          }
        ]
      },

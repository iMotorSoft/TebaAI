              311.10797119140625
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "5 ■ EL OR HAPANIM Y EL BEIT HAMIKDASH"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          82.25810241699219,
          327.34796142578125,
          411.3501281738281,
          373.0279846191406
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              327.34796142578125,
              411.3501281738281,
              337.5479736328125
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Habiendo demostrado que el levantarse temprano para “despertar el shajar” "
          },
          {
            "bbox": [
              82.25814819335938,
              339.5079650878906,
              411.35009765625,
              349.0279846191406
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "efectúa una rectificación de la sabiduría inferior, el Rabí Natán explica ahora "
          },
          {
            "bbox": [
              82.25814819335938,
              351.2679748535156,
              411.35009765625,
              361.5479736328125
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "que el recitado del Tikún Jatzot le da fuerzas a Maljut/la sabiduría inferior "
          },
          {
            "bbox": [
              82.25813293457031,
              363.2679748535156,
              311.51611328125,
              373.0279846191406
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "con el Or HaPanim que brilla en el Beit HaMikdash. "
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.858123779296875,
          381.0169677734375,
          442.3251647949219,
          402.4269714355469
        ],
        "lines": [
          {
            "bbox": [
              82.25811767578125,
              381.0169677734375,
              442.3251647949219,
              388.906982421875
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Esta rectificación de la sabiduría inferior es característica del levantarse a "
          },
          {
            "bbox": [
              53.858123779296875,
              393.1969909667969,
              301.5180969238281,
              402.4269714355469
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "medianoche, como será demostrado a continuación."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          53.858123779296875,
          405.2669677734375,
          442.3301086425781,
          451.156982421875
        ],
        "lines": [
          {
            "bbox": [
              82.25812530517578,
              405.2669677734375,
              442.2422790527344,
              415.156982421875
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "Pues la persona debe fortalecerse, ejerciendo la mayor fuerza de voluntad, "
          },
          {
            "bbox": [
              53.858123779296875,
              417.0169677734375,
              442.3301086425781,
              427.156982421875
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "para levantarse a medianoche y lamentar grandemente la destrucción del Beit "
          },
          {
            "bbox": [
              53.858123779296875,
              427.21697998046875,
              442.3301086425781,
              439.156982421875
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "HaMikdash. Éste es el medio principal para elevar a Maljut desde la impureza de las "
          },
          {
            "bbox": [
              53.858123779296875,
              441.00634765625,
              432.4461364746094,
              451.156982421875
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "fuerzas externas y de las klipot, como es sabido a partir de las kavanot del Ari zal."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.85797119140625,
          455.84136962890625,
          442.33013916015625,
          561.991943359375
        ],
        "lines": [
          {
            "bbox": [
              82.25814819335938,
              455.84136962890625,
              442.3260498046875,
              466.0701904296875
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "Maljut asciende a través de esto debido a que, cuando uno lamenta la "
          },
          {
            "bbox": [
              53.85813903808594,
              467.85198974609375,
              442.33013916015625,
              477.2619934082031
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "destrucción del Beit HaMikdash, ello es considerado como si literalmente se "
          },
          {
            "bbox": [
              53.858154296875,
              479.84136962890625,
              442.2371826171875,
              489.99200439453125
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "hubiera dedicado a su reconstrucción. Jazal expresaron esto en su afirmación "
          },
          {
            "bbox": [
              53.858154296875,
              491.85198974609375,
              442.3299865722656,
              502.00201416015625
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "“Todo aquel que se lamenta [por Ierushalaim] merecerá ver su regocijo”.[40]Y "
          },
          {
            "bbox": [
              53.85797119140625,
              503.8519592285156,
              442.3299560546875,
              513.261962890625
            ],
            "ids": [
              [
                4,
                10
              ]
            ],
            "text": "a través de este lamentarse uno atrae sobre sí la santidad del Beit HaMikdash, "
          },
          {
            "bbox": [
              53.85797119140625,
              516.1319580078125,
              442.3241271972656,
              526.001953125
            ],
            "ids": [
              [
                4,
                11
              ]
            ],
            "text": "que es la fuente primaria del Or HaPanim que se hace descender durante los "
          },
          {
            "bbox": [
              53.85798645019531,
              527.8519287109375,
              442.3230895996094,
              538.001953125
            ],
            "ids": [
              [
                4,
                12
              ]
            ],
            "text": "Shalosh Regalim. Es por ello que se requiere que hagamos la peregrinación al "
          },
          {
            "bbox": [
              53.858001708984375,
              540.0319213867188,
              442.3289794921875,
              549.991943359375
            ],
            "ids": [
              [
                4,
                13
              ]
            ],
            "text": "Beit HaMikdash en las festividades para, tal cual está escrito en la Torá, “ver el "
          },
          {
            "bbox": [
              53.85797119140625,
              552.0110473632812,
              308.0908203125,
              561.991943359375
            ],
            "ids": [
              [
                4,
                14
              ]
            ],
            "text": "Panim de HaShem”[41]- para recibir el Or HaPanim.[42]"
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          53.85821533203125,
          566.9760131835938,
          442.3302001953125,
          600.8259887695312
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              566.9760131835938,
              442.3302001953125,
              576.8359985351562
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "Se sigue que el Or HaPanim se revela principalmente en el Beit HaMikdash. "
          },
          {
            "bbox": [
              53.85821533203125,
              578.9660034179688,
              442.31829833984375,
              588.8259887695312
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "Por lo tanto uno debe levantarse a medianoche y lamentar profundamente "
          },
          {
            "bbox": [
              53.85821533203125,
              590.6859741210938,
              442.32525634765625,
              600.8259887695312
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "su destrucción. Con esto merecerá, de acuerdo a su nivel espiritual, “ver su "
          }
        ]
      },

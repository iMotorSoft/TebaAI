              441.268310546875,
              624.9625854492188
            ],
            "ids": [
              [
                13,
                25
              ]
            ],
            "text": "deshacerse de su riqueza y así es mezquino al dar caridad y "
          },
          {
            "bbox": [
              252.6165771484375,
              627.1364135742188,
              441.2712097167969,
              633.9625854492188
            ],
            "ids": [
              [
                13,
                26
              ]
            ],
            "text": "tacaño con los extraños y con su familia. Una tercera forma, "
          },
          {
            "bbox": [
              252.6165771484375,
              636.1364135742188,
              441.2505187988281,
              642.9625854492188
            ],
            "ids": [
              [
                13,
                27
              ]
            ],
            "text": "mucho más sutil y difundida del taavat mamón es la persona "
          }
        ]
      }
    ]
  },

            "bbox": [
              53.8580322265625,
              439.03497314453125,
              442.2281494140625,
              448.9949645996094
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "introductorios, que típicamente preceden la presentación de cualquier material "
          },
          {
            "bbox": [
              53.8580322265625,
              451.03497314453125,
              442.3310241699219,
              460.9949645996094
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "complejo. Ello es comparable a los métodos pedagógicos empleados por el maestro "
          },

              ]
            ],
            "text": "����������������������������������������������������������������������������������������������������"
          },
          {
            "bbox": [
              417.653564453125,
              183.69581604003906,
              417.6658630371094,
              184.71670532226562
            ],
            "ids": [
              [
                17,
                0
              ]
            ],
            "text": "�"
          },
          {
            "bbox": [
              54.983154296875,
              183.49900817871094,
              442.7098388671875,
              195.6022186279297
            ],
            "ids": [
              [
                17,
                0
              ]
            ],
            "text": "����������������������������������������������������������������������������������������������������������"
          },
          {
            "bbox": [
              56.823211669921875,
              198.00440979003906,
              442.7074890136719,
              210.1076202392578
            ],
            "ids": [
              [
                17,
                1
              ]
            ],
            "text": "���������������������������������������������������������������������������������������������������������������������"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          209.875,
          227.76295471191406,
          289.0232238769531,
          235.82098388671875
        ],
        "lines": [
          {
            "bbox": [
              209.875,
              227.76295471191406,
              289.0232238769531,
              235.82098388671875
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "���������������������������Likutey Halajot Explicado"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.93499755859375,
          249.4089813232422,
          445.4109802246094,
          365.0389709472656
        ],
        "lines": [
          {
            "bbox": [
              56.93539810180664,
              249.4089813232422,
              445.3214111328125,
              259.2989807128906
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "les ha vuelto algo completamente permitido. Y para justificar su comportamiento "
          },
          {
            "bbox": [
              56.93540954589844,
              261.3179931640625,
              445.3160095214844,
              271.2989807128906
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "se basan en grandes autoridades,[66] en haber encontrado varios Tzadikim que se "
          },
          {
            "bbox": [
              56.93499755859375,
              273.448974609375,
              445.40704345703125,
              283.3089904785156
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "comportaban de esa manera. Sin embargo, esos eran Tzadikim que estaban muy "
          },
          {
            "bbox": [
              56.93499755859375,
              285.1589660644531,
              445.4070129394531,
              295.3089904785156
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "enfermos y así no tenían más opción que beber antes de orar. Esos rebeldes se "
          },
          {
            "bbox": [
              56.935028076171875,
              297.448974609375,
              445.4109802246094,
              307.3089904785156
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "equiparan, ellos mismos, a esos Tzadikim, como un mono a un hombre e imitan "
          },
          {
            "bbox": [
              56.93505859375,
              309.4089660644531,
              445.4071960449219,
              319.2989807128906
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "sus acciones - todo con la finalidad de justificar el hecho de llenar sus vientres "
          },
          {
            "bbox": [
              56.93504333496094,
              321.1589660644531,
              445.3970947265625,
              331.3089904785156
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "con café antes de la plegaria. E incluso hay algunos que también comen antes "
          },
          {
            "bbox": [
              56.93504333496094,
              333.1589660644531,
              445.4101257324219,
              343.2989807128906
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "de orar. ¡Ay de ellos! ¡Ay de sus almas! Pues ésta es una prohibición muy grave, "
          },
          {
            "bbox": [
              56.93504333496094,
              345.3179931640625,
              445.406982421875,
              355.2989807128906
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "como se explica en las enseñanzas de Jazal[67] y en especial en el santo Zohar y "
          },
          {
            "bbox": [
              56.935028076171875,
              357.3179931640625,
              180.13583374023438,
              365.0389709472656
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "otros textos kabalísticos.[68]"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.93536376953125,
          372.282958984375,
          445.4136047363281,
          466.2111511230469
        ],
        "lines": [
          {
            "bbox": [
              85.33540344238281,
              372.282958984375,
              445.40838623046875,
              382.1429748535156
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "De modo que no debemos compararnos con esos grandes Tzadikim, "
          },
          {
            "bbox": [
              56.93536376953125,
              383.9929504394531,
              445.3183898925781,
              394.1429748535156
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "quienes poseen un espíritu superior y diferente. Esto es especialmente así dado "
          },
          {
            "bbox": [
              56.93536376953125,
              396.1729736328125,
              445.3173522949219,
              406.1329650878906
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "que ellos sólo bebían antes de orar pues estaban muy enfermos y así se veían "
          },
          {
            "bbox": [
              56.935394287109375,
              407.9929504394531,
              445.4064025878906,
              418.1429748535156
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "compelidos a hacerlo. Más aún, no debemos permitirnos esto dado que la mayor "
          },
          {
            "bbox": [
              56.9354248046875,
              419.9929504394531,
              445.4073486328125,
              430.1329650878906
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "parte de los Tzadikim no lo hacen. Nuestro santo Rebe, el Rebe Najmán, contó "
          },
          {
            "bbox": [
              56.9354248046875,
              431.9929504394531,
              445.4136047363281,
              442.1429748535156
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "que él nunca bebió ni siquiera agua antes de la plegaria de la mañana. Aunque "
          },
          {
            "bbox": [
              56.9354248046875,
              443.9929504394531,
              445.4075012207031,
              454.1429748535156
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "de acuerdo a la ley del Shuljan Aruj está permitido beber agua, él ni siquiera lo "
          },
          {
            "bbox": [
              56.93544006347656,
              455.9289245605469,
              192.63084411621094,
              466.2111511230469
            ],
            "ids": [
              [
                6,
                7
              ]
            ],
            "text": "hizo antes de orar Shajarit.[69]"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.9354248046875,
          470.82794189453125,
          445.40740966796875,
          502.59796142578125
        ],
        "lines": [
          {
            "bbox": [
              85.33540344238281,
              470.82794189453125,
              445.3164978027344,
              480.97796630859375
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Volvamos a nuestro tema. En base a lo que se dijo más arriba sobre orar con "
          },
          {
            "bbox": [
              56.9354248046875,
              482.82794189453125,
              445.40740966796875,
              492.97796630859375
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "fervor y concentración, queda un poco más claro por qué uno tiene prohibido "
          },
          {
            "bbox": [
              56.9354248046875,
              495.1179504394531,
              195.45445251464844,
              502.59796142578125
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "comer o beber antes de orar."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.93499755859375,
          509.6429748535156,
          445.406982421875,
          579.56298828125
        ],
        "lines": [
          {
            "bbox": [
              85.3354263305664,
              509.6429748535156,
              445.3180236816406,
              519.81298828125
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "Se explica en la lección del Rebe[70]que el tikún de la emuná se logra "
          },
          {
            "bbox": [
              56.93499755859375,
              521.8429565429688,
              445.3180236816406,
              531.802978515625
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "elevando las chispas del habla y restaurándolas en la santidad. Uno merece lograr "
          },
          {
            "bbox": [
              56.93499755859375,
              533.8429565429688,
              445.406982421875,
              543.802978515625
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "esta elevación mediante el ayuno. Pues al dejarse llevar por el deseo de comida y "
          },
          {
            "bbox": [
              56.93499755859375,
              545.8429565429688,
              445.3132019042969,
              555.802978515625
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "bebida, las klipot se fortalecen. Esto es especialmente así con respecto a las fuerzas "
          },
          {
            "bbox": [
              56.93501281738281,
              557.6629638671875,
              445.31805419921875,
              565.552978515625
            ],
            "ids": [
              [
                7,
                7
              ]
            ],
            "text": "del mal encarnadas como los oficiales del faraón.[71] Ellos llevan a la facultad del "
          },
          {
            "bbox": [
              56.935028076171875,
              569.6430053710938,
              445.3180847167969,
              579.56298828125
            ],
            "ids": [
              [
                7,
                8
              ]
            ],
            "text": "habla hacia el exilio en Mitzraim - i.e., el ámbito de meitzar hagarón, la estrechez "
          }
        ]
      },

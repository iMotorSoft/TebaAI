              431.5469970703125,
              348.6730041503906
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "jesed, HaShem me "
          },
          {
            "bbox": [
              364.8190002441406,
              350.2409973144531,
              426.1869812011719,
              356.3370056152344
            ],
            "ids": [
              [
                12,
                3
              ]
            ],

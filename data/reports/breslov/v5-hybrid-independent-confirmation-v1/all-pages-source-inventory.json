                0
              ]
            ],
            "text": "Cronología de los Discursos"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.85730743408203,
          529.3369750976562,
          442.2373352050781,
          611.474365234375
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              529.3369750976562,
              442.23345947265625,
              539.2969970703125
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Con una o dos excepciones, no tenemos registro sobre cuándo el Rabí "
          },
          {
            "bbox": [
              53.858299255371094,
              541.3369750976562,
              442.2232666015625,
              551.2969970703125
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "Natán escribió sus discursos ni en qué orden. Dada la gran cantidad de material "
          },
          {
            "bbox": [
              53.858299255371094,
              553.1387329101562,
              442.23028564453125,
              563.474365234375
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "del Likutey Halajot sería un proyecto de investigación en sí mismo intentar "
          },
          {
            "bbox": [
              53.85730743408203,
              565.3369750976562,
              442.2373352050781,
              575.2969970703125
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "ubicar cronológicamente todos los discursos y relacionar su contenido con las "
          },
          {
            "bbox": [
              53.85730743408203,
              577.3369750976562,
              442.23138427734375,
              587.2969970703125
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "preocupaciones del Rabí Natán en diferentes etapas de su vida. Dentro del contexto "
          },
          {
            "bbox": [
              53.85730743408203,
              589.3369750976562,
              442.2274169921875,
              599.2969970703125
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "de este Apéndice ofrecemos simplemente un número de indicadores y sugerencias "
          },
          {
            "bbox": [
              53.85730743408203,
              601.1387329101562,
              255.5712890625,
              611.474365234375
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "sobre cómo llegó a la luz el Likutey Halajot."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.85729217529297,
          619.0059814453125,
          442.2383728027344,
          641.044189453125
        ],
        "lines": [
          {
            "bbox": [
              82.25729370117188,
              619.0059814453125,
              442.2332763671875,
              628.9660034179688
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Tal como se mencionó más arriba, el Rabí Natán tenía un programa de estudio "
          },
          {
            "bbox": [
              53.85729217529297,
              630.761962890625,
              442.2383728027344,
              641.044189453125
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "específico del Shuljan Aruj con la finalidad de escribir sus discursos. Al estudiar cada "
          }
        ]
      }
    ]
  },

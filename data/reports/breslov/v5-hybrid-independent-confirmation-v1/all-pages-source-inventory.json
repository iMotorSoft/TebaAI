            "bbox": [
              53.858245849609375,
              305.6630554199219,
              442.3302307128906,
              315.8030700683594
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "lugares, respecto a cuánto desciende el Tzadik para involucrarse con el mundo. "

              304.73895263671875,
              428.1669921875,
              315.00897216796875
            ],
            "ids": [
              [
                2,
                4
              ],
              [
                12,
                0
              ]
            ],
            "text": "debía ser refi nado y reconocido debido al mal que lo cubría y “Enmudecí con "
          },
          {
            "bbox": [
              53.85809326171875,
              317.1489562988281,
              427.72698974609375,
              326.99896240234375
            ],
            "ids": [
              [
                2,
                5
              ],
              [
                12,
                1
              ]
            ],

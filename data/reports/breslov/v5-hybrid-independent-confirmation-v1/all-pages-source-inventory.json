              53.858299255371094,
              638.2605590820312,
              242.50733947753906,
              645.0867309570312
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "Genera el deseo de una mayor cercanía con HaShem, incluso "
          }
        ]
      },

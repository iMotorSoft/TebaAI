              310.99798583984375,
              422.9369812011719,
              318.65399169921875
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "Su gloria”."
          },
          {
            "bbox": [
              386.9289855957031,
              321.0779724121094,
              419.3909912109375,
              327.65399169921875

              418.625,
              505.0150146484375
            ],
            "ids": [
              [
                17,
                2
              ]
            ],
            "text": "como el brillo "
          },
          {
            "bbox": [
              367.93701171875,
              508.53497314453125,
              428.84100341796875,
              516.1510009765625
            ],
            "ids": [
              [
                17,
                3
              ]
            ],
            "text": "del firmamento y "
          },
          {
            "bbox": [
              367.93701171875,
              517.9429931640625,
              444.0570373535156,
              525.7510375976562
            ],
            "ids": [
              [
                17,
                4
              ]
            ],
            "text": "aquellos que matzdik "
          },
          {
            "bbox": [
              367.93701171875,
              527.7349853515625,
              424.40899658203125,
              535.3510131835938
            ],
            "ids": [
              [
                17,
                5
              ]
            ],
            "text": "(que enseñan la "
          },
          {
            "bbox": [
              367.93701171875,
              537.3350219726562,
              433.30499267578125,
              544.9510498046875
            ],
            "ids": [

              252.88998413085938
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "2 ■ LEVANTÁNDOSE CON EMUNÁ"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          85.09259796142578,
          269.28997802734375,
          414.18756103515625,
          314.80999755859375
        ],
        "lines": [
          {
            "bbox": [
              85.09259796142578,
              269.28997802734375,
              414.177490234375,
              278.80999755859375
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "El Rabí Natán comienza su discurso sobre la ley de que la persona debe "
          },
          {
            "bbox": [
              85.09259796142578,
              281.28997802734375,
              414.18756103515625,
              290.80999755859375
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "tomar fuerzas para levantarse por la mañana y servir a HaShem conectándola "
          },
          {
            "bbox": [
              85.09259796142578,
              293.28997802734375,
              414.1865234375,
              302.80999755859375
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "con el fortalecer la emuná, en especial a través del estudio de la Torá en las "
          },
          {
            "bbox": [
              85.09261322021484,
              305.28997802734375,
              176.2325897216797,
              314.80999755859375
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "horas previas al alba."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.69261169433594,
          322.59765625,
          445.172607421875,
          404.9189758300781
        ],
        "lines": [
          {
            "bbox": [
              85.09261322021484,
              322.59765625,
              445.16461181640625,
              332.2590026855469
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Ahora bien, esta enseñanza relativa a fortalecer la emuná está relacionada "
          },
          {
            "bbox": [
              56.692626953125,
              334.7349548339844,
              445.16461181640625,
              345.0171813964844
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "directamente con la primera ley del Shuljan Aruj, “La persona debe fortalecerse "
          },
          {
            "bbox": [
              56.692626953125,
              346.7989807128906,
              445.172607421875,
              356.9490051269531
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "como un león para levantarse por la mañana… de modo que sea ella quien "
          },
          {
            "bbox": [
              56.692626953125,
              358.7349548339844,
              445.0745849609375,
              369.0171813964844
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "despierte el alba”. Despertar el shajar, levantándose antes del alba, “despierta” "
          },
          {
            "bbox": [
              56.69261169433594,
              370.59765625,
              442.20440673828125,
              381.1163330078125
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "o fortalece a la emuná. Pues la emuná se identifica con la sefirá de Maljut,[35]"
          },
          {
            "bbox": [
              56.692962646484375,
              382.9789733886719,
              445.0758361816406,
              392.948974609375
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "que es denominada shajar - como en el concepto kabalístico conocido como "
          },
          {
            "bbox": [
              56.692962646484375,
              394.9580078125,
              145.66343688964844,
              404.9189758300781
            ],
            "ids": [
              [
                8,
                6
              ]
            ],
            "text": "Aielet HaShajar.[36]"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.69288635253906,
          409.4326477050781,
          445.0778503417969,
          467.77398681640625
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              409.4326477050781,
              445.0760192871094,
              419.8521728515625
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "Más aún, la emuná y el alba, el shajar, están conceptualmente relacionados. "
          },
          {
            "bbox": [
              56.69288635253906,
              421.8139953613281,
              445.0778503417969,
              431.77398681640625
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "Pues la principal perfección de la fe tiene lugar por la mañana, tal cual está expresado "
          },
          {
            "bbox": [
              56.69288635253906,
              433.88397216796875,
              445.05279541015625,
              443.77398681640625
            ],
            "ids": [
              [
                9,
                2
              ]
            ],
            "text": "en “Nuevas son cada mañana, grande es tu fe”. Cada mañana se regenera el poder "
          },
          {
            "bbox": [
              56.69288635253906,
              445.4326477050781,
              445.0729064941406,
              455.093994140625
            ],
            "ids": [
              [
                9,
                3
              ]
            ],
            "text": "de la emuná. Esto está relacionado con la enseñanza del Zohar citada más arriba, "
          },
          {
            "bbox": [
              56.692901611328125,
              457.4326477050781,
              445.07391357421875,
              467.77398681640625
            ],
            "ids": [
              [
                9,
                4
              ]
            ],
            "text": "que la emuná es “la hermosa joven” que “emerge por la mañana” y es entonces "
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          226.17300415039062,
          482.34698486328125,
          274.14404296875,
          489.44598388671875
        ],
        "lines": [
          {
            "bbox": [

              399.58221435546875,
              442.3299560546875,
              409.77099609375
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "Mediante este birur de los puntos buenos, HaKadosh Baruj Hu y Su Shejiná "
          },
          {
            "bbox": [
              53.856964111328125,
              411.79010009765625,
              439.3702392578125,
              421.7709655761719
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "son llevados a un ijud[73]a través de un despertar desde abajo, elevando maim nukvin.[74]"
          }
        ]
      },
      {
        "index": 10,
        "class": "section-header",
        "bbox": [
          223.33799743652344,
          447.385986328125,
          271.30902099609375,
          454.4849853515625
        ],
        "lines": [
          {
            "bbox": [
              223.33799743652344,
              447.385986328125,
              271.30902099609375,
              454.4849853515625
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.858299255371094,
          468.66143798828125,
          242.52919006347656,
          646.4876098632812
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              468.66143798828125,
              242.49005126953125,
              475.48760986328125
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "72 Ver §1 y nota 9 más arriba. En Biur HaLikutim, Reb "
          },
          {
            "bbox": [
              53.858306884765625,
              477.66143798828125,
              242.51487731933594,
              484.47296142578125
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "Abraham Jazan explica que cuando el Tzadik revela los "
          },
          {
            "bbox": [
              53.858306884765625,
              486.66143798828125,
              242.49832153320312,
              493.47296142578125
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "puntos buenos de la persona, los pecados de esa persona son "
          },
          {
            "bbox": [
              53.858306884765625,
              495.66143798828125,
              242.50286865234375,
              502.48760986328125
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "perdonados. Es entonces como un pequeño escolar y puede "
          },
          {
            "bbox": [
              53.858306884765625,
              504.66143798828125,
              242.51409912109375,
              511.48760986328125
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "comenzar a estudiar Torá y a servir a HaShem nuevamente, con "
          },
          {
            "bbox": [
              53.858306884765625,
              513.6614379882812,
              242.5283660888672,
              520.4729614257812
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "la pureza del aliento incontaminado. En otra instancia, el Rebe "
          },
          {
            "bbox": [
              53.858306884765625,
              522.6577758789062,
              242.5141143798828,
              529.4876098632812
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "Najmán conecta el estudio puro de la Torá de los escolares "
          },
          {
            "bbox": [
              53.858306884765625,
              531.6614379882812,
              242.4953155517578,
              538.4729614257812
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "con los keruvim en el Mishkán (ver LM I, 37:4), que tenían "
          },
          {
            "bbox": [
              53.85906219482422,
              540.6614379882812,
              242.4983673095703,
              547.4729614257812
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "rostros de niños (ver Suká 5b). Así, el llamado de HaShem a "
          },
          {
            "bbox": [
              53.85980224609375,
              549.6614379882812,
              242.51329040527344,
              556.4876098632812
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "Moshé, “Vaikrá” (ver la nota 10 más arriba), emergía de entre "
          },
          {
            "bbox": [
              53.859806060791016,
              558.6614379882812,
              242.5081024169922,
              565.4729614257812
            ],
            "ids": [
              [
                4,
                10
              ]
            ],
            "text": "los keruvim del Mishkán - i.e., como la voz de la Torá, que está "
          },
          {
            "bbox": [
              53.85906219482422,
              567.6614379882812,
              242.50955200195312,
              574.4729614257812
            ],
            "ids": [
              [
                4,
                11
              ]
            ],
            "text": "intrínsecamente unida con la voz de los pequeños escolares "
          },
          {
            "bbox": [
              53.85906219482422,
              576.6614379882812,
              238.12881469726562,
              583.4729614257812
            ],
            "ids": [
              [
                4,
                12
              ]
            ],
            "text": "que la estudian (Biur HaLikutim sobre LM 1, 282, v.i. ve-da)."
          },
          {
            "bbox": [
              53.858306884765625,
              584.1864624023438,
              242.487060546875,
              592.4889526367188
            ],
            "ids": [
              [
                4,
                13
              ]
            ],
            "text": "73 En las enseñanzas kabalísticas, la unifi cación de HaKadosh "
          },
          {
            "bbox": [
              53.85832214355469,
              594.6614379882812,
              242.49232482910156,
              601.4876098632812
            ],
            "ids": [
              [
                4,
                14
              ]
            ],
            "text": "Baruj Hu, el aspecto masculino de HaShem, con la Shejiná, el "
          },
          {
            "bbox": [
              53.85906982421875,
              602.2881469726562,
              242.49459838867188,
              610.4876098632812
            ],
            "ids": [
              [
                4,
                15
              ]
            ],
            "text": "aspecto femenino, es conocida como ijud. Éste es el proceso "
          },
          {
            "bbox": [
              53.85908508300781,
              612.6614379882812,
              242.5186004638672,
              619.4876098632812
            ],
            "ids": [
              [
                4,
                16
              ]
            ],
            "text": "místico mediante el cual las devociones del hombre generan "
          },
          {
            "bbox": [
              53.85908508300781,
              621.6614379882812,
              242.52919006347656,
              626.9714965820312
            ],
            "ids": [
              [
                4,
                17
              ]
            ],
            "text": "la manifestación de la Divinidad en la creación. La antítesis de "
          },
          {
            "bbox": [
              53.85908508300781,
              629.1864624023438,
              242.51414489746094,
              637.4889526367188
            ],
            "ids": [
              [
                4,
                18
              ]
            ],
            "text": "esta unifi cación es el ocultamiento de la Divinidad producido "
          },
          {
            "bbox": [
              53.859832763671875,
              639.6614379882812,
              242.50738525390625,
              646.4876098632812
            ],
            "ids": [
              [
                4,
                19
              ]
            ],
            "text": "por los pecados de la humanidad que generan, si así pudiera "
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          252.6143035888672,
          468.65472412109375,
          441.27734375,
          556.4808959960938
        ],
        "lines": [
          {
            "bbox": [
              252.61582946777344,
              468.65472412109375,
              441.2653503417969,
              475.46624755859375
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "decirse, una separación entre los aspectos trascendentes e "
          },
          {
            "bbox": [
              252.61582946777344,
              476.17974853515625,
              441.26385498046875,
              484.48223876953125
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "inmanentes de la infl uencia Divina. Se dice entonces que la "
          },
          {
            "bbox": [
              252.61581420898438,
              486.65472412109375,
              441.2639465332031,
              493.48089599609375
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "Shejiná reside en la oscuridad del exilio. Sin embargo, las "
          },
          {
            "bbox": [
              252.61582946777344,
              495.65472412109375,
              441.26092529296875,
              502.48089599609375
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "plegarias y las mitzvot que llevamos a cabo en el servicio a "
          },
          {
            "bbox": [
              252.61582946777344,
              504.65472412109375,
              441.2690124511719,
              511.46624755859375
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "HaShem tienen el poder de deshacer el ocultamiento, de "
          },
          {
            "bbox": [
              252.61582946777344,
              512.2814331054688,
              441.25054931640625,
              520.4808959960938
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "terminar con el estado de exilio y de reinstalar el ijud. Ésta es la "
          },
          {
            "bbox": [
              252.6150665283203,
              522.6547241210938,
              441.27734375,
              529.4662475585938
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "base de la costumbre de recitar al disponerse a orar o al cumplir "
          },
          {
            "bbox": [
              252.6150665283203,
              530.1797485351562,
              441.2512512207031,
              538.4822387695312
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "con una mitzvá las palabras “En aras de la unifi cación de "
          },
          {
            "bbox": [
              252.6143035888672,
              540.6547241210938,
              441.2542724609375,
              547.4808959960938
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "HaKadosh Baruj Hu y Su Shejiná… He aquí, estoy preparado "
          },
          {
            "bbox": [
              252.61505126953125,
              549.6547241210938,
              380.932373046875,
              556.4808959960938
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "y dispuesto a cumplir con la mitzvá de…”."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          252.61502075195312,
          558.6547241210938,
          441.2727966308594,
          646.4808959960938
        ],
        "lines": [
          {
            "bbox": [
              252.61505126953125,
              558.6547241210938,
              441.2712707519531,
              565.4808959960938
            ],
            "ids": [
              [
                5,
                10
              ]
            ],
            "text": "74 La Kabalá habla de dos energías complementarias en el "
          },
          {
            "bbox": [
              252.61505126953125,
              567.6547241210938,
              441.25128173828125,
              574.4808959960938
            ],
            "ids": [
              [
                5,
                11
              ]
            ],
            "text": "universo, una fuerza descendente (main dujrin, lit. “aguas "
          },
          {
            "bbox": [
              252.6150665283203,
              576.6547241210938,
              441.2512512207031,
              583.4808959960938
            ],
            "ids": [
              [
                5,
                12
              ]
            ],
            "text": "masculinas”) y una fuerza ascendente (main nukvin, lit. “aguas "
          },
          {
            "bbox": [
              252.61505126953125,
              584.1797485351562,
              441.25048828125,
              592.4822387695312
            ],
            "ids": [
              [
                5,
                13
              ]
            ],
            "text": "femeninas”). (Ver LM I, 185, nota 12, para el signifi cado de "
          },
          {
            "bbox": [
              252.61502075195312,
              594.6547241210938,
              441.2727966308594,
              601.4808959960938
            ],
            "ids": [
              [
                5,
                14
              ]
            ],
            "text": "“aguas” en esta conexión). La energía espiritual que asciende "
          },
          {
            "bbox": [
              252.61502075195312,
              603.6510620117188,
              441.2482604980469,
              610.4808959960938
            ],
            "ids": [
              [
                5,
                15
              ]
            ],
            "text": "es la consecuencia de un despertar desde abajo (itaruta "
          },
          {
            "bbox": [
              252.61502075195312,
              612.6547241210938,
              441.2721252441406,
              619.4662475585938
            ],
            "ids": [
              [
                5,
                16
              ]
            ],
            "text": "delatata) - es decir, el cumplimiento por parte del hombre de "
          },
          {
            "bbox": [
              252.61502075195312,
              621.6547241210938,
              441.2699279785156,
              628.1110229492188
            ],
            "ids": [
              [
                5,
                17
              ]
            ],
            "text": "la Voluntad de HaShem en este mundo, a través del estudio de "
          },
          {
            "bbox": [
              252.61502075195312,
              630.6547241210938,
              441.2579345703125,
              637.4808959960938
            ],
            "ids": [
              [
                5,
                18
              ]
            ],
            "text": "la Torá, del cumplimiento de las mitzvot y de la plegaria (aquí, "
          },
          {
            "bbox": [
              252.61505126953125,
              639.6547241210938,
              441.2674865722656,
              646.4808959960938
            ],
            "ids": [
              [
                5,
                19
              ]
            ],
            "text": "el Kriat Shemá). Típicamente, este ascenso de energía evoca "
          }
        ]
      }
    ]
  },

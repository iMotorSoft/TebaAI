              444.1119079589844,
              582.782958984375
            ],
            "ids": [
              [
                15,
                0
              ]
            ],
            "text": "La nota 27 allí explica que, a diferencia del hombre, HaShem "
          },
          {
            "bbox": [
              255.44985961914062,
              584.971435546875,
              444.0985412597656,
              591.797607421875
            ],
            "ids": [
              [
                15,
                1
              ]
            ],
            "text": "y Su Voluntad son una y la misma cosa. Ni dualidad ni cambio "
          },
          {
            "bbox": [
              255.44985961914062,
              593.971435546875,
              444.0972900390625,
              600.782958984375
            ],
            "ids": [
              [
                15,
                2
              ]
            ],
            "text": "pueden ser adscriptos a Su Voluntad. Por lo tanto es imposible "

              482.34698486328125,
              274.14404296875,
              489.44598388671875
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          56.692901611328125,
          503.61444091796875,
          245.3524627685547,
          591.4406127929688
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              503.61444091796875,
              245.3509521484375,
              510.42596435546875
            ],
            "ids": [
              [
                15,
                0
              ]
            ],
            "text": "33 Las maravillas sobrenaturales que lleva a cabo el Tzadik "
          },
          {
            "bbox": [
              56.692901611328125,
              512.6144409179688,
              245.3449249267578,
              519.4406127929688
            ],
            "ids": [
              [
                15,
                1
              ]
            ],
            "text": "mediante sus plegarias prueban que el orden natural está "
          },
          {
            "bbox": [
              56.692901611328125,
              521.6107788085938,
              245.34420776367188,
              528.4406127929688
            ],
            "ids": [
              [
                15,
                2
              ]
            ],
            "text": "sujeto a una Voluntad Superior. La gente percibe que, en "
          },
          {
            "bbox": [
              56.692901611328125,
              530.6144409179688,
              245.3456573486328,
              537.4406127929688
            ],
            "ids": [
              [
                15,
                3
              ]
            ],
            "text": "respuesta a las plegarias dirigidas a HaShem por el Tzadik, "
          },
          {
            "bbox": [
              56.692901611328125,
              538.1394653320312,
              245.33218383789062,
              546.4419555664062
            ],
            "ids": [
              [
                15,
                4
              ]
            ],
            "text": "algunas constantes de la naturaleza se manifi estan de manera "
          },
          {
            "bbox": [
              56.69364929199219,
              548.6144409179688,
              245.34872436523438,
              555.4406127929688
            ],
            "ids": [
              [
                15,
                5
              ]
            ],
            "text": "inconstante y que algunas leyes de la física son contravenidas "
          },
          {
            "bbox": [
              56.69364929199219,
              557.6144409179688,
              245.35243225097656,
              564.4259643554688
            ],
            "ids": [
              [
                15,
                6
              ]
            ],
            "text": "inexplicablemente. A partir de esto deduce que HaShem existe "
          },
          {
            "bbox": [
              56.69364929199219,
              566.6144409179688,
              245.34115600585938,
              573.4406127929688
            ],
            "ids": [
              [
                15,
                7
              ]
            ],
            "text": "y que todo en la creación se conforma a Su voluntad. De otra "
          },
          {
            "bbox": [
              56.69364929199219,
              575.6144409179688,
              245.3524627685547,
              582.4406127929688
            ],
            "ids": [
              [
                15,
                8
              ]
            ],
            "text": "manera, las plegarias del Tzadik no tendrían efecto alguno en "
          },
          {
            "bbox": [
              56.69364929199219,
              584.6144409179688,
              159.15867614746094,
              591.4406127929688
            ],
            "ids": [
              [
                15,
                9
              ]
            ],
            "text": "cambiar las leyes de la naturaleza."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          56.69364929199219,
          593.6144409179688,
          245.3449249267578,
          607.9244995117188
        ],
        "lines": [
          {

              54.962154388427734
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "  LIKUTEY HALAJOT 229"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          85.09201049804688,
          70.7614517211914,
          416.5880126953125,
          205.62359619140625
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              70.7614517211914,
              416.5755310058594,
              80.22344970703125
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "más, expandiéndose hacia afuera y hacia los lados transformándose en "
          },
          {
            "bbox": [
              85.09290313720703,
              81.98036193847656,
              416.5849914550781,
              91.62347412109375
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "la segunda esfera dentro de la primera. Esta esfera es llamada el igul de "
          },
          {
            "bbox": [
              85.09292602539062,
              93.20014190673828,
              416.5766296386719,
              103.09868621826172
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "Jojmá. El kav continuó entonces descendiendo y expandiendo… hasta "
          },
          {
            "bbox": [
              85.09292602539062,
              104.96244049072266,
              416.567138671875,
              114.4244384765625
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "que se volvió la tercera esfera dentro de la segunda esfera.… El resto de las "
          },
          {
            "bbox": [
              85.09292602539062,
              116.15235900878906,
              416.5813903808594,
              125.9929428100586
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "sefirot también fueron formadas por el kav descendiendo hacia el centro "
          },
          {
            "bbox": [
              85.09295654296875,
              127.76248931884766,
              416.56707763671875,
              137.2244873046875
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "del Espacio Vacío, creando esferas hasta conformar la décima esfera, que "
          },
          {
            "bbox": [
              85.09295654296875,
              138.9813995361328,
              416.5880126953125,
              148.69879150390625
            ],
            "ids": [
              [
                2,
                6
              ]
            ],
            "text": "es llamada el igul de Maljut. Al avanzar hacia el centro, las esferas fueron "
          },
          {
            "bbox": [
              85.09201049804688,
              150.56155395507812,
              416.5661926269531,
              160.0235595703125
            ],
            "ids": [
              [
                2,
                7
              ]
            ],
            "text": "progresivamente más débiles o, lo que es esencialmente lo mismo, más "
          },
          {
            "bbox": [
              85.09201049804688,
              161.7804718017578,
              416.5794982910156,
              171.49786376953125
            ],
            "ids": [
              [
                2,
                8
              ]
            ],
            "text": "“densas” y más corpóreas. Finalmente, Maljut canalizó lo que quedaba de "
          },
          {
            "bbox": [
              85.09294128417969,
              173.1297607421875,
              416.58599853515625,
              182.97760009765625
            ],
            "ids": [
              [
                2,
                9
              ]
            ],
            "text": "la Luz del kav hacia el mismo centro del jalal hapanui, creando el mundo "
          },
          {
            "bbox": [
              85.09295654296875,
              184.55149841308594,
              416.58404541015625,
              194.39207458496094
            ],
            "ids": [
              [
                2,
                10
              ]
            ],
            "text": "material, en lo más alejado, por así decir, del Or Ein Sof, que lo rodea por "
          },
          {
            "bbox": [
              85.09292602539062,
              196.139892578125,
              219.4628143310547,
              205.62359619140625
            ],
            "ids": [
              [
                2,
                11
              ]
            ],
            "text": "todos lados (Etz Jaim, op. cit.)."
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          56.69288635253906,
          213.21392822265625,
          445.074951171875,
          281.0379638671875
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              213.21392822265625,
              445.074951171875,
              223.41796875
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "La relación entre el kav y el reshimu en el punto en que sus luces se unen puede "
          },
          {
            "bbox": [
              56.69288635253906,
              225.21392822265625,
              445.07391357421875,
              235.41796875
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "equipararse a la relación entre el alma y el cuerpo. La luz del reshimu funciona como "
          },
          {
            "bbox": [
              56.692901611328125,
              237.23681640625,
              444.41290283203125,
              247.59532165527344
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "un recipiente para captar la Luz del kav proveniente del Or Ein Sof. La Luz del kav "
          },
          {
            "bbox": [
              56.692901611328125,
              249.21392822265625,
              445.0749206542969,
              259.41796875
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "sirve como el alma, como la fuerza vital que sustenta el “cuerpo”, la luz del reshimu. "
          },
          {
            "bbox": [
              56.692962646484375,
              261.5679626464844,
              445.0690002441406,
              271.41796875
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "Todas las realidades independientes y creadas llegaron a la existencia debido a esta "
          },
          {
            "bbox": [
              56.692962646484375,
              273.4579772949219,
              87.85296630859375,
              281.0379638671875
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "unión."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          56.692962646484375,
          291.1269836425781,
          445.0849304199219,
          397.1651611328125
        ],
        "lines": [
          {
            "bbox": [
              85.09296417236328,
              291.1269836425781,
              445.0630187988281,
              301.08697509765625
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "El Midrash enseña que HaShem consideró inicialmente crear el mundo con "
          },
          {
            "bbox": [
              56.692962646484375,
              302.89056396484375,
              445.0849304199219,
              313.08697509765625
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "Su atributo de din, de juicio estricto, pero vio que de esa manera el mundo no podría "
          },
          {
            "bbox": [
              56.692962646484375,
              315.1041259765625,
              445.0740051269531,
              325.1651611328125
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "subsistir. Por lo tanto le dio prioridad a Su atributo de rajamim, de compasión, y lo "
          },
          {
            "bbox": [
              56.692962646484375,
              326.8829345703125,
              445.0670471191406,
              336.64697265625
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "unió con el din (Rashi sobre Bereshit 1:1). Una lectura kabalística de este Midrash "
          },
          {
            "bbox": [
              56.69297790527344,
              339.1269836425781,
              445.0560607910156,
              349.08697509765625
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "enseña que la intención inicial de HaShem fue crear el mundo solamente a partir "
          },
          {
            "bbox": [
              56.69297790527344,
              350.8829345703125,
              445.07696533203125,
              361.08697509765625
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "del reshimu, que se correlaciona con el aspecto del tzimtzum y del din. Pero vio que "
          },
          {
            "bbox": [
              56.6929931640625,
              362.8829345703125,
              444.3999328613281,
              373.2490539550781
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "la Creación no podría subsistir y así unió la luz del reshimu dentro del jalal hapanui "
          },
          {
            "bbox": [
              56.692962646484375,
              374.8829345703125,
              445.0750427246094,
              385.2490539550781
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "con la Luz del kav y, a través de ésta, con la Luz que rodea el jalal hapanui - es decir "
          },
          {
            "bbox": [
              56.692962646484375,
              387.1041259765625,
              383.968017578125,
              397.1651611328125
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "la Circundante Luz Infinita, que es en sí misma el rajamim primordial."
          }
        ]
      },
      {
        "index": 5,
        "class": "section-header",
        "bbox": [
          56.692901611328125,
          411.14398193359375,
          257.6933898925781,
          421.3499755859375
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              411.14398193359375,
              257.6933898925781,
              421.3499755859375
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "Adam Kadmón (el Hombre Primordial)"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.692901611328125,
          429.1748352050781,
          445.08099365234375,
          523.5333251953125
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              429.1748352050781,
              444.40386962890625,
              439.5333251953125
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Como la siguiente etapa en la Creación, el kav del Or Ein Sof penetra en el jalal "
          },
          {
            "bbox": [
              56.692901611328125,
              441.1519470214844,
              445.0600280761719,
              451.51806640625
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "hapanui de acuerdo al segundo de los dos modelos complementarios, en la forma "
          },
          {
            "bbox": [
              56.692901611328125,
              453.1519470214844,
              445.08099365234375,
              463.3559875488281
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "de iosher. En esta configuración lineal, las luces son emanadas en tres líneas, en "
          },
          {
            "bbox": [
              56.69290542602539,
              465.4659729003906,
              445.0630187988281,
              475.3559875488281
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "la forma de un ser humano, con cabeza, brazos, torso, muslos y pies. Las luces del "
          },
          {
            "bbox": [
              56.69290542602539,
              477.1519470214844,
              445.0758972167969,
              487.3559875488281
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "iosher, junto con las luces-igulim del reshimu, se combinan de manera paradójica "
          },
          {
            "bbox": [
              56.692901611328125,
              487.5959777832031,
              445.0789794921875,
              499.3559875488281
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "para transformarse en Adam Kadmón, el Hombre Primordial. Éste es el primer ser "
          },
          {
            "bbox": [
              56.692901611328125,
              501.1748352050781,
              445.0779113769531,
              511.5333251953125
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "que emerge luego del tzimtzum y el primer partzuf, persona Divina o configuración "
          },
          {
            "bbox": [
              56.692901611328125,
              513.1748046875,
              104.5564193725586,
              523.5333251953125
            ],
            "ids": [
              [
                6,
                7
              ]
            ],
            "text": "de sefirot.[4]"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.692779541015625,
          530.6846313476562,
          445.0747985839844,
          589.0260009765625
        ],
        "lines": [
          {
            "bbox": [
              85.0927963256836,
              530.6846313476562,
              445.0747985839844,
              541.203369140625
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Adam Kadmón es el medio a través del cual son emanadas todas las sefirot y "
          },
          {
            "bbox": [
              56.692779541015625,
              543.135986328125,
              445.0628356933594,
              553.0260009765625
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "todos los mundos. Su nombre alude a su papel como interfaz entre el Creador y lo "
          },
          {
            "bbox": [
              56.692779541015625,
              554.6846313476562,
              445.0738525390625,
              565.0260009765625
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "creado. Adam indica que es un ser creado; Kadmón que es Divinidad primordial. "
          },
          {
            "bbox": [
              56.69378662109375,
              566.6846313476562,
              445.0689697265625,
              577.0260009765625
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "Adam Kadmón es la primera manifestación de lo primero y la manifestación pura "
          },
          {
            "bbox": [
              56.69378662109375,
              578.6846313476562,
              445.0738525390625,
              589.0260009765625
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "y final de lo segundo. Adam Kadmón es considerado a veces el primer Mundo "
          }
        ]
      },
      {
        "index": 8,
        "class": "page-footer",
        "bbox": [
          226.17300415039062,
          607.8540649414062,
          274.14404296875,
          614.9519653320312
        ],
        "lines": [
          {
            "bbox": [
              226.17300415039062,
              607.8540649414062,
              274.14404296875,
              614.9519653320312
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 9,
        "class": "page-footer",
        "bbox": [
          56.692901611328125,
          639.845947265625,

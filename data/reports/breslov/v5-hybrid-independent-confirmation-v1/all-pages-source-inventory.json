              53.85820007324219,
              637.8584594726562,
              242.50045776367188,
              646.1609497070312
            ],
            "ids": [
              [
                10,
                2
              ]
            ],
            "text": "una falta de daat, de intelecto unifi cador y conciencia de "
          }

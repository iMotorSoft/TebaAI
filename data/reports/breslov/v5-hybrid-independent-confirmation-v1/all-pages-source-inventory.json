        "lines": [
          {
            "bbox": [
              85.09290313720703,
              620.9149169921875,
              444.9733581542969,
              630.9320068359375
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Esta nueva traducción y explicación del Likutey Halajot representa otra joya en la "
          },
          {
            "bbox": [
              56.693084716796875,
              634.1203002929688,
              445.0064392089844,
              644.1105346679688
            ],
            "ids": [

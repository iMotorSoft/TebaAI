              603.396484375,
              444.08612060546875,
              610.22265625
            ],
            "ids": [
              [
                12,
                31
              ]
            ],
            "text": "del Tanaj entre dos Nombres de HaShem colocados antes "
          },
          {
            "bbox": [
              255.448486328125,
              612.396484375,
              444.1034240722656,
              619.22265625
            ],
            "ids": [
              [
                12,
                32
              ]
            ],
            "text": "y después de cada término, el primero en Samuel 1, 2:3 y "
          },
          {
            "bbox": [
              255.448486328125,
              621.396484375,
              444.09503173828125,
              628.22265625
            ],
            "ids": [
              [
                12,
                33
              ]
            ],
            "text": "el segundo en Shemot 15:17. El Rabí Elazar agrega, “Para "
          },
          {
            "bbox": [
              255.44851684570312,
              630.396484375,
              444.0847473144531,
              637.22265625
            ],
            "ids": [
              [
                12,
                34
              ]
            ],
            "text": "alguien con daat, es como si el Beit HaMikdash ya hubiera "
          },
          {
            "bbox": [
              255.44927978515625,
              639.396484375,
              444.0861511230469,
              646.22265625
            ],
            "ids": [
              [
                12,

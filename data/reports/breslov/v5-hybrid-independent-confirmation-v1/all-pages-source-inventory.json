            "bbox": [
              57.15370178222656,
              614.9584350585938,
              245.7907257080078,
              621.7699584960938
            ],
            "ids": [
              [
                11,
                8
              ]
            ],
            "text": "en la emuná. Pero cuando los senderos están desbloqueados, "
          },
          {
            "bbox": [
              57.1536979675293,

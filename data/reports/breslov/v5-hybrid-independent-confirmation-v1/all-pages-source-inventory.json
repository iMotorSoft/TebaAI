              252.96299743652344,
              417.302978515625,
              260.6189880371094
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "“Si digo, ‘Mi pie "
          },
          {
            "bbox": [
              359.05499267578125,
              262.4989929199219,
              430.3909912109375,
              270.5950012207031
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "tropezará’, Tujesed, "
          },
          {
            "bbox": [
              359.05499267578125,
              272.1629943847656,
              405.72698974609375,
              279.4909973144531
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "HaShem, me "
          },
          {
            "bbox": [
              359.05499267578125,
              281.76300048828125,
              427.08697509765625,
              287.8590087890625
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "sustentará. Cuando "
          },
          {
            "bbox": [
              359.05499267578125,
              291.3630065917969,
              435.5269775390625,
              297.4430236816406
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "los temores dentro de "
          },
          {
            "bbox": [
              359.05499267578125,
              300.9630126953125,
              428.4229736328125,
              308.291015625
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "mí son abundantes, "
          },
          {
            "bbox": [
              359.05499267578125,
              310.5630187988281,
              437.7509765625,
              318.2190246582031
            ],
            "ids": [
              [
                12,
                6
              ]
            ],
            "text": "Tu consuelo alegra mi "
          },
          {
            "bbox": [
              359.05499267578125,
              320.16302490234375,
              381.718994140625,
              326.23504638671875
            ],
            "ids": [
              [
                12,
                7
              ]
            ],
            "text": "alma”."
          },
          {
            "bbox": [
              359.05499267578125,
              330.24298095703125,
              414.4700012207031,
              336.81903076171875
            ],
            "ids": [
              [
                12,
                8
              ]
            ],
            "text": "(Salmos 94:18-19)"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          54.31080627441406,
          342.887939453125,
          442.7868347167969,
          413.0279541015625
        ],
        "lines": [
          {
            "bbox": [
              82.71082305908203,
              342.887939453125,
              442.7809143066406,
              353.0279541015625
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "Y así el versículo siguiente agrega, “Cuando los temores dentro de mí "
          },
          {
            "bbox": [
              54.310821533203125,
              355.1779479980469,
              442.7808837890625,
              365.0279541015625
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "son abundantes, Tu consuelo alegra mi alma”. En otras palabras, cuando "
          },
          {
            "bbox": [
              54.310821533203125,
              367.16796875,
              442.7709045410156,
              377.0279541015625
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "los pensamientos incesantes me confunden y, debido a mis muchos daños, "
          },
          {
            "bbox": [
              54.310821533203125,
              379.137939453125,
              442.7868347167969,
              389.0279541015625
            ],
            "ids": [
              [
                1,
                10
              ]
            ],
            "text": "intentan hacerme caer, jas ve-shalom, entonces “Tu consuelo alegra mi alma”. "
          },
          {
            "bbox": [
              54.31080627441406,
              390.887939453125,
              442.7818298339844,
              401.0279541015625
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "Es decir, HaShem lo consuela ayudándolo a encontrar algún punto bueno en su "
          },
          {
            "bbox": [
              54.31080627441406,
              402.887939453125,
              412.84991455078125,
              413.0279541015625
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "interior. Ese punto bueno es su consuelo y con él se lleva hacia la alegría."
          }
        ]
      },

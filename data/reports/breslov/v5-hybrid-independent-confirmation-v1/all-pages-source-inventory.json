              441.26031494140625,
              628.2117309570312
            ],
            "ids": [
              [
                11,
                0
              ],
              [
                12,
                0
              ]
            ],
            "text": "37 Ver el pasaje del Saba deMishpatim citado en §1 más arriba.adicionales del Zohar sobre la importancia de levantarse a "
          },
          {
            "bbox": [
              53.858489990234375,
              630.3855590820312,
              357.3743591308594,
              637.2117309570312
            ],
            "ids": [
              [
                11,
                1
              ],
              [
                12,
                1
              ]
            ],
            "text": "38 Ver Zohar I, 77b y 92b; Zohar II, 46a. Ver también medianoche para servir a HaShem."
          },
          {
            "bbox": [
              53.858489990234375,
              639.3818969726562,
              242.49774169921875,
              646.2117309570312
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "Reshit Jojmá, Shaar HaKedushá 7, que cita muchos pasajes "
          }
        ]
      },

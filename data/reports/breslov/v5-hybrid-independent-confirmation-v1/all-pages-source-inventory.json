              645.797607421875
            ],
            "ids": [
              [
                14,
                7
              ]
            ],
            "text": "Baruj Hu se encuentra en una simple unidad con las mitzvot”. "
          }
        ]
      },
      {
        "index": 16,
        "class": "text",
        "bbox": [
          255.44985961914062,

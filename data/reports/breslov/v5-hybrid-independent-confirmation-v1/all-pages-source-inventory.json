            "bbox": [
              53.857940673828125,
              387.51300048828125,
              397.26800537109375,
              397.4369812011719
            ],
            "ids": [
              [
                1,
                12
              ],
              [
                10,
                3
              ]
            ],
            "text": "ocupa constantemente de esto para permitir que cada persona (Salmos 37:24)"
          },
          {
            "bbox": [
              53.85791015625,
              399.2969665527344,
              430.2080078125,
              412.3131103515625
            ],
            "ids": [
              [
                1,
                13
              ],
              [
                11,
                0
              ]
            ],
            "text": "despierte del sueño espiritual y de la caída, para que no se “El malvado asecha al "
          },
          {
            "bbox": [
              53.85791015625,
              411.58697509765625,
              240.28591918945312,
              421.4369812011719
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "hunda completamente, jas ve-shalom."
          }

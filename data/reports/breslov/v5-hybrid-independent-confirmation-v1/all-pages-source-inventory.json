              56.69361877441406,
              623.6854248046875,
              196.4539031982422,
              630.1417236328125
            ],
            "ids": [
              [
                13,
                13
              ]
            ],
            "text": "“entre” los kesilim, es decir los Cuatro Reinos."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          56.69361877441406,
          632.6854248046875,
          245.3426971435547,
          648.5115966796875
        ],
        "lines": [
          {
            "bbox": [
              56.69361877441406,
              632.6854248046875,
              245.3426971435547,
              639.5115966796875
            ],
            "ids": [
              [
                13,
                14
              ]
            ],
            "text": "19 Comentando sobre el versículo “Shmuel cortó a Agag”, "
          },
          {
            "bbox": [
              56.69361877441406,
              641.6854248046875,
              236.45216369628906,
              648.5115966796875
            ],
            "ids": [
              [
                13,
                15
              ]
            ],
            "text": "Rashi explica que Shmuel cortó en cuatro al rey de Amalek."
          }
        ]
      },
      {
        "index": 14,
        "class": "text",
        "bbox": [
          255.4488525390625,
          506.6854553222656,
          444.1095275878906,
          637.9954833984375
        ],
        "lines": [
          {
            "bbox": [
              255.44961547851562,
              506.6854553222656,
              444.1064758300781,
              513.4969482421875
            ],
            "ids": [
              [
                14,
                0
              ]
            ],
            "text": "20 La nación bíblica de Amalek no sólo fue la primera nación "
          },
          {
            "bbox": [
              255.44961547851562,
              515.6817626953125,
              444.1022033691406,
              522.5115966796875
            ],
            "ids": [
              [
                14,
                1
              ]
            ],
            "text": "en atacar al pueblo judío después de su partida de Egipto, sino "
          },
          {
            "bbox": [
              255.44961547851562,
              524.6854248046875,
              444.1080627441406,
              531.5115966796875
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "que continuó siendo históricamente el principal enemigo de "
          },
          {
            "bbox": [
              255.44961547851562,
              533.6854248046875,
              444.0998840332031,
              540.5115966796875
            ],
            "ids": [
              [
                14,
                3
              ]
            ],
            "text": "Israel. Notorio por su excepcional crueldad y negación de "
          },
          {
            "bbox": [
              255.44961547851562,
              542.6854248046875,
              444.1095275878906,
              549.5115966796875
            ],
            "ids": [
              [
                14,
                4
              ]
            ],
            "text": "HaShem, Amalek ha llegado a simbolizar la raíz irredimible "
          },
          {
            "bbox": [
              255.44961547851562,
              551.6854248046875,
              444.1057434082031,
              558.1417236328125
            ],
            "ids": [
              [
                14,
                5
              ]
            ],
            "text": "de todo el mal en el universo. En el contexto de la lección, "
          },
          {
            "bbox": [
              255.44961547851562,
              560.6854248046875,
              444.0960693359375,
              567.5115966796875
            ],
            "ids": [
              [
                14,
                6
              ]
            ],
            "text": "Amalek es representativo de los Cuatro Reinos, y Agag, el rey "
          },
          {
            "bbox": [
              255.44961547851562,
              568.21044921875,
              442.2242736816406,
              576.512939453125
            ],
            "ids": [
              [
                14,
                7
              ]
            ],
            "text": "amalekita, es la personifi cación de toda su impureza y maldad."
          },
          {
            "bbox": [
              255.4488525390625,
              578.6854248046875,
              444.1066589355469,
              585.4969482421875
            ],
            "ids": [
              [
                14,
                8
              ]
            ],
            "text": "21 En §7 de la lección del Rebe se enseña que debemos aceptar "
          },
          {
            "bbox": [
              255.4488525390625,
              587.6854248046875,
              444.10723876953125,
              594.4969482421875
            ],
            "ids": [
              [
                14,
                9
              ]
            ],
            "text": "la amonestación de los Tzadikim, aunque ocasionalmente "
          },
          {
            "bbox": [
              255.4488525390625,
              596.6854248046875,
              444.0960693359375,
              603.4969482421875
            ],
            "ids": [
              [
                14,
                10
              ]
            ],
            "text": "seamos humillados por ella. La sabiduría contenida en sus "
          },
          {
            "bbox": [
              255.4488525390625,
              605.6854248046875,
              444.0917663574219,
              612.5115966796875
            ],
            "ids": [
              [
                14,
                11
              ]
            ],
            "text": "palabras de amonestación revela jesed, como en “Ella abre "
          },
          {
            "bbox": [
              255.4488525390625,
              614.6854248046875,
              444.08502197265625,
              621.5115966796875
            ],
            "ids": [
              [
                14,
                12
              ]
            ],
            "text": "su boca con sabiduría y la Torá de jesed está en su lengua” "
          },
          {
            "bbox": [
              255.44961547851562,
              623.6854248046875,
              444.0931701660156,
              630.4969482421875
            ],
            "ids": [
              [
                14,
                13
              ]
            ],
            "text": "(Proverbios 31:26). El Rabí Natán expondrá sobre esto en §8 "
          },
          {
            "bbox": [
              255.44961547851562,
              632.6854248046875,
              296.27203369140625,
              637.9954833984375
            ],
            "ids": [
              [
                14,
                14
              ]
            ],
            "text": "más adelante."
          }
        ]
      }
    ]
  },

              445.1510009765625,
              346.94598388671875
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "que logre, más deberá elaborar con inteligencia nuevas y maravillosas "
          },
          {
            "bbox": [
              56.69293212890625,
              348.79595947265625,
              445.1671142578125,
              358.93597412109375
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "constricciones. Entonces será capaz de acercar más y más almas y curar incluso "
          },
          {
            "bbox": [
              56.69293212890625,
              360.79595947265625,
              311.8399658203125,
              370.93597412109375
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "a la peor gente y a los más enfermos espiritualmente."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.692901611328125,
          375.6309509277344,
          445.1680908203125,
          433.7709655761719
        ],
        "lines": [
          {
            "bbox": [
              85.09292602539062,
              375.6309509277344,
              445.1680908203125,
              385.7809753417969
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "Todo esto se relaciona con las velas de Jánuca que encendemos por "
          },
          {
            "bbox": [
              56.69292449951172,
              387.92095947265625,
              445.0629577636719,
              397.7709655761719
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "debajo de diez palmos desde el suelo, trayendo la gran luz de las percepciones de "
          },
          {
            "bbox": [
              56.69291687011719,
              399.92095947265625,
              445.0749206542969,
              409.7809753417969
            ],
            "ids": [
              [
                5,
                10
              ]
            ],
            "text": "Divinidad incluso a los espiritualmente bajos. Es por ello que la luz debe estar en "
          },
          {
            "bbox": [
              56.69293212890625,
              411.8809509277344,
              445.0729064941406,
              421.7709655761719
            ],
            "ids": [
              [
                5,
                11
              ]
            ],
            "text": "consonancia con la regla de Beit Hilel de “continuar aumentando” para agregar a "
          },
          {
            "bbox": [
              56.692901611328125,
              423.81097412109375,
              433.64886474609375,
              433.7709655761719
            ],
            "ids": [
              [
                5,
                12
              ]
            ],
            "text": "la luz espiritual en el mundo y así elevar más y más almas y acercarlas a HaShem."
          }
        ]
      },

            "bbox": [
              252.61497497558594,
              559.8829345703125,
              441.2496643066406,
              567.0789794921875
            ],
            "ids": [
              [
                9,
                18
              ]
            ],
            "text": "se relaciona con la palabra en arameo D'Leit ( ,)דליתcomo en "
          },
          {
            "bbox": [
              252.61495971679688,
              569.2674560546875,
              441.2474365234375,
              576.0936279296875
            ],
            "ids": [
              [
                9,
                19
              ]
            ],
            "text": "“aquello que no tiene luz propia”. La conexión de Maljut con "
          },
          {
            "bbox": [
              252.61570739746094,
              578.2674560546875,
              441.27935791015625,
              583.5775146484375
            ],
            "ids": [
              [
                9,
                20
              ]
            ],
            "text": "la dalet la relaciona también con el valor numérico de la letra "
          },
          {
            "bbox": [
              252.61569213867188,
              587.2674560546875,
              363.61932373046875,
              594.0936279296875
            ],
            "ids": [
              [

              441.43389892578125,
              433.51025390625,
              451.45098876953125
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "■Likutey Etzot (Consejo) - el consejo del Rebe Najmán sobre el servicio a Dios"
          },
          {
            "bbox": [
              82.25830078125,
              452.4759826660156,
              442.1378173828125,
              464.6529846191406
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "■Likutey Tefi lot (El Portal de la Plegaria) - plegarias originales basadas en las "
          },
          {
            "bbox": [
              82.25849914550781,
              467.83929443359375,
              226.98500061035156,
              477.85101318359375
            ],
            "ids": [
              [
                2,
                6
              ]
            ],
            "text": "lecciones del ■Likutey Moharán"
          }
        ]
      },
      {
        "index": 10,
        "class": "list-item",
        "bbox": [
          82.25761413574219,
          481.0392761230469,
          442.13482666015625,
          504.2509765625
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              481.0392761230469,
              442.13482666015625,
              491.0509948730469
            ],
            "ids": [
              [
                2,
                7
              ]
            ],
            "text": "■Likutey Halajot (Colección de Discursos) - ideas originales sobre las leyes del "
          },
          {
            "bbox": [
              82.25761413574219,
              494.2392578125,
              137.98251342773438,
              504.2509765625
            ],
            "ids": [
              [

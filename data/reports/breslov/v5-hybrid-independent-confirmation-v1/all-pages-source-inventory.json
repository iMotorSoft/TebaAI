          },
          {
            "bbox": [
              252.61322021484375,
              512.971435546875,
              441.2628173828125,
              519.782958984375
            ],
            "ids": [
              [
                9,
                13
              ]
            ],
            "text": "klipot que no pueden entonces impedir que las palabras de "

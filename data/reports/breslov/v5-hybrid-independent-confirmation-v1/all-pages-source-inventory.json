              256.2687683105469,
              607.7972412109375,
              444.9258117675781,
              614.6087646484375
            ],
            "ids": [
              [
                12,
                7
              ]
            ],
            "text": "explica que hace referencia a Abraham. HaShem le prometió "
          },
          {
            "bbox": [
              256.2687683105469,
              616.7972412109375,
              444.9063720703125,
              623.6087646484375
            ],
            "ids": [
              [
                12,
                8
              ]
            ],
            "text": "a Abraham que la kehuna (el sacerdocio) provendría de sus "
          },
          {
            "bbox": [
              256.2687683105469,
              625.7972412109375,
              444.9174499511719,
              632.6234130859375
            ],
            "ids": [
              [
                12,
                9
              ]
            ],
            "text": "descendientes. Ver §5 y nota 31 más arriba, que conecta a "
          },
          {
            "bbox": [
              256.2687683105469,
              634.7972412109375,
              440.3890686035156,
              641.6234130859375
            ],
            "ids": [
              [
                12,
                10
              ]
            ],
            "text": "Abraham con jesed, la cualidad relacionada con los kohanim."
          }
        ]
      }

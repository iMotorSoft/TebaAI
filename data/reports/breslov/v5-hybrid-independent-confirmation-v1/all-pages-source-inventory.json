              611.3402099609375
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "luz que está oculta de los malvados, pero también para enseñar "
          },
          {
            "bbox": [
              255.44964599609375,
              613.5286865234375,
              444.107421875,
              620.3402099609375
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "que chispas de la luz de la Creación se revelan en las luces "
          },
          {
            "bbox": [
              255.44964599609375,
              622.5286865234375,
              444.0828552246094,
              629.3548583984375
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "de Jánuca (ver Rokeaj, Hiljot Jánuca; también Bnei Isajar, "
          },
          {
            "bbox": [
              255.44961547851562,

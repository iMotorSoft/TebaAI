              441.24755859375,
              591.464599609375
            ],
            "ids": [
              [
                14,
                0
              ]
            ],
            "text": "y espera esto último encontrará fortalecida su emuná en iesh "
          },
          {
            "bbox": [
              252.6150665283203,
              593.638427734375,
              441.2728271484375,
              600.464599609375
            ],
            "ids": [
              [
                14,
                1
              ]
            ],
            "text": "mi-ain, dado que el crear algo a partir de la nada es en sí mismo "
          },
          {
            "bbox": [
              252.61508178710938,
              602.638427734375,
              362.1749572753906,
              607.948486328125
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "una forma de dar vida a los muertos."
          }
        ]
      },

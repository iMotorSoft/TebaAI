              347.4359436035156,
              409.1409912109375,
              357.5759582519531
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "pedimos: “Dios mío, abre mis labios [que mi boca declarará Tu alabanza]”."
          }

            "ids": [
              [
                15,
                2
              ]
            ],
            "text": "81 El “buen aceite” alude a los mojín (ver la nota anterior). "
          },
          {
            "bbox": [
              255.45040893554688,
              586.3707275390625,
              444.08740234375,
              593.1822509765625
            ],
            "ids": [
              [
                15,
                3
              ]
            ],
            "text": "Al equiparar el cuerpo humano con el Mishkán, la Kabalá "
          },
          {
            "bbox": [
              255.4496612548828,
              595.3707275390625,
              444.08062744140625,
              602.1968994140625
            ],
            "ids": [
              [
                15,
                4
              ]
            ],
            "text": "asocia la cabeza con la menorá de siete brazos (Tikuney Zohar, "
          },
          {
            "bbox": [
              255.44961547851562,
              604.3707275390625,
              444.1049499511719,
              611.1822509765625
            ],
            "ids": [
              [
                15,
                5
              ]
            ],
            "text": "Introducción, p. 13b). Las siete aberturas de la cabeza son las "
          },
          {
            "bbox": [
              255.44961547851562,
              611.895751953125,
              444.0828857421875,
              620.1982421875
            ],
            "ids": [
              [
                15,
                6
              ]
            ],
            "text": "siete lámparas, que al ser santifi cadas iluminan el panim de la "
          },
          {
            "bbox": [
              255.44961547851562,
              622.3707275390625,
              444.1011047363281,
              629.1968994140625
            ],
            "ids": [
              [
                15,
                7
              ]
            ],
            "text": "menorá (ver LM I, 21:2 y las notas 18:19 allí). Esto es como en "
          },
          {
            "bbox": [
              255.4496307373047,
              631.3707275390625,
              442.2146301269531,
              638.1822509765625
            ],
            "ids": [
              [
                15,
                8
              ]
            ],
            "text": "“La sabiduría de la persona ilumina su panim” (Eclesiastés 8:1)."
          }
        ]
      }

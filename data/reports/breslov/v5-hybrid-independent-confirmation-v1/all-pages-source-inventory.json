          286.188232421875,
          176.84796142578125
        ],
        "lines": [
          {
            "bbox": [
              207.0399932861328,
              168.7900848388672,
              286.188232421875,
              176.84796142578125
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "���������������������������Likutey Halajot Explicado"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.85809326171875,
          190.3469696044922,
          442.32403564453125,
          260.2369689941406
        ],
        "lines": [
          {
            "bbox": [
              53.85810089111328,
              190.3469696044922,
              442.32403564453125,
              200.23696899414062
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "entre las “naciones”, es decir, entre los malos deseos y los daños espirituales "
          },
          {
            "bbox": [
              53.85809326171875,
              202.2560272216797,
              441.04302978515625,
              212.23696899414062
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "representativos de las naciones del mundo, como se explica en otra instancia.[51 ]"
          },
          {
            "bbox": [
              53.85810089111328,
              214.0969696044922,
              442.24017333984375,
              224.23696899414062
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "HaShem anhela oír la “voz” de los puntos buenos, como en Sus palabras dirigidas "
          },
          {
            "bbox": [
              53.858154296875,
              226.27696228027344,
              442.3230285644531,
              236.24696350097656
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "al pueblo judío, “los compañeros oyen tu voz. Permite que Yo la oiga”. Pues "
          },
          {
            "bbox": [
              53.85816192626953,
              238.0969696044922,
              442.3141784667969,
              248.24696350097656
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "HaShem anhela que se revelen los puntos buenos y que ellos hagan oír sus "
          },
          {
            "bbox": [
              53.85816192626953,
              248.29696655273438,
              255.65884399414062,
              260.2369689941406
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "voces en canciones de alabanza para Él.[52]"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.857940673828125,
          264.9319763183594,
          442.33013916015625,
          383.0719909667969
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              264.9319763183594,
              442.33013916015625,
              275.0820007324219
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Esto se relaciona también con los korbanot - con el hecho de que elevamos "
          },
          {
            "bbox": [
              53.85810852050781,
              276.9319763183594,
              442.2412109375,
              287.0719909667969
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "los puntos buenos hacia la dimensión del medaber y los revelamos a través de "
          },
          {
            "bbox": [
              53.85809326171875,
              289.1819763183594,
              442.3300476074219,
              299.0820007324219
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "las palabras de nuestras plegarias. Es por esto que enseñan Jazal, “Todo aquel "
          },
          {
            "bbox": [
              53.858062744140625,
              301.21197509765625,
              442.2431640625,
              311.0820007324219
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "que se ocupa con las leyes de la ofrenda quemada” -o de cualquiera de los otros "
          },
          {
            "bbox": [
              53.85807800292969,
              312.8832092285156,
              442.3299560546875,
              323.0719909667969
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "korbanot,[53] recitando los pasajes que dan expresión a sus leyes- “se le acredita como "
          },
          {
            "bbox": [
              53.85797119140625,
              325.11199951171875,
              442.2310485839844,
              335.0719909667969
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "si hubiese presentado esa ofrenda”. Esto no lo encontramos en ningún otro lugar "
          },
          {
            "bbox": [
              53.85798645019531,
              337.11199951171875,
              442.3299865722656,
              347.0719909667969
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "con respecto a ninguna otra mitzvá. Se aplica sólo a las ofrendas sacrificiales, dado "
          },
          {
            "bbox": [
              53.85797119140625,
              348.9119873046875,
              442.2359924316406,
              359.0820007324219
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "que el tikún que generamos al presentar un korbán -elevando las chispas de "
          },
          {
            "bbox": [
              53.857940673828125,
              360.8755798339844,
              442.3270263671875,
              371.0719909667969
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "santidad desde el nivel de lo animal hacia el medaber- es principalmente a través "
          },
          {
            "bbox": [
              53.85797119140625,
              373.22198486328125,
              270.5279235839844,
              383.0719909667969
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "del dibur, de la palabra hablada en la plegaria."
          }
        ]
      },
      {
        "index": 8,
        "class": "section-header",
        "bbox": [
          53.858970642089844,
          397.5419921875,
          286.5478820800781,
          409.47198486328125
        ],
        "lines": [
          {
            "bbox": [
              53.858970642089844,
              397.5419921875,
              286.5478820800781,
              409.47198486328125
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "8 ■ PUNTOS BUENOS, OFRENDAS y MELODÍAS"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          82.25789642333984,
          416.9209899902344,
          411.35888671875,
          486.7309875488281
        ],
        "lines": [
          {
            "bbox": [
              82.25789642333984,
              416.9209899902344,
              411.3299255371094,
              426.6809997558594
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "El Rabí Natán cita a continuación el relato que hacen Jazal sobre el korbán "
          },
          {
            "bbox": [
              82.25790405273438,
              428.9209899902344,
              411.34893798828125,
              438.6809997558594
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "tamid, la ofrenda diaria comunal, presentado en el Beit HaMikdash. En ello "
          },
          {
            "bbox": [
              82.25790405273438,
              441.1609802246094,
              411.35784912109375,
              450.6809997558594
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "participaban representantes de las tres ramas del pueblo judío: los Kohanim, "
          },
          {
            "bbox": [
              82.25790405273438,
              453.1609802246094,
              411.35888671875,
              462.6809997558594
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "los Leviim y los Israelim. El Rabí Natán explicará cómo esto se equipara con "
          },
          {
            "bbox": [
              82.25790405273438,
              465.1609802246094,
              411.3487854003906,
              474.6809997558594
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "el birur de los puntos buenos, creando melodías y elevando el punto bueno "
          },
          {
            "bbox": [
              82.25790405273438,
              477.08099365234375,
              236.78689575195312,
              486.7309875488281
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "en la forma del dibur de la plegaria."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          53.857879638671875,
          494.8500061035156,
          442.3309020996094,
          552.8099975585938
        ],
        "lines": [
          {
            "bbox": [
              82.25790405273438,
              494.8500061035156,
              442.2310791015625,
              504.80999755859375
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Ahora bien, este refinar de los puntos buenos liberándolos de los deseos "
          },
          {
            "bbox": [
              53.85791015625,
              506.54998779296875,
              442.3309020996094,
              516.8099975585938
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "animales encuentra expresión en la afi rmación de Jazal: “[Allí había] Kohanim "
          },
          {
            "bbox": [
              53.85791015625,
              518.9199829101562,
              442.33087158203125,
              528.8099975585938
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "con su servicio sacrificial, presentando la ofrenda; Leviim en su plataforma, "
          },
          {
            "bbox": [
              53.85791015625,
              530.9600219726562,
              442.3309020996094,
              540.8099975585938
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "cantando y ejecutando instrumentos musicales; y el grupo establecido de Israelim, "
          },
          {
            "bbox": [
              53.857879638671875,
              542.6135864257812,
              420.0338134765625,
              552.8099975585938
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "la delegación del maamad, de pie en su lugar y recitando pasajes de la Torá”.[54]"
          }
        ]
      },
      {
        "index": 11,
        "class": "section-header",
        "bbox": [
          223.33799743652344,
          568.4049682617188,
          271.30902099609375,
          575.5029907226562
        ],
        "lines": [
          {

              293.63299560546875,
              274.1430358886719,
              300.73199462890625
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.69289779663086,
          314.2134704589844,
          245.36065673828125,
          456.0396423339844
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              314.2134704589844,
              245.34796142578125,
              321.0249938964844
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "17 Como se mencionó en la nota 15 más arriba, la profecía "
          },
          {
            "bbox": [
              56.692901611328125,
              323.2134704589844,
              245.34796142578125,
              330.0249938964844
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "se comprende aquí en el sentido más amplio de conciencia de "
          },
          {
            "bbox": [
              56.692901611328125,
              332.2134704589844,
              245.32916259765625,
              339.0396423339844
            ],

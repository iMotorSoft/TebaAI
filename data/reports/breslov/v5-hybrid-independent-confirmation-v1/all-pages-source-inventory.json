              477.60894775390625,
              437.7129821777344,
              485.2249450683594
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "“Todo aquel que vaya "
          },
          {
            "bbox": [
              359.4570007324219,
              487.208984375,
              441.7049865722656,
              494.5369873046875
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "hacia ella no retornará; "
          },
          {
            "bbox": [
              359.4570007324219,
              496.8089599609375,
              422.5929870605469,
              502.88897705078125
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "no alcanzarán los "
          },
          {
            "bbox": [
              359.4570007324219,
              506.40899658203125,
              431.4809875488281,
              512.489013671875
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "senderos de la vida”."
          },
          {
            "bbox": [
              359.4570007324219,
              516.4889526367188,
              411.37200927734375,
              523.0650024414062
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "(Proverbios 2:19)"
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          53.858001708984375,
          529.6939697265625,
          442.3310241699219,
          563.583984375
        ],
        "lines": [
          {

              351.6219787597656,
              237.57595825195312
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "Y entonces, después de recitar el Shemá, comenzamos "
          },
          {
            "bbox": [
              53.80400085449219,
              239.7259521484375,
              351.62200927734375,
              249.57595825195312
            ],
            "ids": [
              [
                1,
                3
              ]
            ],

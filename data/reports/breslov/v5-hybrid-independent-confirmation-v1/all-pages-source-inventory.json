              426.6809997558594,
              497.3360900878906
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "“¿Quién es el Rey de "
          },
          {
            "bbox": [
              352.4410095214844,
              499.2560729980469,
              431.1210021972656,
              506.93609619140625
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "gloria? ¡HaShem, Que "
          },
          {
            "bbox": [
              352.4410095214844,
              508.8560791015625,
              426.6889953613281,
              516.4721069335938
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "es fuerte y poderoso! "
          },
          {
            "bbox": [
              352.4410095214844,
              518.4560546875,
              422.2330017089844,
              526.1360473632812
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "¡HaShem, Quien es "
          },
          {
            "bbox": [
              352.4410095214844,
              528.0560913085938,
              437.3609924316406,
              535.672119140625
            ],

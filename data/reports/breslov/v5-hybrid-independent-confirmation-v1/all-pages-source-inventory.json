              405.25299072265625,
              439.573974609375,
              415.39300537109375
            ],
            "ids": [
              [
                5,
                11
              ],
              [
                15,
                2
              ]
            ],
            "text": "encender la luz de Jánuca. Esta luz corresponde al Or HaPanim, sustenta el corazón "
          },
          {
            "bbox": [

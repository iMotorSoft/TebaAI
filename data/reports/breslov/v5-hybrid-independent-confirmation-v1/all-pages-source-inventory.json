                0
              ]
            ],
            "text": "82 Ver §1 de la lección del Rebe; también §1 y notas 29 y 30 "
          },
          {
            "bbox": [
              56.692901611328125,
              587.2605590820312,
              90.0154037475586,
              592.5706176757812
            ],
            "ids": [
              [
                15,
                1
              ]
            ],
            "text": "más arriba."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          56.692901611328125,
          596.2605590820312,
          245.35093688964844,
          648.0867309570312
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              596.2605590820312,
              245.3419647216797,
              603.0720825195312
            ],
            "ids": [
              [
                15,
                2
              ]
            ],
            "text": "83 El punto de vista del Rabí Natán del universo presupone el "
          },
          {
            "bbox": [
              56.692901611328125,
              605.2605590820312,
              245.34640502929688,
              612.0867309570312
            ],
            "ids": [
              [
                15,
                3
              ]
            ],
            "text": "modelo geocéntrico y así los cuerpos celestes referidos aquí "
          },
          {
            "bbox": [
              56.692901611328125,
              614.2605590820312,
              245.35020446777344,
              621.0867309570312
            ],
            "ids": [
              [
                15,
                4
              ]
            ],
            "text": "son el sol, la luna, los planetas y las estrellas, que completan "
          },
          {
            "bbox": [
              56.692901611328125,
              623.2605590820312,
              245.35093688964844,
              628.5706176757812
            ],
            "ids": [
              [
                15,
                5
              ]
            ],
            "text": "su revolución anual alrededor de la tierra. Este ciclo anual "
          },
          {
            "bbox": [
              56.692901611328125,
              630.7855834960938,
              245.3367156982422,
              639.0880737304688
            ],
            "ids": [
              [
                15,
                6
              ]
            ],
            "text": "está referido en Shemot 34:22, que afi rma que la festividad de "
          },
          {
            "bbox": [
              56.692901611328125,
              641.2605590820312,
              245.3359375,
              648.0867309570312
            ],
            "ids": [
              [
                15,
                7
              ]
            ],
            "text": "Sukot tiene lugar en tekufat ha-shaná, en el el ciclo del año. "
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          255.44891357421875,
          578.2605590820312,
          444.0946960449219,
          594.0867309570312
        ],
        "lines": [
          {
            "bbox": [
              255.44891357421875,
              576.7855834960938,
              444.0946960449219,
              585.0880737304688
            ],
            "ids": [
              [
                16,
                0
              ]
            ],
            "text": "Rashi explica que esto signifi ca en el “retorno” del año, el "
          },
          {
            "bbox": [
              255.44891357421875,
              587.2605590820312,
              384.5911865234375,
              594.0867309570312
            ],
            "ids": [
              [
                16,
                1
              ]
            ],
            "text": "punto en el cual comienza el año siguiente."
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          255.4488983154297,
          596.2605590820312,
          444.1065979003906,
          648.0867309570312
        ],
        "lines": [
          {
            "bbox": [
              255.44891357421875,
              596.2605590820312,
              444.08209228515625,
              603.0867309570312
            ],
            "ids": [
              [
                16,
                2
              ]
            ],
            "text": "84 El término “tekufot ha-iamim”, los ciclos de los días, "
          },
          {
            "bbox": [
              255.44891357421875,
              605.2605590820312,
              444.09686279296875,
              612.0720825195312
            ],
            "ids": [
              [
                16,
                3
              ]
            ],
            "text": "se encuentra en Samuel 1, 1:20 (aunque en un contexto "
          },
          {
            "bbox": [
              255.44891357421875,
              614.2605590820312,
              444.10382080078125,
              621.0720825195312
            ],
            "ids": [
              [
                16,
                4
              ]
            ],
            "text": "diferente); ver también LM II, 7:6. Está dicho en Salmos 19:7 "
          },
          {
            "bbox": [
              255.44891357421875,
              623.2605590820312,
              444.101318359375,
              630.0867309570312
            ],
            "ids": [
              [
                16,
                5
              ]
            ],
            "text": "con respecto al movimiento diario del sol, “Su origen está "
          },
          {
            "bbox": [
              255.44891357421875,
              632.2605590820312,
              444.0865478515625,
              639.0867309570312
            ],
            "ids": [
              [
                16,
                6
              ]
            ],
            "text": "en un extremo de los cielos y tekufató (su ciclo, su circuito) "
          },
          {
            "bbox": [
              255.4488983154297,
              641.2605590820312,
              444.1065979003906,
              648.0867309570312
            ],
            "ids": [
              [
                16,
                7
              ]
            ],
            "text": "lo lleva al extremo [opuesto]”. A lo largo de cada día, como "
          }
        ]
      }
    ]

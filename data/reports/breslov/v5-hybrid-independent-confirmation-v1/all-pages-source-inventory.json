            "bbox": [
              53.857513427734375,
              566.1424560546875,
              242.49755859375,
              572.9539794921875
            ],
            "ids": [
              [
                10,
                27
              ]
            ],
            "text": "del Rebe que sus enseñanzas con respecto a los prosélitos se "
          },
          {
            "bbox": [
              53.857513427734375,
              575.1424560546875,
              176.31900024414062,
              581.9686279296875
            ],
            "ids": [
              [
                10,
                28
              ]
            ],
            "text": "aplican igualmente a los baalei teshuvá)."

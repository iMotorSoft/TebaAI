              242.51316833496094,
              594.3919677734375
            ],
            "ids": [
              [
                5,
                15
              ]
            ],
            "text": "53 Un pidion, una redención, hace referencia a dinero o a "
          },
          {
            "bbox": [
              53.85963439941406,
              596.5767822265625,
              242.4921417236328,
              603.4066162109375
            ],
            "ids": [
              [
                5,
                16
              ]
            ],
            "text": "un objeto dado a un Tzadik para que efectúe un tikún y una "
          },
          {
            "bbox": [
              53.85963439941406,
              605.5804443359375,
              242.51242065429688,
              612.4066162109375
            ],
            "ids": [
              [
                5,
                17
              ]
            ],
            "text": "salvación en aras del dador. Es una antigua costumbre el que "
          },
          {
            "bbox": [
              53.85963439941406,
              613.10546875,
              242.49969482421875,
              621.407958984375
            ],
            "ids": [
              [
                5,
                18
              ]
            ],
            "text": "el judío que experimente algún infortunio o difi cultad le de "
          },
          {
            "bbox": [
              53.86039733886719,
              623.5804443359375,
              242.49290466308594,
              630.4066162109375
            ],
            "ids": [
              [
                5,
                19
              ]
            ],
            "text": "tzedaka a un Tzadik y le pida que ore por él. El pidion sirve "
          },
          {
            "bbox": [
              53.86116027832031,
              632.5804443359375,
              242.523681640625,
              639.4066162109375
            ],
            "ids": [
              [
                5,
                20
              ]
            ],
            "text": "como catalizador a través del cual se mitigan para la persona "
          },
          {
            "bbox": [
              53.86116027832031,
              641.5804443359375,
              153.8496856689453,
              646.9014892578125
            ],
            "ids": [
              [
                5,
                21
              ]
            ],
            "text": "los dinim de un decreto Celestial."
          }
        ]
      },

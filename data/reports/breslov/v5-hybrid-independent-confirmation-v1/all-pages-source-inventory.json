            "bbox": [
              53.858299255371094,
              623.2568969726562,
              242.50587463378906,
              630.0867309570312
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "por cada judío individual. Por lo tanto uno nunca debe perder "
          },
          {
            "bbox": [
              53.858299255371094,
              632.2605590820312,
              242.50888061523438,
              639.0867309570312
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "la esperanza de la ayuda de HaShem, no importa el daño que "
          },
          {
            "bbox": [
              53.858299255371094,
              641.2605590820312,
              242.51187133789062,
              648.0867309570312
            ],
            "ids": [
              [
                5,
                7

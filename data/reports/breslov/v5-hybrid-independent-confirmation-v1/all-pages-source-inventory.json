          {
            "bbox": [
              252.61647033691406,
              425.2672119140625,
              428.8294372558594,
              432.0933837890625
            ],
            "ids": [
              [
                9,
                3
              ]
            ],
            "text": "HaPanim con la alegría, tal como hace el Rabí Natán aquí."

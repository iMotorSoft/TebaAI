                5,
                0
              ]
            ],
            "text": "11 ■ LAS BENDICIONES DE LA MAÑANA[91]"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          84.85669708251953,
          308.8989562988281,
          413.9486389160156,
          355.6189880371094
        ],
        "lines": [
          {
            "bbox": [
              84.85669708251953,
              308.8989562988281,
              413.9486389160156,
              318.4189758300781
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Aquí el Rabí Natán se vuelve hacia otra de nuestras actividades de la mañana: "
          },
          {
            "bbox": [
              84.85669708251953,
              320.8989562988281,
              413.9436950683594,
              330.4189758300781
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "el recitado de las bendiciones matutinas. Demostrará que a través de esas "
          },
          {
            "bbox": [
              84.85669708251953,
              332.8989562988281,
              413.9465026855469,
              342.4689636230469
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "bendiciones diarias alabamos a HaShem y Le agradecemos por permitir que "
          },
          {
            "bbox": [
              84.85669708251953,
              346.0989685058594,
              269.8966979980469,
              355.6189880371094
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "nuestras almas despierten verdaderamente."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.456695556640625,
          363.7879943847656,
          444.91790771484375,
          397.74798583984375
        ],
        "lines": [
          {
            "bbox": [
              84.85669708251953,
              363.7879943847656,
              444.8387756347656,
              373.74798583984375
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Todas las bendiciones de la mañana aluden a esto, pues a través de estas "
          },
          {
            "bbox": [
              56.456695556640625,
              375.8979797363281,
              444.91790771484375,
              385.74798583984375
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "bendiciones la persona alaba a HaShem por haberla ayudado a encontrar sus "
          },
          {
            "bbox": [
              56.456695556640625,
              387.60797119140625,
              421.54779052734375,
              397.74798583984375
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "puntos buenos y así haber podido despertar de su sueño y caída espiritual."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          56.45672607421875,
          400.6429748535156,
          444.93072509765625,
          472.5829772949219
        ],
        "lines": [
          {
            "bbox": [
              84.85669708251953,
              400.6429748535156,
              444.93072509765625,
              412.5829772949219
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "Éste es el signifi cado de la bendición de la mañana, “Quien le da comprensión "
          },
          {
            "bbox": [
              56.45672607421875,
              414.4429626464844,
              444.9267272949219,
              424.5829772949219
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "al corazón para distinguir entre el día y la noche”. El punto bueno brilla como "
          },
          {
            "bbox": [
              56.45672607421875,
              426.4429626464844,
              444.91766357421875,
              436.5929870605469
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "la luz del día, mientras que el mal corresponde a la noche y a la oscuridad. Al "
          },
          {
            "bbox": [
              56.456729888916016,
              438.73297119140625,
              444.9287109375,
              448.5829772949219
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "encontrar y elevar los puntos buenos, el mal es igualmente separado del bien. "
          },
          {
            "bbox": [
              56.45672607421875,
              450.4429626464844,
              444.91986083984375,
              460.5829772949219
            ],
            "ids": [
              [
                7,
                7
              ]
            ],
            "text": "Consecuentemente, uno separa el día de la noche, como en “para distinguir "
          },
          {
            "bbox": [
              56.45672607421875,
              462.4429626464844,
              177.68572998046875,
              472.5829772949219
            ],
            "ids": [
              [
                7,
                8
              ]
            ],
            "text": "entre el día [y la noche]”."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.45672607421875,
          477.2769775390625,
          444.93280029296875,
          559.427001953125
        ],
        "lines": [
          {
            "bbox": [
              84.85672760009766,
              477.2769775390625,
              444.9187316894531,
              487.4169921875
            ],
            "ids": [
              [
                7,
                9
              ]
            ],
            "text": "Es posible encontrar una distinción similar en la bendición “Que no me "
          },
          {
            "bbox": [
              56.45672607421875,
              489.2769775390625,
              444.92974853515625,
              499.4169921875
            ],
            "ids": [
              [
                7,
                10
              ]
            ],
            "text": "hizo un no judío” (que sólo debe guardar siete mitzvot básicas). Pues si la persona "
          },
          {
            "bbox": [
              56.456756591796875,
              501.2769775390625,
              444.93280029296875,
              511.4169921875
            ],
            "ids": [
              [
                7,
                11
              ]
            ],
            "text": "no encuentra un punto bueno dentro de sí, puede caer y alejarse completamente, "
          },
          {
            "bbox": [
              56.456756591796875,
              513.2769775390625,
              444.8388366699219,
              523.4169921875
            ],
            "ids": [
              [
                7,
                12
              ]
            ],
            "text": "jas ve-shalom, y así volverse como un no judío con respecto a la observancia de esa "
          },
          {
            "bbox": [
              56.456756591796875,
              525.0756225585938,
              444.91680908203125,
              535.427001953125
            ],
            "ids": [
              [
                7,
                13
              ]
            ],
            "text": "mitzvá. Pero ahora que se ha despertado y se ha fortalecido como resultado de "
          },
          {
            "bbox": [
              56.456756591796875,
              537.2769775390625,
              444.9249267578125,
              547.427001953125
            ],
            "ids": [
              [
                7,
                14
              ]
            ],
            "text": "que HaShem la ha ayudado a encontrar el punto bueno dentro de sí, agradece "
          },
          {
            "bbox": [
              56.456756591796875,
              547.4769897460938,
              441.9648132324219,
              559.427001953125
            ],
            "ids": [
              [
                7,
                15
              ]
            ],
            "text": "por lo tanto y alaba a HaShem por el hecho de que Él “no me hizo un no judío”."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          56.456756591796875,
          564.1119384765625,
          444.92974853515625,
          586.251953125
        ],
        "lines": [
          {
            "bbox": [
              84.85675811767578,
              564.1119384765625,
              444.92364501953125,
              574.251953125
            ],
            "ids": [
              [
                7,
                16
              ]
            ],
            "text": "Esto se aplica también a las bendiciones “Quien abre los ojos del ciego”, "
          },
          {
            "bbox": [
              56.456756591796875,
              576.3619384765625,
              444.92974853515625,
              586.251953125
            ],
            "ids": [
              [
                7,
                17
              ]
            ],
            "text": "“Quien libera a los atados” y “Quien endereza a los encorvados”. Inicialmente, "
          }
        ]
      },
      {
        "index": 11,
        "class": "footnote",
        "bbox": [
          56.692901611328125,
          630.7014770507812,
          245.34271240234375,
          646.5276489257812
        ],

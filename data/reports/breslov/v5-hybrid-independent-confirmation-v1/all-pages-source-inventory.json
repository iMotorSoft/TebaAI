              53.857139587402344,
              427.25567626953125,
              442.1771240234375,
              437.26739501953125
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "puntos cristalizan algunas de las ideas principales con un giro hacia las implicancias "
          },

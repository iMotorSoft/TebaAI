              613.3224487304688,
              242.49302673339844,
              620.1486206054688
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "así en la enseñanza rabínica el gallo es llamado “guever”; ver "
          },
          {
            "bbox": [
              53.8582763671875,
              622.3224487304688,
              242.50804138183594,
              629.1339721679688
            ],
            "ids": [
              [
                11,
                5
              ]
            ],
            "text": "Ioma 20b). El Rabí Meir Ibn Gabai conecta esto con el cantar "
          },
          {
            "bbox": [
              53.8582763671875,
              631.3224487304688,
              242.5208282470703,
              638.1486206054688
            ],
            "ids": [
              [
                11,
                6
              ]
            ],
            "text": "del gallo a medianoche, el punto más álgido del gobierno del "
          },
          {
            "bbox": [
              53.8582763671875,
              640.3224487304688,
              218.42626953125,
              647.1486206054688
            ],
            "ids": [
              [
                11,
                7
              ]
            ],
            "text": "din en el mundo (Tolaat Iaacov, Sod Birkot HaShajar)."
          }
        ]
      },

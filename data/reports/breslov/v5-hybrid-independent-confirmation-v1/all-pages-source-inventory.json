          285.281982421875
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              276.031982421875,
              435.0909423828125,
              285.281982421875
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "“continuar aumentando” el número de las velas de Jánuca en cada día sucesivo."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.69287109375,
          290.67535400390625,
          445.166015625,
          396.82598876953125
        ],
        "lines": [
          {
            "bbox": [
              85.0928955078125,
              290.67535400390625,
              445.16485595703125,
              300.82598876953125
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "De acuerdo a Jazal, la legislación de Beit Hilel se basa en el principio de “En "
          },
          {
            "bbox": [
              56.69287109375,
              302.8450012207031,
              445.1640319824219,
              312.82598876953125
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "temas de santidad elevamos a un nivel superior y no disminuimos”.[92]Pero la "
          },
          {
            "bbox": [
              56.693023681640625,
              314.68597412109375,
              445.1592102050781,
              324.82598876953125
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "cuestión es: ¡¿Acaso alguien puede llegar a pensar en disminuir la santidad, "
          },
          {
            "bbox": [
              56.693023681640625,
              326.68597412109375,
              445.166015625,
              336.83599853515625
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "jas ve-shalom?! Sin embargo, esto se relaciona con lo que se dijo más arriba, de "
          },
          {
            "bbox": [
              56.693023681640625,
              338.9759826660156,
              445.153076171875,
              348.83599853515625
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "que hay Tzadikim de estatura espiritual realmente elevada que, sin embargo, "
          },
          {
            "bbox": [
              56.693023681640625,
              350.9759826660156,
              445.1530456542969,
              360.82598876953125
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "debido a su notable santidad, son incapaces de tolerar el mundo. Debido a "
          },
          {
            "bbox": [
              56.693023681640625,
              362.9759826660156,
              445.1531677246094,
              372.82598876953125
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "la intensidad de su santidad, alejan a cierta gente y, al encolerizarse con ella, "
          },
          {
            "bbox": [
              56.693023681640625,
              374.9759826660156,
              445.16107177734375,
              384.83599853515625
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "la hacen descender, jas ve-shalom, dado que esos Tzadikim son incapaces de "
          },
          {
            "bbox": [
              56.69305419921875,
              386.9759826660156,
              249.79006958007812,
              396.82598876953125
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "tolerar su comportamiento reprensible."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.6929931640625,
          401.7709655761719,
          358.0010681152344,
          553.4010009765625
        ],
        "lines": [
          {
            "bbox": [
              85.09305572509766,
              401.7709655761719,
              358.0000305175781,
              411.6609802246094
            ],
            "ids": [
              [
                5,
                10
              ]
            ],
            "text": "Sin embargo, HaShem no desea esta actitud, “pues "
          },
          {
            "bbox": [
              56.69305419921875,
              411.7209777832031,
              357.9910888671875,
              423.6709899902344
            ],
            "ids": [
              [
                5,
                11
              ]
            ],
            "text": "Él desea jesed”. Él desea que los Tzadikim sean siempre "
          },
          {
            "bbox": [
              56.69305419921875,
              425.5209655761719,
              357.9891662597656,
              435.6709899902344
            ],
            "ids": [
              [
                5,
                12
              ]
            ],
            "text": "compasivos con el pueblo judío y lo acerquen, aunque sea "
          },
          {
            "bbox": [
              56.69305419921875,
              435.7209777832031,
              357.9931335449219,
              447.6609802246094
            ],
            "ids": [
              [
                5,
                13
              ]
            ],
            "text": "como es. Incluso si Él Mismo está muy encolerizado con ellos "
          },
          {
            "bbox": [
              56.69305419921875,
              447.7209777832031,
              357.9931335449219,
              459.6709899902344
            ],
            "ids": [
              [
                5,
                14
              ]
            ],
            "text": "debido a sus malas acciones, Él desea que los Tzadikim oren "
          },
          {
            "bbox": [
              56.69305419921875,
              459.9009704589844,
              358.00006103515625,
              471.6709899902344
            ],
            "ids": [
              [
                5,
                15
              ]
            ],
            "text": "por ellos para que se arrepientan y así los acerquen a Él. Así es "
          },
          {
            "bbox": [
              56.69305419921875,
              473.5209655761719,
              357.9921569824219,
              483.6609802246094
            ],
            "ids": [
              [
                5,
                16
              ]
            ],
            "text": "como Jazal explican el versículo “Moshé tomaba la tienda "
          },
          {
            "bbox": [
              56.69305419921875,
              485.80096435546875,
              358.0010681152344,
              495.6609802246094
            ],
            "ids": [
              [
                5,
                17
              ]
            ],
            "text": "y la armaba fuera del campamento, lejos del campamento”, "
          },
          {
            "bbox": [
              56.69305419921875,
              497.5103454589844,
              357.238037109375,
              507.6709899902344
            ],
            "ids": [
              [
                5,
                18
              ]
            ],
            "text": "dado que el pueblo había pecado con el becerro de oro. Jazal "
          },
          {
            "bbox": [
              56.69305419921875,
              509.7010192871094,
              357.9990539550781,
              519.6610107421875
            ],
            "ids": [
              [
                5,
                19
              ]
            ],
            "text": "nos dicen que en respuesta a la acción de Moshé, HaShem dijo, "
          },
          {
            "bbox": [
              56.69305419921875,
              521.52099609375,
              357.9080810546875,
              531.6610107421875
            ],
            "ids": [
              [
                5,
                20
              ]
            ],
            "text": "“Yo estoy enojado con el pueblo judío y tú estás enojado con el "
          },
          {
            "bbox": [
              56.69305419921875,
              533.52099609375,
              357.9970397949219,
              543.6710205078125
            ],
            "ids": [
              [
                5,
                21
              ]
            ],
            "text": "pueblo judío. Si es así, ¿quién los acercará?”.[93]Rashi cita este "
          },
          {
            "bbox": [
              56.6929931640625,
              545.6800537109375,
              192.20384216308594,
              553.4010009765625
            ],
            "ids": [
              [
                5,
                22
              ]
            ],
            "text": "Midrash en su comentario.[94]"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          363.5429992675781,

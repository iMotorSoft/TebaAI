        "index": 10,
        "class": "text",
        "bbox": [
          255.4488983154297,
          433.52703857421875,
          444.1087646484375,
          485.34222412109375
        ],
        "lines": [
          {
            "bbox": [
              255.4488983154297,
              433.52703857421875,
              444.1087646484375,
              440.35687255859375
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "poder para mitigar los juicios que socavan la existencia del "
          },
          {
            "bbox": [
              255.4488983154297,
              442.52703857421875,
              444.09930419921875,
              449.35687255859375
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "mundo (ver LM, 37:4 y nota 40). El Rebe Najmán agrega que "
          },
          {
            "bbox": [
              255.4488983154297,
              451.53070068359375,
              444.1057434082031,
              458.35687255859375
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "el aliento -es decir, la capacidad de estudiar Torá en pureza y "
          },
          {
            "bbox": [
              255.4488983154297,
              460.53070068359375,
              444.09844970703125,
              467.35687255859375
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "santidad- deriva del mishkán espiritual que el Tzadik construye "
          },
          {
            "bbox": [
              255.44964599609375,
              469.52703857421875,
              444.0970764160156,
              476.35687255859375
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "a partir de los puntos buenos del pueblo judío (ver también "
          },
          {
            "bbox": [
              255.44964599609375,
              478.53070068359375,
              323.97705078125,
              485.34222412109375
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "notas72 más adelante)."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          255.44891357421875,
          487.53070068359375,
          444.10894775390625,
          620.3422241210938

              304.92498779296875,
              414.1806335449219,
              314.68499755859375
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "El Rabí Natán explica por qué el tikún que el hijo lleva a cabo por el alma "
          },
          {
            "bbox": [
              85.09269714355469,
              317.16497802734375,
              414.1766662597656,
              326.7349853515625
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "de sus progenitores tiene lugar precisamente una vez al año. Al igual que el "
          },
          {
            "bbox": [
              85.09269714355469,
              329.16497802734375,
              414.1766662597656,
              338.68499755859375
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "ciclo diario, el ciclo anual es una secuencia recurrente de oscuridad y de "
          },
          {
            "bbox": [
              85.09269714355469,
              341.0849914550781,
              414.1846923828125,
              350.68499755859375
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "luz, de exilio y de redención, simbólico de la renovación del daat del alma "
          },
          {
            "bbox": [
              85.09271240234375,
              353.16497802734375,
              141.79171752929688,
              360.79498291015625
            ],
            "ids": [

                1
              ]
            ],
            "text": "INTRODUCCIÓN DEL RABÍ NATÁN"
          }
        ]
      },
      {
        "index": 1,
        "class": "page-header",
        "bbox": [
          53.858299255371094,
          47.827545166015625,
          137.24227905273438,
          54.539546966552734
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              47.827545166015625,
              137.24227905273438,
              54.539546966552734
            ],
            "ids": [
              [
                0,
                0
              ]
            ],
            "text": "10   LIKUTEY HALAJOT"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          53.858299255371094,
          70.85003662109375,
          442.16943359375,
          94.067138671875
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              70.85003662109375,
              442.16943359375,
              80.86712646484375
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "de la intención debe ser cumplir con este consejo en simpleza y rogarle a HaShem que "
          },
          {
            "bbox": [
              53.858299255371094,
              84.055419921875,
              176.37631225585938,
              94.067138671875
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "podamos ser dignos de ello."
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.85830307006836,
          99.23443603515625,
          442.17718505859375,
          294.029541015625
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              99.23443603515625,
              442.1484375,
              109.25152587890625
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "Lo mismo se aplica al resto de los maravillosos consejos y guías revelados por "
          },
          {
            "bbox": [
              53.85830307006836,
              112.4344482421875,
              442.13958740234375,
              122.4515380859375
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "el Rebe, tal como en la lección VeAié HaSé LeOlá en LM II, 12. El consejo que allí se "
          },
          {
            "bbox": [
              53.859405517578125,
              125.63983154296875,
              442.1704406738281,
              135.65155029296875
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "revela contiene una simpleza y una integridad insondables; por ello debe ser expuesto "
          },
          {
            "bbox": [
              53.859405517578125,
              138.83984375,
              442.1572265625,
              148.8515625
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "en extenso y abordado desde diferentes perspectivas o modos. Pero con la bondad de "
          },
          {
            "bbox": [
              53.859405517578125,
              152.03448486328125,
              442.1749267578125,
              162.05157470703125
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "HaShem, he sido iluminado y descubrí que ese consejo está aludido en muchos lugares de "
          },
          {
            "bbox": [
              53.859405517578125,
              165.2398681640625,
              442.1396789550781,
              175.2515869140625
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "la Torá, tal cual puede verse en LH, Gueviat Jov MeiHaItomim 3. La persona inteligente "
          },
          {
            "bbox": [
              53.858306884765625,
              178.43988037109375,
              442.17169189453125,
              188.43011474609375
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "será capaz de deducir una cosa de la otra para comprender cómo toda la Torá está plena "
          },
          {
            "bbox": [
              53.858306884765625,
              191.634521484375,
              442.12646484375,
              201.651611328125
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "de este consejo. Lo mismo se aplica a la lección Azamra LeElohai BeOdi en el LM I, "
          },
          {
            "bbox": [
              53.858306884765625,
              204.83990478515625,
              442.14306640625,
              214.83013916015625
            ],
            "ids": [
              [
                1,
                10
              ]
            ],
            "text": "282, citado en LH, Hashkamat HaBoker 1. Esto es verdad también del concepto del "
          },
          {
            "bbox": [
              53.85939025878906,
              218.0399169921875,
              442.1661682128906,
              228.0516357421875
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "anhelo y del deseo de HaShem. Todos estos temas requieren de un tratamiento extenso "
          },
          {
            "bbox": [
              53.85939025878906,
              231.23992919921875,
              442.172607421875,
              241.25164794921875
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "hasta llegar a tener el mérito de imbuirlos en el corazón de la persona, para que pueda "
          },
          {
            "bbox": [
              53.85939025878906,
              242.42578125,
              442.17718505859375,
              254.45166015625
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "cumplirlos con simpleza y sinceridad. Éste es el elemento más importante, dado que "
          },
          {
            "bbox": [
              53.85939025878906,
              257.28021240234375,
              442.1300048828125,
              267.63018798828125
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "“no es el estudio lo más importante sino la práctica”.[23] Por esos motivos, fue necesario "
          },
          {
            "bbox": [
              53.858612060546875,
              270.83392333984375,
              442.17303466796875,
              280.85101318359375
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": "exponerlo ampliamente y en muchos lugares, para explicar el consejo en términos "
          },
          {
            "bbox": [
              53.858612060546875,
              284.039306640625,
              254.26763916015625,
              294.029541015625
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "simples, para que su estudio lleve a la acción."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          53.85860824584961,
          299.22479248046875,
          442.17962646484375,
          388.43658447265625
        ],
        "lines": [
          {
            "bbox": [
              82.25840759277344,
              299.22479248046875,
              442.174072265625,
              309.23651123046875
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "Ello también es debido a las ideas originales mismas, pues las enseñanzas del Rebe "
          },
          {
            "bbox": [
              53.85860824584961,
              312.4248046875,
              442.1587829589844,
              322.4365234375
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "son extremadamente profundas y abarcadoras. En cada lección hay muchos principios, "
          },
          {
            "bbox": [
              53.85860824584961,
              325.62481689453125,
              442.14776611328125,
              335.63653564453125
            ],
            "ids": [
              [
                1,
                19
              ]
            ],
            "text": "conceptos y asombrosas ideas. Y todas las ideas originales que HaShem, abriendo "
          },
          {
            "bbox": [
              53.85860824584961,
              336.6615295410156,
              442.1465759277344,
              348.8385314941406
            ],
            "ids": [
              [
                1,
                20
              ]
            ],
            "text": "mis ojos, me permitió percibir están todas unidas y fi rmemente entrelazadas con las "
          },
          {
            "bbox": [
              53.85972595214844,
              352.02484130859375,
              442.17962646484375,
              362.03656005859375
            ],
            "ids": [
              [
                1,
                21
              ]
            ],
            "text": "tremendas y santas palabras del Rebe. Así, allí en donde he expandido la explicación y la "
          },
          {
            "bbox": [
              53.85972595214844,
              365.224853515625,
              442.17633056640625,
              375.236572265625
            ],
            "ids": [
              [
                1,
                22
              ]
            ],
            "text": "idea que HaShem me ha ayudado a originar, uno debe volver cada vez para repasar todas "
          },
          {
            "bbox": [
              53.85972595214844,
              378.42486572265625,
              379.5257568359375,
              388.43658447265625
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "las partes de la lección que el Rebe reveló y todos sus numerosos detalles."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          53.859710693359375,
          393.6092529296875,
          442.1972351074219,
          535.5994873046875
        ],
        "lines": [
          {
            "bbox": [
              82.259521484375,
              393.6092529296875,
              442.1466064453125,
              403.6209716796875
            ],
            "ids": [
              [
                1,
                24
              ]
            ],
            "text": "Como yo mismo escuché de los santos labios del Rebe, no hay nadie que pueda "
          },
          {
            "bbox": [
              53.85972213745117,
              406.80926513671875,
              442.1697082519531,
              416.79949951171875
            ],
            "ids": [
              [
                1,
                25
              ]
            ],
            "text": "comprender apropiadamente sus lecciones, dado que uno debe recordar absolutamente "
          },
          {
            "bbox": [
              53.85972213745117,
              420.00927734375,
              442.1378479003906,
              430.02099609375
            ],
            "ids": [
              [
                1,
                26
              ]
            ],
            "text": "todas las palabras de sus santas lecciones y ser experto en todas sus áreas, en todos sus "
          },
          {
            "bbox": [
              53.85972213745117,
              431.0459899902344,
              442.16644287109375,
              443.2229919433594
            ],
            "ids": [
              [
                1,
                27
              ]
            ],
            "text": "conceptos específi cos y detalles. Por lo tanto, en muchos lugares me vi obligado a tratar "
          },
          {
            "bbox": [
              53.85972595214844,
              446.4092712402344,
              442.181884765625,
              456.4209899902344
            ],
            "ids": [
              [
                1,
                28
              ]
            ],
            "text": "y a exponer ampliamente la enseñanza y a repetir la misma idea varias veces, con la "
          },
          {
            "bbox": [
              53.85972595214844,
              459.6092529296875,
              442.1752014160156,
              469.5994873046875
            ],
            "ids": [
              [
                1,
                29
              ]
            ],
            "text": "esperanza de que la sustancia de la verdadera intención pudiera penetrar en el corazón "
          },
          {
            "bbox": [
              53.85972595214844,
              472.80926513671875,
              442.1972351074219,
              482.82098388671875
            ],
            "ids": [
              [
                1,
                30
              ]
            ],
            "text": "del lector, para que llegue a comprender con claridad la idea original. Lo más importante "
          },
          {
            "bbox": [
              53.85972595214844,
              486.00927734375,
              442.1950988769531,
              495.99951171875
            ],
            "ids": [
              [
                1,
                31
              ]
            ],
            "text": "es que la idea lleve a la acción: que la persona se vea inspirada por ella para cumplir con "
          },
          {
            "bbox": [
              53.85972595214844,
              499.2092590332031,
              442.18743896484375,
              509.2209777832031
            ],
            "ids": [
              [
                1,
                32
              ]
            ],
            "text": "las palabras del Rebe, con simpleza y para poner en práctica el principio que he extraído "
          },
          {
            "bbox": [
              53.85972595214844,
              510.2459411621094,
              442.126708984375,
              522.4229125976562
            ],
            "ids": [
              [
                1,
                33
              ]
            ],
            "text": "de las enseñanzas del Rebe, sobre el cual he construido ese discurso específi co, dado que "
          },
          {
            "bbox": [
              53.859710693359375,
              525.6092529296875,
              321.79779052734375,
              535.5994873046875
            ],
            "ids": [
              [
                1,
                34
              ]
            ],
            "text": "los pensamientos del Rebe son extremadamente insondables."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.85970687866211,
          540.7936401367188,
          442.1795349121094,
          590.4053955078125
        ],
        "lines": [
          {
            "bbox": [
              82.25950622558594,
              540.7936401367188,
              442.1795349121094,
              550.8053588867188
            ],
            "ids": [
              [
                1,
                35
              ]
            ],
            "text": "Es claro y comprensible para toda persona inteligente que [es necesario perseverar] "
          },
          {
            "bbox": [
              53.85970687866211,
              553.99365234375,
              442.174072265625,
              564.00537109375
            ],
            "ids": [
              [
                1,
                36
              ]
            ],
            "text": "allí en donde, en la literatura sagrada, las ideas originales y las interpretaciones son "
          },
          {
            "bbox": [
              53.85970687866211,
              567.1936645507812,
              442.16534423828125,
              577.2053833007812
            ],
            "ids": [
              [
                1,
                37
              ]
            ],
            "text": "elaboradas con amplitud. Esto es verdad así sea que ello se encuentre en la Guemará y "
          },
          {
            "bbox": [
              53.85970687866211,
              580.0331420898438,
              442.1357727050781,
              590.4053955078125
            ],
            "ids": [
              [
                1,
                38
              ]
            ],
            "text": "en sus comentarios o en los textos de Kabalá y en el PaRDeS.[24] Así sea en el comentario "
          }
        ]
      },
      {
        "index": 7,
        "class": "text",

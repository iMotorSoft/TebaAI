            "bbox": [
              53.858299255371094,
              499.0059814453125,
              442.2283630371094,
              508.9659729003906
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "Dios. Es necesario comprender que ese punto de conexión cambia constantemente "
          },

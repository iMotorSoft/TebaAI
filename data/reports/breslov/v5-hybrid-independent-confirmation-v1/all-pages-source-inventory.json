              472.3899841308594,
              274.14404296875,
              479.4889831542969
            ],
            "ids": [
              [
                14,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.69139099121094,
          493.5484619140625,
          245.35841369628906,
          644.3746337890625
        ],
        "lines": [

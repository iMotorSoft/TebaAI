              ],
              [
                18,
                0
              ]
            ],
            "text": "superior y el intelecto inferior, el rav y el discípulo. Pues el “[Iosef] dijo, 'He "
          },
          {
            "bbox": [
              56.692596435546875,
              467.3669738769531,
              438.6699523925781,
              477.7650146484375
            ],
            "ids": [
              [
                8,
                4
              ],
              [
                18,
                1
              ]
            ],

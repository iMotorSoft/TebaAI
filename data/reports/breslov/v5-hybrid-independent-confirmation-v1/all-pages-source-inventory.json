            ],
            "text": "- alabanzas, conversaciones y enseñanzas cortas del Rebe"
          }
        ]
      },
      {
        "index": 9,
        "class": "list-item",
        "bbox": [
          82.25830078125,
          441.43389892578125,
          442.1378173828125,
          477.85101318359375
        ],
        "lines": [
          {

              245.35394287109375,
              358.82696533203125
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "de modo que en virtud de esa unión se revela en la creación una "
          },
          {
            "bbox": [
              56.692901611328125,
              361.01544189453125,
              245.347900390625,
              367.84161376953125
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "abundancia de la compasión y bondad de HaShem. Para que un "
          },
          {
            "bbox": [
              56.692901611328125,
              370.01544189453125,
              245.3448944091797,
              376.84161376953125
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "ijud se lleve a cabo, ambos aspectos deben encontrarse en un "
          },
          {
            "bbox": [
              56.692901611328125,
              379.01544189453125,
              245.32391357421875,
              385.82696533203125
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "estado de plenitud, a lo cual los kabalistas denominan panim "
          },
          {
            "bbox": [
              56.692901611328125,
              388.01544189453125,
              245.33892822265625,
              394.82696533203125
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "(rostros, ver nota 22 más adelante), i.e. ambos están ubicados "
          },
          {
            "bbox": [
              56.692901611328125,
              397.01544189453125,
              245.32240295410156,
              403.84161376953125
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "cara a cara y no espalda con espalda (ver Shaar Maamarei "
          },
          {
            "bbox": [
              56.692901611328125,

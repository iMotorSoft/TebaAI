              292.85894775390625,
              442.33221435546875,
              302.2689514160156
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "asciendan hacia la dimensión del dibur. Pues inicialmente, cuando el bien aún "
          },
          {
            "bbox": [

            "bbox": [
              53.85797119140625,
              344.5489807128906,
              442.2460632324219,
              354.50897216796875
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "cumplió a través del carácter esencial de Abraham. Metafóricamente, el levantarse a "
          },
          {
            "bbox": [
              53.85797119140625,
              356.5489807128906,
              442.3299560546875,
              366.51898193359375
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "medianoche hace referencia a quebrar la pesadez del sueño del espíritu, quebrando "
          },
          {
            "bbox": [
              53.85797119140625,
              368.36895751953125,
              442.3370361328125,
              378.50897216796875
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "la noche espiritual y la oscuridad por medio del punto bueno. Esto sólo tiene "
          },
          {
            "bbox": [
              53.85797882080078,
              380.36895751953125,
              442.3279724121094,
              390.50897216796875
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "lugar a través del ejemplo de Abraham, “el hombre de jesed”, volviéndose hacia "
          },
          {
            "bbox": [
              53.858001708984375,
              392.61895751953125,
              258.2579650878906,
              402.50897216796875
            ],
            "ids": [

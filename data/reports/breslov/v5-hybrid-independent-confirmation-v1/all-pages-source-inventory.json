            "bbox": [
              53.8575439453125,
              213.3220672607422,
              431.9358215332031,
              223.58206176757812
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "al asombro de todos ante esto Se magnifi ca la gloria de HaShem en el mundo.[14]"
          }

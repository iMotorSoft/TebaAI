              53.856781005859375,
              548.1444702148438,
              242.498291015625,
              554.6007690429688
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "Con las bendiciones del Kriat Shemá, la tercera sección, "
          },
          {
            "bbox": [
              53.856781005859375,
              557.1444702148438,
              242.48776245117188,
              563.6007690429688
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "ascendemos al Mundo de Beriá. Finalmente, con las Shmone "
          },
          {
            "bbox": [
              53.85676574707031,
              566.1444702148438,
              242.49301147460938,
              572.9559936523438
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "Esere avanzamos hacia el Mundo de Atzilut (ver Apéndice "
          },
          {
            "bbox": [

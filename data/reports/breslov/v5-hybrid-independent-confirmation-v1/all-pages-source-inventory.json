              56.692901611328125,
              433.5374755859375,
              245.3427276611328,
              440.3636474609375
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "y eleva sus puntos buenos, los cuales son llevados hacia él y "
          },
          {
            "bbox": [
              56.692901611328125,
              442.5338134765625,
              245.34947204589844,
              449.3636474609375
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "se unen con él. Habiendo explicado que el juzgar a los demás "
          },
          {
            "bbox": [
              56.692901611328125,
              451.5338134765625,
              245.35472106933594,
              458.3636474609375
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "de manera favorable crea las melodías, el Rebe Najmán llama "
          },
          {
            "bbox": [
              56.692901611328125,
              460.5374755859375,
              245.3389434814453,
              467.3636474609375
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "jazán al individuo que puede recolectar todos los puntos "
          },
          {
            "bbox": [
              56.692901611328125,
              469.5338134765625,
              245.33297729492188,
              476.3636474609375
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "buenos que se encuentran incluso en los pecadores judíos y es "
          },
          {
            "bbox": [
              56.692901611328125,
              478.5374755859375,
              225.19544982910156,
              485.3636474609375
            ],
            "ids": [
              [
                11,
                5
              ]
            ],
            "text": "quien guía a la congregación en una plegaria melodiosa."
          },
          {
            "bbox": [
              56.692901611328125,
              487.5374755859375,
              245.34796142578125,
              494.3636474609375
            ],
            "ids": [
              [
                11,
                6
              ]
            ],
            "text": "8 Como será explicado (ver §4 más adelante), luego de que "
          },
          {
            "bbox": [
              56.692901611328125,
              496.5338134765625,
              245.3329620361328,
              503.3636474609375
            ],
            "ids": [
              [
                11,
                7
              ]
            ],
            "text": "los judíos pecaron con el becerro de oro, HaShem les ordenó "
          },
          {
            "bbox": [
              56.692901611328125,
              505.5374755859375,
              245.34573364257812,
              512.3489990234375
            ],
            "ids": [
              [
                11,
                8
              ]
            ],
            "text": "construir el Mishkán, en el cual podrían obtener la expiación. "
          },
          {
            "bbox": [
              56.69290542602539,
              514.5374755859375,
              245.3487091064453,
              521.3636474609375
            ],
            "ids": [
              [
                11,
                9
              ]
            ],
            "text": "Moshé Rabeinu, el Tzadik guía de esa generación, recolectó "
          },
          {
            "bbox": [
              56.692161560058594,
              523.5338134765625,
              245.3434295654297,
              530.3636474609375
            ],
            "ids": [
              [
                11,
                10
              ]
            ],
            "text": "todas las contribuciones hechas por el pueblo judío y erigió "
          },
          {
            "bbox": [
              56.692161560058594,
              532.5338134765625,
              245.3367462158203,
              539.3636474609375
            ],
            "ids": [
              [
                11,
                11
              ]
            ],
            "text": "el Mishkán con sus regalos. El Rebe Najmán enseña que la "
          },
          {
            "bbox": [
              56.69215774536133,
              540.0625,
              245.3276824951172,
              548.364990234375
            ],
            "ids": [
              [
                11,
                12
              ]
            ],
            "text": "donación de cada individuo era un refl ejo de su punto bueno "
          },
          {
            "bbox": [
              56.692161560058594,
              550.5374755859375,
              245.32994079589844,
              557.3636474609375
            ],
            "ids": [
              [
                11,
                13
              ]
            ],
            "text": "personal. En ese sentido, el Mishkán se construyó a partir de "
          },
          {
            "bbox": [
              56.69215393066406,
              559.5338134765625,
              183.3596954345703,
              566.3636474609375
            ],
            "ids": [
              [
                11,
                14
              ]
            ],
            "text": "los puntos buenos de todo el pueblo judío."
          }

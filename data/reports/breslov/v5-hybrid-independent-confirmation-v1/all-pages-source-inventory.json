              568.4049682617188,
              271.30902099609375,
              575.5029907226562
            ],
            "ids": [
              [
                15,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          53.85810089111328,
          589.5949096679688,
          242.50941467285156,
          614.4247436523438
        ],
        "lines": [
          {
            "bbox": [
              53.85810089111328,
              589.5949096679688,
              242.50714111328125,
              596.4247436523438
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "51 Ver LM I, 36:1, donde el Rebe Najmán enseña que cada "
          },
          {
            "bbox": [
              53.85810089111328,
              598.5985717773438,
              242.50941467285156,
              605.4247436523438
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "rasgo negativo tiene su raíz en cada una de las naciones del "
          },
          {
            "bbox": [
              53.85810089111328,
              606.1235961914062,
              165.07786560058594,
              614.4260864257812
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "mundo y es la cualidad que la defi ne."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          53.85810852050781,
          616.5985717773438,
          242.51394653320312,
          632.2709350585938
        ],
        "lines": [
          {
            "bbox": [
              53.85810852050781,
              616.5985717773438,
              242.51394653320312,
              623.4100952148438
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "52 El Rabí Natán expandirá su explicación de este versículo "
          },
          {
            "bbox": [
              53.85810852050781,
              625.5985717773438,
              116.7606201171875,
              632.2709350585938
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "en §14 más adelante."
          }
        ]
      },
      {
        "index": 14,
        "class": "list-item",
        "bbox": [
          53.85810852050781,
          634.5985717773438,
          242.52740478515625,
          650.4247436523438
        ],
        "lines": [
          {
            "bbox": [
              53.85810852050781,
              634.5985717773438,
              242.52740478515625,
              639.9196166992188
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "53 Similar a la máxima citada anteriormente en esta sección "
          },
          {
            "bbox": [
              53.85810852050781,
              643.5949096679688,
              242.49212646484375,
              650.4247436523438
            ],
            "ids": [
              [
                12,
                6
              ]
            ],
            "text": "(basada en Tanjuma, Tzav 14), el Rabí Itzjak enseñó (Menajot "
          }
        ]
      },
      {
        "index": 15,
        "class": "text",
        "bbox": [
          252.6133575439453,
          589.6068115234375,
          441.2750244140625,
          623.4183349609375
        ],
        "lines": [
          {
            "bbox": [
              252.6133575439453,
              589.6068115234375,
              441.2690124511719,
              596.4329833984375
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "110a), “Todo aquel que se ocupa de las leyes de la ofrenda de "
          },
          {
            "bbox": [
              252.6133575439453,
              598.6068115234375,
              441.26068115234375,
              605.4329833984375
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "pecado, es como si hubiese llevado una ofrenda de pecado y "
          },
          {
            "bbox": [
              252.6133575439453,
              607.6068115234375,
              441.2750244140625,
              614.4329833984375
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "todo aquel que se ocupa con las leyes de la ofrenda de culpa, es "
          },
          {
            "bbox": [
              252.6133575439453,
              616.6068115234375,
              394.6631774902344,
              623.4183349609375
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "como si hubiese llevado una ofrenda de culpa”."
          }
        ]
      },
      {
        "index": 16,
        "class": "list-item",
        "bbox": [
          252.6133575439453,
          625.6068115234375,
          441.2539978027344,
          650.4329833984375
        ],
        "lines": [
          {
            "bbox": [
              252.6133575439453,
              625.6068115234375,
              441.248046875,
              632.4329833984375
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "54 Meguilá 3a; Taanit 26a y siguientes. Jazal enseñan que "
          },
          {
            "bbox": [
              252.61407470703125,
              634.6068115234375,
              441.248779296875,
              641.4329833984375
            ],
            "ids": [
              [
                13,
                5
              ]
            ],
            "text": "por una legislación instituida en los días de David HaMelej "
          },
          {
            "bbox": [
              252.61407470703125,
              643.6068115234375,
              441.2539978027344,
              650.4329833984375
            ],
            "ids": [
              [
                13,
                6
              ]
            ],
            "text": "se dividió a los kohanim en mishmarot (lit. “guardias”), "
          }
        ]
      }
    ]

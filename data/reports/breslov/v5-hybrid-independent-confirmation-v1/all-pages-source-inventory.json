              327.9109802246094,
              433.9429931640625,
              338.99896240234375
            ],
            "ids": [
              [
                2,
                6
              ],
              [
                12,
                2
              ]
            ],
            "text": "dibur, como en “Enmudecí con silencio; [pues] me callé sobre el me callé sobre el "
          },
          {
            "bbox": [
              373.03900146484375,
              337.510986328125,
              393.93499755859375,
              343.59100341796875
            ],

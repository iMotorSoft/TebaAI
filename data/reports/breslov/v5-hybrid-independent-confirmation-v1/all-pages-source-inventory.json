        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              267.34796142578125,
              442.3323059082031,
              277.48797607421875
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "los Shalosh Regalim, correspondiente a la alegría del corazón, como en “la "
          },
          {
            "bbox": [
              53.858299255371094,
              279.34796142578125,
              240.59629821777344,
              289.48797607421875
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "plenitud de las alegrías en Tu Panim”."
          }
        ]
      },
      {
        "index": 7,
        "class": "section-header",
        "bbox": [
          53.858306884765625,
          303.86798095703125,
          275.528076171875,

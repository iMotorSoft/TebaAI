            "bbox": [
              53.85821533203125,
              542.3179931640625,
              442.3302307128906,
              552.468017578125
            ],
            "ids": [
              [
                4,
                14
              ]
            ],
            "text": "continuar buscando dentro de sí hasta encontrar algún otro punto. Y aunque "
          },

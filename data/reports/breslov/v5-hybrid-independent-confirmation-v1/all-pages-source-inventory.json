              551.9584350585938,
              245.80419921875,
              558.7846069335938
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "cuestiones cuya solución sólo será comprendida en el futuro, "
          },
          {
            "bbox": [
              57.15370178222656,
              560.9584350585938,
              245.80569458007812,
              567.7846069335938
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "la prohibición de no profundizar en preguntas factibles de ser "
          },
          {
            "bbox": [
              57.15370178222656,
              569.9584350585938,
              245.81031799316406,
              576.7846069335938
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "respondidas es relativa y depende del estado del intelecto de "
          },
          {
            "bbox": [
              57.15370178222656,
              578.9584350585938,
              245.80577087402344,
              585.7699584960938
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "la persona en ese momento. Cuando los senderos del intelecto "
          },
          {
            "bbox": [
              57.15370178222656,
              587.9584350585938,
              245.80345153808594,
              594.7846069335938
            ],
            "ids": [
              [
                11,
                5
              ]
            ],
            "text": "están bloqueados y la solución se le escapa a la persona -un "
          },
          {
            "bbox": [
              57.15370178222656,
              596.9584350585938,
              245.7862091064453,
              603.7846069335938
            ],
            "ids": [
              [
                11,
                6
              ]
            ],
            "text": "estado que las enseñanzas kabalísticas denominan mojín "
          },
          {
            "bbox": [
              57.15370178222656,
              605.9584350585938,
              245.80801391601562,
              612.7846069335938
            ],
            "ids": [
              [
                11,
                7
              ]
            ],
            "text": "dekatnut, conciencia restringida- debe apoyarse solamente "
          },

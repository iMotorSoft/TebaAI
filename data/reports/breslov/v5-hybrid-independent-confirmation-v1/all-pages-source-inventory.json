                8
              ]
            ],
            "text": "Shuljan Aruj"
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.856712341308594,
          513.108642578125,
          442.1820068359375,
          655.120361328125
        ],
        "lines": [
          {
            "bbox": [
              75.15711212158203,
              513.108642578125,
              442.1700134277344,
              523.098876953125
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "El 20 de diciembre del año 1844 (10 de Tevet del año 5605) el Rabí Natán falleció "
          },
          {
            "bbox": [
              53.856712341308594,
              526.3032836914062,
              442.178955078125,
              536.3203735351562
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "en la ciudad de Breslov, dejando la Jasidut sólidamente establecida. El movimiento "
          },
          {
            "bbox": [
              53.856712341308594,
              539.5086669921875,
              442.1820068359375,
              549.5203857421875
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "continuaría creciendo, primero en la Europa Oriental, luego en Israel y después a lo largo "
          },
          {
            "bbox": [
              53.856712341308594,
              552.7033081054688,
              442.15130615234375,
              562.7203979492188
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "y ancho del mundo. Hoy en día los judíos de todas partes están estudiando las enseñanzas "
          },
          {
            "bbox": [
              53.856712341308594,
              565.9033203125,
              442.16015625,
              575.92041015625
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "del Rebe Najmán, publicadas en muchos idiomas. Se reúnen en Umán cada año, para "
          },
          {
            "bbox": [
              53.856712341308594,
              579.108642578125,
              442.16790771484375,
              589.098876953125
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "pasar Rosh HaShaná con el Rebe, en un encuentro al que han asistido actualmente más "
          },
          {
            "bbox": [
              53.856712341308594,
              592.3086547851562,
              442.1326599121094,
              602.3203735351562
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "de 60.000 personas. Las sinagogas de Breslov y los grupos de estudio se encuentran en "
          },
          {
            "bbox": [
              53.856712341308594,
              605.5086669921875,
              442.13909912109375,
              615.5203857421875
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "todas partes, a la vez que el estudio online ha llegado a todos los rincones del globo. Por "
          },
          {
            "bbox": [
              53.856719970703125,
              618.7086181640625,
              442.1479797363281,
              628.7203369140625
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "todo esto y más, debemos agradecer al Rabí Natán. Su visión, su determinación y sus "
          },
          {
            "bbox": [
              53.856719970703125,
              631.9086303710938,
              442.1755676269531,
              641.8988647460938
            ],
            "ids": [
              [
                3,
                9
              ]
            ],
            "text": "incansables esfuerzos potenciaron a un movimiento destinado a cumplir con la promesa "
          },
          {
            "bbox": [
              53.856719970703125,
              645.103271484375,
              351.69281005859375,
              655.120361328125
            ],
            "ids": [
              [
                3,
                10
              ]
            ],
            "text": "del Rebe Najmán: “¡Mi fuego arderá hasta la llegada del Mashíaj!”."
          }
        ]
      }
    ]
  },
  {

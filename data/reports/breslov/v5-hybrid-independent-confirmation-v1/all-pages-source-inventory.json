            "bbox": [
              82.71080017089844,
              255.99655151367188,
              353.5118103027344,
              266.2711486816406
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "Esta idea, que jesed impide que uno tropiece, está "
          },
          {
            "bbox": [
              54.310821533203125,
              267.9329528808594,
              353.51080322265625,
              278.1929626464844
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "refl ejada en el versículo “Si digo, ‘Mi pie tropezará’, Tu jesed, "
          },
          {
            "bbox": [
              54.310821533203125,
              280.0529479980469,
              353.5118103027344,
              290.1929626464844
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "HaShem, me sustentará”. Esto significa que mediante el jesed "
          },
          {
            "bbox": [
              54.310821533203125,
              292.34295654296875,
              353.50189208984375,
              302.1929626464844
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "-al inclinarse hacia la bondad y al juzgarse a uno mismo de "
          },
          {
            "bbox": [
              54.310821533203125,
              304.0529479980469,
              353.5038146972656,
              314.1929626464844
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "manera favorable, encontrando dentro de uno mismo algún "
          },
          {
            "bbox": [
              54.310821533203125,
              316.0529479980469,
              353.4208068847656,
              326.1929626464844
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "punto bueno- siempre será capaz de encontrar a HaShem y "
          },
          {
            "bbox": [
              54.310821533203125,
              328.0529479980469,
              301.54888916015625,
              338.1929626464844
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "de recibir Su apoyo. Debido a esto nunca tropezará."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          359.05499267578125,
          252.96299743652344,
          437.7509765625,
          336.81903076171875
        ],
        "lines": [

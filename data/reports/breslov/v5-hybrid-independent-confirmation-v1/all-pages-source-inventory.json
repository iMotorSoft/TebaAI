        "bbox": [
          56.69209289550781,
          424.01544189453125,
          245.357666015625,
          547.8416137695312
        ],
        "lines": [
          {
            "bbox": [
              56.69288635253906,
              424.01544189453125,
              245.33970642089844,
              430.84161376953125
            ],
            "ids": [
              [
                8,
                8
              ]
            ],
            "text": "13 El término Shejiná denota la Presencia Inmanente de "
          },
          {
            "bbox": [
              56.692893981933594,
              433.01544189453125,
              245.32614135742188,
              439.84161376953125
            ],
            "ids": [
              [
                8,
                9
              ]
            ],
            "text": "HaShem en el mundo. En Su identidad como Maljut, la "
          },
          {
            "bbox": [
              56.69212341308594,
              442.01544189453125,
              245.3291473388672,
              448.84161376953125
            ],
            "ids": [
              [
                8,
                10
              ]
            ],
            "text": "manifestación de la soberanía Divina, la Shejiná también "
          },
          {
            "bbox": [
              56.69212341308594,
              449.54046630859375,
              245.32765197753906,
              457.84295654296875
            ],
            "ids": [
              [
                8,
                11
              ]
            ],
            "text": "signifi ca la contracción del Ein Sof, de la Esencia Infi nita de "
          },
          {
            "bbox": [
              56.69212341308594,
              460.01544189453125,
              245.34864807128906,
              466.84161376953125
            ],
            "ids": [
              [
                8,
                12
              ]
            ],
            "text": "HaShem, para supervisar y gobernar directamente a la creación "
          },
          {
            "bbox": [
              56.69212341308594,
              469.01544189453125,
              245.33740234375,
              475.84161376953125
            ],
            "ids": [
              [
                8,
                13
              ]
            ],
            "text": "(ver Apéndice A, p. 225). Mientras que el no creyente le "
          },
          {
            "bbox": [
              56.69212341308594,
              478.01544189453125,
              245.357666015625,
              484.84161376953125
            ],
            "ids": [
              [
                8,
                14
              ]
            ],
            "text": "atribuye el gobierno de lo existente a la naturaleza y a la obra "
          },
          {
            "bbox": [
              56.69212341308594,
              487.01544189453125,
              245.3321075439453,
              493.82696533203125
            ],
            "ids": [
              [
                8,
                15
              ]
            ],
            "text": "del hombre (ver LH, Masá u-Matán 4:8), aquel que posee una "
          },
          {
            "bbox": [
              56.692108154296875,
              496.01544189453125,
              245.34417724609375,
              502.82696533203125
            ],
            "ids": [
              [
                8,
                16
              ]
            ],
            "text": "emuná completa Le adscribe la supervisión de la creación -es "
          },
          {
            "bbox": [
              56.692108154296875,
              505.01544189453125,
              245.32835388183594,
              511.84161376953125
            ],
            "ids": [
              [
                8,
                17
              ]
            ],
            "text": "decir de la Shejiná- al HaKadosh Baruj Hu. Tal persona por "
          },
          {
            "bbox": [
              56.692108154296875,
              514.0154418945312,
              245.32534790039062,
              520.8416137695312
            ],
            "ids": [
              [
                8,
                18
              ]
            ],
            "text": "lo tanto come con un pleno reconocimiento y emuná de que "
          },
          {
            "bbox": [
              56.69209289550781,
              523.0154418945312,
              245.339599609375,
              529.8269653320312
            ],
            "ids": [
              [
                8,
                19
              ]
            ],
            "text": "el sustento sólo proviene de HaShem, a través de Su Presencia "
          },
          {
            "bbox": [
              56.69209289550781,
              532.0154418945312,
              245.32009887695312,
              538.8416137695312
            ],
            "ids": [
              [
                8,
                20
              ]
            ],
            "text": "Inmanente. De esta manera efectúa un ijud entre HaKadosh "
          },
          {
            "bbox": [
              56.692108154296875,
              541.0154418945312,
              227.7116241455078,
              547.8416137695312
            ],
            "ids": [
              [
                8,
                21
              ]
            ],
            "text": "Baruj Hu y Su Shejiná (ver más adelante, notas 14 y 15)."
          }
        ]
      },
      {

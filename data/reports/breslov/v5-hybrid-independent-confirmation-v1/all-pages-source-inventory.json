            "bbox": [
              53.86048889160156,
              632.260498046875,
              242.49224853515625,
              639.072021484375
            ],
            "ids": [
              [
                8,
                26
              ]
            ],
            "text": "enseña que el Or HaPanim de HaShem (ver Bamidbar 6:25) "

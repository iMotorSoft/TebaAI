              186.47198486328125
            ],
            "ids": [
              [
                0,
                0
              ]
            ],
            "text": "PREFACIO DEL EDITOR"
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          85.09290313720703,
          218.27291870117188,
          400.00982666015625,
          254.69003295898438
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              218.27291870117188,
              400.00982666015625,
              228.29000854492188
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "El Rebe Najmán era muy insistente en el hecho de que debíamos estudiar "
          },
          {
            "bbox": [
              85.09290313720703,
              231.47293090820312,
              399.9735107421875,
              241.49002075195312
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "diariamente el Shuljan Aruj. “Nunca dejen pasar un día sin estudiar al "
          },
          {
            "bbox": [
              85.09291076660156,
              244.67294311523438,
              393.26800537109375,
              254.69003295898438
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "menos una ley”, dijo (Sabiduría y Enseñanzas del Rabí Najmán de Breslov #29)."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          56.05849838256836,
          271.0782775878906,
          445.0121765136719,
          307.4900207519531
        ],
        "lines": [
          {
            "bbox": [
              56.05849838256836,
              271.0782775878906,
              445.0121765136719,
              294.2900085449219
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "El Rabí Natán, el discípulo más cercano del Rebe, aceptó el mandato del Rebe y se adhirió a él asiduamente a lo largo de toda su vida. Finalmente llegó a repasar varias "
          },
          {
            "bbox": [
              56.693397521972656,
              297.4783020019531,
              267.29608154296875,
              307.4900207519531
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "veces todo el Shuljan Aruj con sus comentarios."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.69337463378906,
          313.50653076171875,
          445.010986328125,
          415.9237060546875
        ],
        "lines": [
          {
            "bbox": [
              85.09428405761719,
              313.50653076171875,
              445.0066833496094,
              323.52362060546875
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "Pero el Rebe Najmán tenía otro motivo para alentar al Rabí Natán a estudiar "
          },
          {
            "bbox": [
              56.69448471069336,
              326.7119140625,
              444.9912109375,
              336.7236328125
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "el Shuljan Aruj - quería que se familiarizara con sus leyes al punto de poder elaborar "
          },
          {
            "bbox": [
              56.69337463378906,
              339.90655517578125,
              444.9891052246094,
              349.92364501953125
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "jidushim, ideas originales, sobre ellas, basándose en las enseñanzas del Rebe Najmán en "
          },
          {
            "bbox": [
              56.69337463378906,
              353.1065673828125,
              445.010986328125,
              363.1236572265625
            ],
            "ids": [
              [
                1,
                10
              ]
            ],
            "text": "el Likutey Moharán. El Rabí Natán debía entretejer las leyes y las lecciones de manera "
          },
          {
            "bbox": [
              56.69337463378906,
              366.30657958984375,
              444.9889831542969,
              376.32366943359375
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "que demostrasen cómo cada halajá mejora y fortalece la vida de cada individuo, en "
          },
          {
            "bbox": [
              56.69337463378906,
              379.511962890625,
              445.0044860839844,
              389.523681640625
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "todo momento y en cada situación. El Rabí Natán se abocó a esta tarea componiendo "
          },
          {
            "bbox": [
              56.69337463378906,
              392.71197509765625,
              444.9625549316406,
              402.72369384765625
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "múltiples discursos sobre la mayor parte de los temas del Shuljan Aruj y generando una "
          },
          {
            "bbox": [
              56.693389892578125,
              403.7486877441406,
              343.2885437011719,
              415.9256896972656
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "visión plena del signifi cado y del espíritu de vivir como un judío."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.692901611328125,
          421.9466857910156,
          445.0165710449219,
          523.9273681640625
        ],
        "lines": [
          {
            "bbox": [
              85.09428405761719,
              421.9466857910156,
              444.971435546875,
              431.9584045410156
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": " Cuando el Rabí Natán envió el primer volumen del Likutey Halajot a la imprenta, "
          },
          {
            "bbox": [
              56.6944580078125,
              435.14666748046875,
              444.99896240234375,
              445.13690185546875
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "comentó, “Yo no escribí esta obra para aquellos que no se preocupan del sentido de la "
          },
          {
            "bbox": [
              56.6944580078125,
              448.3466796875,
              445.0010986328125,
              458.3583984375
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "vida. Tal persona puede ser comparada con un animal (come, bebe, duerme y es un ser "
          },
          {
            "bbox": [
              56.6944580078125,
              461.54132080078125,
              445.01446533203125,
              471.55841064453125
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "absolutamente ajeno al bienestar de su alma). Esta obra está dirigida a aquel que piensa "
          },
          {
            "bbox": [
              56.6944580078125,
              472.5833740234375,
              444.97808837890625,
              484.7603759765625
            ],
            "ids": [
              [
                1,
                19
              ]
            ],
            "text": "en el propósito fi nal de la vida y posee un profundo anhelo de servir a HaShem - y por lo "
          },
          {
            "bbox": [
              56.6944580078125,
              487.9412841796875,
              445.00128173828125,
              497.9583740234375
            ],
            "ids": [
              [
                1,
                20
              ]
            ],
            "text": "tanto se encuentra bajo el ataque de los ‘enemigos’ externos e internos, que le impiden "
          },
          {
            "bbox": [
              56.6944580078125,
              501.14129638671875,
              445.0165710449219,
              511.15838623046875
            ],
            "ids": [
              [
                1,
                21
              ]
            ],
            "text": "realizar su objetivo espiritual. Tal persona encontrará fuerza y aliento en mis palabras” "
          },
          {
            "bbox": [
              56.692901611328125,
              515.7359619140625,
              186.51100158691406,
              523.9273681640625
            ],
            "ids": [
              [
                1,
                22
              ]
            ],
            "text": "(Kojvei Or, Anshei Moharán II, 13)."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          56.69340515136719,
          530.3765869140625,
          445.0298767089844,
          593.1936645507812
        ],
        "lines": [
          {
            "bbox": [
              85.09320068359375,
              530.3765869140625,
              444.99029541015625,
              540.3936767578125
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "En verdad, el Likutey Halajot cumple con esos objetivos mediante una combinación "
          },
          {
            "bbox": [
              56.69340515136719,
              543.5819702148438,
              445.0298767089844,
              553.5936889648438
            ],
            "ids": [
              [
                1,
                24
              ]
            ],
            "text": "de inspiración y guía práctica. También conlleva la subyacente garantía de que al aplicar "
          },
          {
            "bbox": [
              56.69340515136719,
              556.781982421875,
              444.9935302734375,
              566.793701171875
            ],
            "ids": [
              [
                1,
                25
              ]
            ],
            "text": "la Torá a la vida de uno, cada persona obtendrá el poder para desarrollar su propia y "
          },
          {
            "bbox": [
              56.69340515136719,
              569.98193359375,
              445.00225830078125,
              579.97216796875
            ],
            "ids": [
              [
                1,
                26
              ]
            ],
            "text": "única relación con HaShem. Cada uno de nosotros puede hacerlo e incluso alcanzar "
          },
          {
            "bbox": [
              56.69340515136719,
              583.1819458007812,
              393.64556884765625,
              593.1936645507812
            ],
            "ids": [
              [
                1,
                27
              ]
            ],
            "text": "grandezas indescriptibles, con tal de que se aplique al estudio y a la práctica."
          }
        ]
      },

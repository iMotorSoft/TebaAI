              536.3270263671875,
              414.1767272949219,
              545.8469848632812
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "El Rabí Natán concluye esta sección con su exposición del versículo final "
          },
          {
            "bbox": [
              85.0927505493164,
              548.3270263671875,
              414.1846008300781,
              557.8469848632812
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "del Salmo 16, demostrando cómo el pedido a HaShem por parte de David "
          },
          {
            "bbox": [
              85.0927505493164,
              560.0870361328125,
              394.1917419433594,
              570.3670043945312
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "HaMelej engloba varios de los temas tratados hasta aquí en su discurso."
          }
        ]
      },

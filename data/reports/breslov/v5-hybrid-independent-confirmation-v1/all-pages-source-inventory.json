              245.35841369628906,
              500.3746337890625
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "deben incluir las plegarias de alguien que ha caído y que ahora "
          },
          {
            "bbox": [
              56.692901611328125,
              502.5484619140625,
              245.33740234375,
              509.3746337890625
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "anhela hacer teshuvá. Nada Le da mayor gloria a HaShem que "
          },
          {
            "bbox": [
              56.69290542602539,
              510.1751708984375,
              245.32315063476562,
              518.3746337890625
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "cuando aquéllos que están lejos retornan a Él (ver Kritot 6b y "
          },
          {
            "bbox": [
              56.69215393066406,
              520.5484619140625,
              184.53041076660156,
              527.3746337890625
            ],
            "ids": [
              [
                11,
                3

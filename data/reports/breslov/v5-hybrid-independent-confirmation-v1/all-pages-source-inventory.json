              242.5066375732422,
              637.1820678710938
            ],
            "ids": [
              [
                7,
                9
              ]
            ],
            "text": "que Abraham está identifi cado con la “mañana”, la parte "
          },
          {
            "bbox": [
              53.858314514160156,

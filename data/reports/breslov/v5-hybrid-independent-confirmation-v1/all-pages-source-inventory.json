              ]
            ],
            "text": "EN ESTA TRADUCCIÓN"
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.22380065917969,
          220.06826782226562,
          442.16326904296875,
          267.4563903808594
        ],
        "lines": [
          {
            "bbox": [
              53.22380065917969,
              220.06826782226562,
              442.16326904296875,
              243.27999877929688
            ],
            "ids": [
              [
                1,
                0
              ],
              [
                1,
                1
              ]
            ],
            "text": "Esta traducción del al lector en el estudio y en la comprensión del texto y de las ideas del Rabí Natán. Likutey Halajot al español incluye varios elementos para ayudar "
          },
          {
            "bbox": [
              53.85871124267578,
              246.46829223632812,
              442.16094970703125,
              256.4800109863281
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "A continuación presentamos las convenciones y las guías que hemos establecido para "
          },
          {
            "bbox": [
              53.85871124267578,
              259.6683044433594,
              150.9887237548828,
              267.4563903808594
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "facilitar este esfuerzo:"
          }
        ]
      },
      {
        "index": 4,
        "class": "section-header",
        "bbox": [
          53.85871124267578,
          282.30230712890625,
          90.9177017211914,
          293.456298828125
        ],
        "lines": [
          {
            "bbox": [
              53.85871124267578,
              282.30230712890625,
              90.9177017211914,
              293.456298828125
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Halajá"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          53.85650634765625,
          296.26861572265625,
          442.17535400390625,
          370.0567626953125
        ],
        "lines": [
          {
            "bbox": [
              82.25851440429688,
              296.26861572265625,
              442.1565856933594,
              306.28033447265625
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "La palabra hebrea halajá hace referencia en general a una regla de conducta en "
          },
          {
            "bbox": [
              53.85762023925781,
              309.4632568359375,
              442.17535400390625,
              319.4803466796875
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "la Ley Judía. Los jasidim de Breslov utilizan el mismo término para hacer referencia a "
          },
          {
            "bbox": [
              53.85762023925781,
              322.66864013671875,
              442.1302185058594,
              332.68035888671875
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "uno de los discursos del Rabí Natán en el Likutey Halajot. Para distinguir entre ambos, "
          },
          {
            "bbox": [
              53.85650634765625,
              335.86865234375,
              442.1368103027344,
              345.88037109375
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "hemos utilizado la palabra halajá (pl. halajot) en minúscula yen cursiva para indicar una "
          },
          {
            "bbox": [
              53.857635498046875,
              346.9053649902344,
              442.12799072265625,
              359.0823669433594
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "ley del Shuljan Aruj, y con mayúscula y sin cursiva el término Halajá para identifi car el "
          },
          {
            "bbox": [
              53.8587646484375,
              362.2686767578125,
              162.01077270507812,
              370.0567626953125
            ],
            "ids": [
              [
                2,
                6
              ]
            ],
            "text": "discurso del Rabí Natán."
          }
        ]
      },
      {
        "index": 6,
        "class": "section-header",
        "bbox": [
          53.8587646484375,
          387.9023742675781,
          116.16275024414062,
          396.4383544921875
        ],
        "lines": [
          {
            "bbox": [
              53.8587646484375,
              387.9023742675781,
              116.16275024414062,
              396.4383544921875
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Traducción"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.858734130859375,
          401.8686828613281,
          442.1830749511719,
          583.4804077148438
        ],
        "lines": [
          {
            "bbox": [
              82.25856018066406,
              401.8686828613281,
              442.1697692871094,
              411.8804016113281
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "El discurso en hebreo original del Rabí Natán se encuentra al comienzo de cada "
          },
          {
            "bbox": [
              53.858760833740234,
              415.0686950683594,
              442.1622009277344,
              425.0804138183594
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "página del texto. Al traducir sus palabras hemos tratado de mantenernos rigurosamente "
          },
          {
            "bbox": [
              53.858760833740234,
              426.10540771484375,
              442.1257019042969,
              438.28240966796875
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "fi eles al original hebreo, tanto en sentimiento como en signifi cado. Aun así, hay "
          },
          {
            "bbox": [
              53.858734130859375,
              441.46868896484375,
              442.16534423828125,
              451.48040771484375
            ],
            "ids": [
              [
                3,
                4
              ]
            ],

          244.45896911621094,
          441.1829833984375,
          309.114990234375
        ],
        "lines": [
          {
            "bbox": [
              345.59100341796875,
              244.45896911621094,
              435.85498046875,
              252.07496643066406
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "“Muchos de aquellos que "
          },
          {
            "bbox": [
              345.59100341796875,
              254.05897521972656,
              438.51898193359375,
              261.6749572753906
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "duermen en el polvo de la "
          },
          {
            "bbox": [
              345.59100341796875,
              263.6589660644531,
              431.3909912109375,
              271.27496337890625
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "tierra serán despertados, "
          },
          {
            "bbox": [
              345.59100341796875,
              273.25897216796875,
              438.510986328125,
              280.91497802734375
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "algunos para vida eterna y "
          },
          {
            "bbox": [
              345.59100341796875,
              282.8589782714844,
              441.1829833984375,
              290.4749755859375
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "otros para oprobio y eterna "
          },
          {
            "bbox": [
              345.59100341796875,
              292.7469787597656,
              386.927001953125,
              300.114990234375
            ],
            "ids": [
              [
                13,
                5
              ]
            ],
            "text": "vergüenza”."
          },
          {
            "bbox": [
              345.59100341796875,
              302.5389709472656,
              385.8370056152344,
              309.114990234375
            ],
            "ids": [
              [
                13,
                6
              ]
            ],
            "text": "(Daniel 12:2)"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          345.5906066894531,
          330.8597717285156,
          442.5185852050781,
          414.71502685546875
        ],
        "lines": [
          {
            "bbox": [
              345.5906066894531,
              330.8597717285156,
              439.4617919921875,
              338.98779296875
            ],
            "ids": [
              [
                14,
                0
              ]
            ],
            "text": "“Tú eres guibor (poderoso) "
          },
          {
            "bbox": [
              345.5906066894531,
              340.8197937011719,
              424.2865905761719,
              347.78778076171875
            ],
            "ids": [
              [
                14,
                1
              ]
            ],
            "text": "eternamente, Dios, Tú "
          },
          {
            "bbox": [
              345.5906066894531,
              350.0597839355469,
              433.6305847167969,
              356.1398010253906
            ],
            "ids": [
              [
                14,
                2
              ]
            ],
            "text": "resucitas a los difuntos… "
          },
          {
            "bbox": [
              345.5906066894531,
              358.3390197753906,
              424.8377990722656,
              365.77099609375
            ],
            "ids": [
              [
                14,
                3
              ]
            ],
            "text": "Él mantiene Su emuná "
          },
          {
            "bbox": [
              345.5906066894531,
              369.2590026855469,
              434.5265808105469,
              376.875
            ],
            "ids": [
              [
                14,
                4
              ]
            ],
            "text": "(fidelidad) hacia aquellos "
          },
          {
            "bbox": [
              345.5906066894531,
              378.85980224609375,
              442.5185852050781,
              386.4757995605469
            ],
            "ids": [
              [
                14,
                5
              ]
            ],
            "text": "que duermen en el polvo… "
          },
          {
            "bbox": [
              345.5906066894531,
              388.4598083496094,
              437.6225891113281,
              395.7878112792969
            ],
            "ids": [
              [
                14,
                6
              ]
            ],
            "text": "Bendito eres Tú, HaShem, "
          },
          {
            "bbox": [
              345.5906066894531,
              398.059814453125,
              441.1905822753906,
              405.6758117675781
            ],
            "ids": [
              [
                14,
                7
              ]
            ],
            "text": "que resucita a los difuntos”."
          },
          {
            "bbox": [
              345.5906066894531,
              408.13897705078125,
              392.2130126953125,
              414.71502685546875
            ],
            "ids": [
              [
                14,
                8
              ]
            ],
            "text": "(Shmone Esere)"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.858001708984375,
          428.05194091796875,
          442.3309631347656,
          462.2659912109375
        ],
        "lines": [
          {
            "bbox": [
              53.85801696777344,
              428.05194091796875,
              442.2400207519531,
              438.2559814453125
            ],
            "ids": [
              [
                10,
                12
              ]
            ],
            "text": "También está expresada en la bendición de las Shmone Esere con respecto a la "
          },
          {
            "bbox": [
              53.858001708984375,
              438.31597900390625,
              442.3309631347656,
              449.57598876953125
            ],
            "ids": [
              [
                10,
                13
              ]
            ],
            "text": "fidelidad de HaShem al revivir a los muertos, en donde decimos, “Él mantiene "
          },
          {
            "bbox": [
              53.858001708984375,
              452.0959777832031,
              316.4479675292969,
              462.2659912109375
            ],
            "ids": [
              [
                10,
                14
              ]
            ],
            "text": "Su emuná hacia aquellos que duermen en el polvo”."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          82.25799560546875,
          469.9449768066406,
          411.35296630859375,
          515.5150146484375
        ],
        "lines": [
          {
            "bbox": [
              82.25799560546875,
              469.9449768066406,
              411.33984375,
              479.5149841308594
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "Anteriormente el Rabí Natán trató sobre el papel esencial que juega en el "
          },
          {
            "bbox": [
              82.25799560546875,
              481.93499755859375,
              411.35296630859375,
              492.10498046875
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "despertar el aspecto de la guevurá de la “plegaria de juicio” del Tzadik. Aquí "
          },
          {
            "bbox": [
              82.25799560546875,
              493.7049865722656,
              411.3499755859375,
              503.4649963378906
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "demuestra que esto tiene su paralelo en el papel del kadish en el iortzait, en "
          },
          {
            "bbox": [
              82.25799560546875,
              505.9449768066406,
              357.34796142578125,
              515.5150146484375
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "el hecho de “despertar” las almas de los progenitores fallecidos."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.857994079589844,
          523.4549560546875,
          442.3310852050781,
          569.594970703125
        ],
        "lines": [
          {
            "bbox": [
              82.25799560546875,
              523.4549560546875,
              442.3131103515625,
              533.60498046875
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "Es por ello que comenzamos la bendición: “Que resucita a los difuntos” "
          },
          {
            "bbox": [
              53.857994079589844,
              535.4549560546875,
              442.3210754394531,
              545.594970703125
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "con “Tú eres poderoso eternamente, Dios”. Pues la resurrección de los muertos "
          },
          {
            "bbox": [
              53.857994079589844,
              547.4549560546875,
              442.3310852050781,
              557.60498046875
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "es esencialmente la misma idea del jidush haolam, que se produce a través de "
          },
          {
            "bbox": [
              53.85801696777344,
              559.4549560546875,
              442.3309326171875,
              569.594970703125
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "la plegaria de din asociada con las guevurot, como se explicó más arriba.[77] Por lo "
          }
        ]
      },

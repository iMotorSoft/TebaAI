              445.0749206542969,
              243.14498901367188
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "cuerpo en relación al alimento del alma, como se explica en la lección del "
          },
          {
            "bbox": [
              56.692901611328125,
              244.88499450683594,
              445.1593017578125,
              255.14498901367188
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "Rebe.[82]Estudia bien la lección del comienzo al fi nal y luego, con la ayuda de "
          },
          {
            "bbox": [
              56.69232177734375,
              257.0049743652344,
              281.0123596191406,
              267.1549987792969
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "HaShem comprenderás lo que hemos tratado."
          }
        ]

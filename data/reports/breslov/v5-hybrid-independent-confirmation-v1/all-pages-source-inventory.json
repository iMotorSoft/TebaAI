          },
          {
            "bbox": [
              85.09290313720703,
              429.4129638671875,
              348.60186767578125,
              438.98297119140625
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "traer el Or HaPanim sobre nosotros y sobre nuestros hogares."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          56.69293212890625,
          447.10198974609375,
          445.1711730957031,
          541.072021484375
        ],
        "lines": [
          {
            "bbox": [

              442.3250732421875,
              374.16998291015625
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "La regla general derivada de la lección del Rebe es que cada persona debe "
          },
          {
            "bbox": [
              53.858062744140625,
              376.01995849609375,
              442.3310852050781,
              386.16998291015625
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "buscar persistentemente a un verdadero rav, de una grandeza tal que será capaz "
          },
          {
            "bbox": [
              53.85804748535156,
              388.17901611328125,
              282.14239501953125,
              398.15997314453125
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "de iluminarla con percepciones de Divinidad.[1]"
          }
        ]
      },

              379.041015625,
              440.4109802246094,
              386.3690185546875
            ],
            "ids": [
              [
                12,
                6
              ]
            ],
            "text": "muchas, Tu consuelo "
          },
          {
            "bbox": [
              364.8190002441406,
              388.6410217285156,
              421.7070007324219,
              396.2970275878906
            ],

              502.5589904785156,
              351.7870178222656,
              512.5399780273438
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "completamente conectado y unido con HaShem.[14]Pues "
          },
          {
            "bbox": [
              56.6929931640625,
              512.7799682617188,
              351.7010192871094,
              524.5399780273438
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "“HaShem es bueno para todo” - Él es todo lo que es bueno, el "
          },
          {
            "bbox": [
              56.6929931640625,
              526.3999633789062,
              351.7869567871094,
              536.5399780273438
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "origen y la esencia de todo lo bueno que existe. Esto es también "
          }
        ]
      },

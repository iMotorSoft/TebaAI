            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "origen de todas las fuerzas espirituales negativas de las cuales "
          },
          {
            "bbox": [
              56.69290542602539,
              635.8164672851562,
              245.33065795898438,
              644.1189575195312

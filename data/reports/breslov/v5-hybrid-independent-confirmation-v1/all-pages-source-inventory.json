            "bbox": [
              252.61399841308594,
              620.971435546875,
              441.2686767578125,
              627.782958984375
            ],
            "ids": [
              [
                9,
                25
              ]
            ],
            "text": "mucho más esfuerzo para cambiar que para mantener un "
          },

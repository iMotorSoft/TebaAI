              46.55439758300781,
              280.3248596191406,
              53.978397369384766
            ],
            "ids": [
              [
                0,
                0
              ]
            ],
            "text": "APÉNDICE A      UNA RESEÑA KABALÍSTICA DE LA CREACIÓN"
          }
        ]
      },
      {
        "index": 1,
        "class": "page-header",
        "bbox": [
          351.63800048828125,
          48.250152587890625,
          441.9107666015625,
          54.962154388427734
        ],
        "lines": [
          {
            "bbox": [
              351.63800048828125,
              48.250152587890625,
              441.9107666015625,
              54.962154388427734
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "  LIKUTEY HALAJOT 227"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          56.69287109375,
          70.7560043334961,
          445.077880859375,
          128.8780975341797
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              70.7560043334961,
              445.077880859375,
              80.71600341796875
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "no esté imbuida en toda la creación. Pues nada puede existir sin la Divinidad que lo "
          },
          {
            "bbox": [
              56.692901611328125,
              80.95600128173828,
              445.072998046875,
              92.71600341796875
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "sustenta. Por lo tanto HaShem debe estar en ese Espacio. Pero si Él está allí, entonces "
          },
          {
            "bbox": [
              56.692901611328125,
              94.7560043334961,
              445.054931640625,
              104.71600341796875
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "no está vacío; ¡no es un Espacio Vacío! De modo que HaShem no debe estar allí. Y "
          },
          {
            "bbox": [
              56.692901611328125,
              104.95600128173828,
              445.0738525390625,
              116.89334869384766
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "aun así es imposible decir que Él no está allí, como afirma el Tikuney Zohar (#57, p. "
          },
          {
            "bbox": [
              56.69287109375,
              116.95600128173828,
              379.702880859375,
              128.8780975341797
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "91b), “No hay lugar vacío de Él”. Ésta es la paradoja del jalal hapanui."
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          56.69287109375,
          136.53500366210938,
          445.1119079589844,
          242.385009765625
        ],
        "lines": [
          {
            "bbox": [
              85.0928955078125,
              136.53500366210938,
              445.0629577636719,
              146.385009765625
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Por lo tanto los kabalistas explican que la imagen de HaShem retrayendo "
          },
          {
            "bbox": [
              56.692893981933594,
              148.53500366210938,
              445.06280517578125,
              158.385009765625
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "Su Luz no debe ser tomada de manera literal. El Espacio primordial dejado luego "
          },
          {
            "bbox": [
              56.692893981933594,
              160.203857421875,
              445.1119079589844,
              170.56236267089844
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "del tzimtzum no quedó enteramente vacío del Or Ein Sof. En su lugar, HaShem "
          },
          {
            "bbox": [
              56.69287109375,
              172.53500366210938,
              445.0638427734375,
              182.385009765625
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "existe en todas partes igualmente y en todo momento. El hecho de retirar Su Luz "
          },
          {
            "bbox": [
              56.69287109375,
              184.18096923828125,
              445.07177734375,
              194.54710388183594
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "del jalal hapanui para “hacerle lugar” a la Creación no implica de manera alguna "
          },
          {
            "bbox": [
              56.69287872314453,
              194.62501525878906,
              445.0577392578125,
              206.385009765625
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "que Él no está más allí. HaShem estuvo y está “allí” tanto antes como después de "
          },
          {
            "bbox": [
              56.69287872314453,
              208.4250030517578,
              445.0596618652344,
              218.385009765625
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "haber creado el Espacio Vacío, antes y después de haber introducido en él el Rayo "
          },
          {
            "bbox": [
              56.69287872314453,
              220.4250030517578,
              445.0648193359375,
              230.385009765625
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "de Luz que se volvería las miríadas sobre miríadas de mundos que paradójicamente "
          },
          {
            "bbox": [
              56.69287872314453,
              232.4250030517578,
              145.0748748779297,
              242.385009765625
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "poblarían el Vacío."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          56.69287109375,
          250.0721893310547,
          445.08087158203125,
          380.21710205078125
        ],
        "lines": [
          {
            "bbox": [
              85.09288024902344,
              250.0721893310547,
              445.06695556640625,
              260.0550231933594
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Otra manera de comprender el tzimtzum es como un ocultamiento de la Luz "
          },
          {
            "bbox": [
              56.69288635253906,
              262.0721740722656,
              444.40191650390625,
              272.0550231933594
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "y no tanto como su retracción. No tiene sentido decir de algún aspecto del Ein "
          },
          {
            "bbox": [
              56.692901611328125,
              273.8738708496094,
              445.0689392089844,
              284.23236083984375
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "Sof, ni siquiera del Ein Sof en Su manifestación, que se encontraba en un modo "
          },
          {
            "bbox": [
              56.692901611328125,
              286.09503173828125,
              445.06292724609375,
              296.0550231933594
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "antes de la Creación y en otro luego de la Creación. La explicación es que antes "
          },
          {
            "bbox": [
              56.692901611328125,
              297.8738708496094,
              445.0749206542969,
              308.23236083984375
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "del tzimtzum no habría sido posible que lo creado soportara la Luz del Ein Sof tal "
          },
          {
            "bbox": [
              56.692901611328125,
              309.8738708496094,
              445.074951171875,
              320.23236083984375
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "cual era entonces. El tzimtzum cambió esto en el hecho de que el Ein Sof oscureció "
          },
          {
            "bbox": [
              56.69287109375,
              322.09503173828125,
              445.08087158203125,
              332.0550231933594
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "y ocultó Su Luz con abundantes coberturas, de modo que los mundos y todos los "
          },
          {
            "bbox": [
              56.69287109375,
              334.20501708984375,
              445.0658874511719,
              344.0550231933594
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "seres creados pudieron soportar la intensidad disminuida de la Luz. El punto es que "
          },
          {
            "bbox": [
              56.69287109375,
              345.8738708496094,
              445.075927734375,
              356.23236083984375
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "no hubo absolutamente ningún cambio en ningún aspecto del Or Ein Sof, sino sólo "
          },
          {
            "bbox": [
              56.69287109375,
              358.09503173828125,
              445.07806396484375,
              368.0550231933594
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "en la capacidad de la creación para percibirla. Es desde el punto de vista del hombre "
          },
          {
            "bbox": [
              56.69287109375,
              369.9043884277344,
              159.3788604736328,
              380.21710205078125
            ],
            "ids": [
              [
                4,
                10
              ]
            ],
            "text": "que el jalal está panui."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.69286346435547,
          387.7640380859375,
          445.0801696777344,
          491.4739685058594
        ],
        "lines": [
          {
            "bbox": [
              85.09286499023438,
              387.7640380859375,
              445.0729675292969,
              397.7240295410156
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "Así, la diferencia entre “antes” y “después” sólo existe desde nuestro punto "
          },
          {
            "bbox": [
              56.69286346435547,
              399.5733947753906,
              444.3998718261719,
              409.7240295410156
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "de vista - pues el mundo entero fue creado sólo en aras de la humanidad. El Ari zal "
          },
          {
            "bbox": [
              56.69287109375,
              411.7640380859375,
              445.0628967285156,
              421.7240295410156
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "amplía nuestra comprensión, enseñando que HaShem creó el Espacio Vacío para "
          },
          {
            "bbox": [
              56.69287109375,
              423.7430114746094,
              445.0801696777344,
              431.4740295410156
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "darle al hombre libertad de elección.[2] HaShem ciertamente existe dentro de toda "
          },
          {
            "bbox": [
              56.69300842285156,
              435.76397705078125,
              445.05609130859375,
              445.7239685058594
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "la creación, pues sin Divinidad nada puede existir. Pero si la existencia de HaShem "
          },
          {
            "bbox": [
              56.69300842285156,
              447.76397705078125,
              445.0732116699219,
              457.7239685058594
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "fuese clara y obvia en este mundo el hombre no tendría libertad de elección. Por este "
          },
          {
            "bbox": [
              56.69300842285156,
              459.76397705078125,
              445.0760498046875,
              469.7239685058594
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "motivo, HaShem constriñó Su Luz, si así pudiera decirse, para ocultar del hombre Su "
          },
          {
            "bbox": [
              56.69300842285156,
              471.76397705078125,
              445.0679626464844,
              481.88604736328125
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "Presencia Inmanente y hacer que parezca como que hay un Vacío, un lugar carente "
          },
          {
            "bbox": [
              56.69300842285156,
              483.87396240234375,
              119.90301513671875,
              491.4739685058594
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "de Divinidad."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.6929931640625,
          501.1889343261719,
          445.0820007324219,
          593.1429443359375
        ],
        "lines": [
          {
            "bbox": [
              85.09300994873047,
              501.1889343261719,
              445.073974609375,
              511.5550537109375
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Veremos a continuación que el tzimtzum y el jalal hapanui son también la "
          },
          {
            "bbox": [
              56.6929931640625,
              513.4329223632812,
              445.0650939941406,
              523.3929443359375
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "respuesta a la pregunta de cómo lo finito emerge del infinito y la multiplicidad de "
          },
          {
            "bbox": [
              56.6929931640625,
              525.2346801757812,
              445.07501220703125,
              535.3929443359375
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "la unidad. El Ari zal explica que el tzimtzum fue necesario para crear los keilim, los "
          },
          {
            "bbox": [
              56.693023681640625,
              537.4329223632812,
              445.0820007324219,
              547.3929443359375
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "recipientes que retienen la Luz, y que sirven como las estructuras básicas del mundo "
          },
          {
            "bbox": [
              56.693023681640625,
              549.2346801757812,
              445.0710754394531,
              559.3929443359375
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "creado. Los keilim son de hecho también Luz, pero de un orden menor o más denso. "
          },
          {
            "bbox": [
              56.693023681640625,
              561.2346801757812,
              444.4000549316406,
              571.3929443359375
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "Los primeros keilim de la creación estaban compuestos de un remanente del Or Ein "
          },
          {
            "bbox": [
              56.693023681640625,
              573.2117919921875,
              445.0771484375,
              583.5703125
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "Sof dejado en el Espacio Vacío luego del tzimtzum. Los kabalistas llaman a estos "
          },
          {
            "bbox": [
              56.693023681640625,
              585.1889038085938,
              164.48001098632812,
              593.1429443359375
            ],
            "ids": [
              [
                6,
                7
              ]
            ],
            "text": "remanentes el reshimu."
          }
        ]
      },
      {

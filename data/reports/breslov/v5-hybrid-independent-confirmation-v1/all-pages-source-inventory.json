          286.188232421875,
          230.85098266601562
        ],
        "lines": [
          {
            "bbox": [
              207.0399932861328,
              222.79298400878906,
              286.188232421875,
              230.85098266601562
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "���������������������������Likutey Halajot Explicado"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          82.25830078125,
          244.15298461914062,
          411.3492431640625,
          278.4329833984375
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              244.15298461914062,
              411.3304443359375,
              253.96298217773438
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "El Rabí Natán agrega un beneficio adicional al recitado del Kriat Shemá al "
          },
          {
            "bbox": [
              82.25830078125,
              256.3929748535156,
              411.3492431640625,
              266.552978515625
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "HaMita: la adquisición de guevurá, de la fuerza necesaria para levantarse en "
          },
          {
            "bbox": [
              82.25830078125,
              268.1529846191406,
              315.3252868652344,
              278.4329833984375
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "jatzot y recitar las kinot, las elegías, en el Tikún Jatzot."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.857208251953125,
          285.70166015625,
          442.3353576660156,
          377.7830810546875
        ],
        "lines": [
          {
            "bbox": [
              82.25828552246094,
              285.70166015625,
              442.2402038574219,
              296.0429992675781
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Y debido a esto -i.e., al recitado del Kriat Shemá al HaMita y al unirse con "
          },
          {
            "bbox": [
              53.858245849609375,
              297.9029846191406,
              442.3163757324219,
              308.0429992675781
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "los Tzadikim- la persona será capaz de sobreponerse al sueño para levantarse "
          },
          {
            "bbox": [
              53.858245849609375,
              310.1929931640625,
              442.3353576660156,
              320.0429992675781
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "a medianoche y servir a HaShem. Pues la esencia de levantarse a medianoche "
          },
          {
            "bbox": [
              53.858245849609375,
              322.1929931640625,
              442.3302307128906,
              332.0530090332031
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "surge del poder de esos Tzadikim que pueden elevar una plegaria de din. Desde "
          },
          {
            "bbox": [
              53.858245849609375,
              333.70166015625,
              439.3692626953125,
              344.0530090332031
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "ese atributo de guevurá se extiende “la llama que golpea las alas del gallo”, el"
          },
          {
            "bbox": [
              53.857208251953125,
              344.10308837890625,
              442.2380676269531,
              356.0430908203125
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "que entonces canta a medianoche.[42] Éste es el signifi cado de la ascensión en ese "
          },
          {
            "bbox": [
              53.8580322265625,
              358.1930847167969,
              442.3291320800781,
              368.0430908203125
            ],
            "ids": [
              [
                8,
                6
              ]
            ],
            "text": "momento de las guevurot, debido a lo cual la gente se levanta a medianoche y "
          },
          {
            "bbox": [
              53.8580322265625,
              369.903076171875,
              275.3377990722656,
              377.7830810546875
            ],
            "ids": [
              [
                8,
                7
              ]
            ],
            "text": "lamenta la destrucción del Beit HaMikdash.[43]"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          82.2582015991211,
          387.4920654296875,
          411.3302307128906,
          409.7720642089844
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              387.4920654296875,
              411.3302307128906,
              397.30206298828125
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "El Rabí Natán explica a continuación el significado del recitado del Tikún "
          },
          {
            "bbox": [
              82.25820922851562,
              398.1620788574219,
              353.6361999511719,
              409.7720642089844
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "Jatzot: extraer el daat y toda la santidad tragada por Sitra Ájara."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.85723876953125,
          417.42108154296875,
          349.5032958984375,
          545.1309814453125
        ],
        "lines": [
          {
            "bbox": [
              82.25820922851562,
              417.42108154296875,
              349.40728759765625,
              426.65106201171875
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "De hecho, todas las kinot recitadas debido a la destrucción "
          },
          {
            "bbox": [
              53.85823059082031,
              429.1770324707031,
              349.4963073730469,
              439.3810729980469
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "del Beit HaMikdash comparten las características de la plegaria "
          },
          {
            "bbox": [
              53.85823059082031,
              441.52105712890625,
              349.5032958984375,
              451.3810729980469
            ],
            "ids": [
              [
                10,
                2
              ]
            ],
            "text": "de din, pues el llorar y el lamentar son manifestaciones de los "
          },
          {
            "bbox": [
              53.85823059082031,
              453.53106689453125,
              349.4952087402344,
              463.3810729980469
            ],
            "ids": [
              [
                10,
                3
              ]
            ],
            "text": "dinim y de las guevurot. Por lo tanto, en las kinot, disputamos "
          },
          {
            "bbox": [
              53.85723876953125,
              465.52105712890625,
              349.4913024902344,
              475.3810729980469
            ],
            "ids": [
              [
                10,
                4
              ]
            ],
            "text": "con fuerza con HaShem y demandamos Su justicia. Por "
          },
          {
            "bbox": [
              53.85723876953125,
              477.07025146484375,
              349.4972229003906,
              487.3910827636719
            ],
            "ids": [
              [
                10,
                5
              ]
            ],
            "text": "ejemplo, decimos en el Tikún Jatzot, “¿Por qué, HaShem, nos "
          },
          {
            "bbox": [
              53.85723876953125,
              489.2410583496094,
              349.4902648925781,
              499.3810729980469
            ],
            "ids": [
              [
                10,
                6
              ]
            ],
            "text": "permites errar de Tus caminos y endurecer nuestro corazón "
          },
          {
            "bbox": [
              53.85723876953125,
              501.2410583496094,
              349.4942626953125,
              511.3810729980469
            ],
            "ids": [
              [
                10,
                7
              ]
            ],
            "text": "para no temerte?”. Y preguntamos, “¿Donde están Tus celos "
          },
          {
            "bbox": [
              53.85723876953125,
              513.2410888671875,
              349.4972229003906,
              523.381103515625
            ],
            "ids": [
              [
                10,
                8
              ]
            ],
            "text": "y Tus obras potentes? ¡Acaso se ha reducido la conmoción de "
          },
          {
            "bbox": [
              53.85723876953125,
              525.2410888671875,
              349.4970397949219,
              535.381103515625
            ],
            "ids": [
              [
                10,
                9
              ]
            ],
            "text": "Tus entrañas y de Tu compasión hacia mí!…”.[44]Y en verdad, "
          },
          {
            "bbox": [
              53.858001708984375,
              537.2227172851562,
              281.2400817871094,
              545.1309814453125
            ],
            "ids": [
              [
                10,
                10
              ]
            ],
            "text": "muchas de las kinot continúan de esta manera."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          355.03900146484375,
          421.1519775390625,
          441.74298095703125,
          533.912109375
        ],
        "lines": [
          {

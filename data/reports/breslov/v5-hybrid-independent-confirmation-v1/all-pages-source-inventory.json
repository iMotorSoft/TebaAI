            "bbox": [
              56.692901611328125,
              445.3370056152344,
              445.0649719238281,
              455.2969970703125
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "no podía escribir sobre ellas debido a circunstancias externas, seguía el consejo del "
          },
          {
            "bbox": [
              56.692901611328125,
              457.3370056152344,
              445.0730285644531,
              467.2969970703125
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "Rebe Najmán de no detenerse. Continuaba al próximo grupo de leyes y comenzaba "
          },
          {
            "bbox": [
              56.692901611328125,
              469.4469909667969,
              105.42290496826172,
              477.0469970703125
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "de nuevo. "
          }
        ]
      },

          },
          {
            "bbox": [
              256.26873779296875,
              562.7972412109375,
              444.9323425292969,
              569.6087646484375
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "relato de la Creación que se encuentra en la Torá, demostrando "
          },
          {
            "bbox": [
              256.26873779296875,
              571.7972412109375,
              444.9086608886719,
              578.6087646484375
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "que el mundo existe en mérito a los korbanot. Con el correr del "
          },
          {
            "bbox": [
              256.2687683105469,
              580.7972412109375,
              444.9317321777344,
              587.6234130859375
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "tiempo, esta colección de plegarias especiales y de lecturas de "
          },
          {
            "bbox": [
              256.2687683105469,
              589.7972412109375,
              393.48052978515625,
              596.6234130859375
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "la Torá llegó a ser conocida como Maamadot."
          }
        ]
      },

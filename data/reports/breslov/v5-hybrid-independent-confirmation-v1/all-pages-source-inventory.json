          },
          {
            "bbox": [
              53.858009338378906,
              360.51995849609375,
              354.1709899902344,
              369.6899719238281
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "esas constricciones, HaShem, “Su Marido”, es conocido en "
          },
          {
            "bbox": [

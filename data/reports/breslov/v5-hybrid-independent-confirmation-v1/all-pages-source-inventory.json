              593.6144409179688,
              245.3449249267578,
              600.4406127929688
            ],
            "ids": [
              [
                15,
                10
              ]
            ],
            "text": "34 Ver §6 de la lección del Rebe. Ver también LM I, 62:7 y "
          },
          {
            "bbox": [
              56.69364929199219,
              602.6144409179688,
              112.73365020751953,
              607.9244995117188
            ],
            "ids": [
              [
                15,
                11
              ]
            ],
            "text": "notas 125-134 allí."
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          56.69364929199219,
          611.6144409179688,
          245.34124755859375,
          645.4259643554688
        ],
        "lines": [
          {
            "bbox": [
              56.69364929199219,
              611.6144409179688,
              245.32916259765625,
              618.4406127929688
            ],
            "ids": [
              [
                15,
                12
              ]
            ],
            "text": "35 Tikuney Zohar #67, p. 97b; Zohar III, 198b. La Kabalá "
          },
          {
            "bbox": [
              56.69441223144531,
              619.1394653320312,
              245.32769775390625,
              627.4419555664062
            ],
            "ids": [
              [
                15,
                13
              ]
            ],
            "text": "enseña que, por la noche Maljut, la sefi rá que es sinónimo de "
          },
          {
            "bbox": [
              56.69366455078125,
              629.6144409179688,
              245.34124755859375,
              636.4406127929688
            ],
            "ids": [
              [
                15,
                14
              ]
            ],
            "text": "la Shejiná, desciende a los mundos inferiores para redimir las "
          },
          {
            "bbox": [
              56.693668365478516,
              638.6144409179688,
              245.3412322998047,
              645.4259643554688
            ],
            "ids": [
              [
                15,
                15
              ]
            ],
            "text": "chispas de santidad que han caído allí debido a los pecados "
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          255.4496612548828,
          503.61444091796875,
          444.1103210449219,
          589.9244995117188
        ],
        "lines": [
          {
            "bbox": [
              255.4496612548828,
              503.61444091796875,
              444.0828857421875,
              510.42596435546875
            ],
            "ids": [
              [
                16,
                0
              ]
            ],
            "text": "de la humanidad (Shaar HaKavanot, Drushei HaAmidá 2; ver "
          },
          {
            "bbox": [
              255.45040893554688,
              511.13946533203125,
              444.0836181640625,
              519.4419555664062
            ],
            "ids": [
              [
                16,
                1
              ]
            ],
            "text": "también ibid. Drushei HaLaila 4). Maljut también se identifi ca "
          },
          {
            "bbox": [
              255.45114135742188,
              521.6144409179688,
              444.1035461425781,
              528.4406127929688
            ],
            "ids": [
              [
                16,
                2
              ]
            ],
            "text": "con la emuná, pues al aceptar el Reinado y la Soberanía de "
          },
          {
            "bbox": [
              255.4511260986328,
              529.2411499023438,
              444.0887451171875,
              537.4259643554688
            ],
            "ids": [
              [
                16,
                3
              ]
            ],
            "text": "HaShem, uno demuestra su emuná en Él (ver LM I, 35:5). Así, "
          },
          {
            "bbox": [
              255.45111083984375,
              539.6144409179688,
              444.0997619628906,
              546.4259643554688
            ],
            "ids": [
              [
                16,
                4
              ]
            ],
            "text": "en un mundo oscurecido por el pecado, se dice que la fe está "
          },
          {
            "bbox": [
              255.45111083984375,
              548.6144409179688,
              442.2078552246094,
              555.4406127929688
            ],
            "ids": [
              [
                16,
                5
              ]
            ],
            "text": "atrapada entre las fuerzas del mal. Pero a medianoche, Maljut/"
          },
          {
            "bbox": [
              255.45111083984375,
              557.6144409179688,
              444.0806579589844,
              564.4406127929688
            ],
            "ids": [
              [
                16,
                6
              ]
            ],
            "text": "la Shejiná/emuná comienza a ascender (ibid. Drushei HaLaila "
          },
          {
            "bbox": [
              255.45115661621094,
              566.6144409179688,
              444.1058349609375,
              573.4259643554688
            ],
            "ids": [
              [
                16,
                7
              ]
            ],
            "text": "3), particularmente a través de las devociones espirituales de "
          },
          {
            "bbox": [
              255.45115661621094,
              575.6144409179688,
              444.1103210449219,
              582.4259643554688
            ],
            "ids": [
              [
                16,
                8
              ]
            ],
            "text": "aquellos que, como explicará el Rabí Natán, “despiertan el "
          },
          {
            "bbox": [
              255.45115661621094,
              584.6144409179688,
              273.151123046875,
              589.9244995117188
            ],
            "ids": [
              [
                16,
                9
              ]
            ],
            "text": "alba”."
          }
        ]
      },
      {
        "index": 14,
        "class": "text",
        "bbox": [
          255.45115661621094,
          593.6144409179688,
          444.1029357910156,
          634.9244995117188
        ],
        "lines": [
          {
            "bbox": [
              255.45115661621094,
              593.6144409179688,
              444.0821533203125,
              600.4406127929688
            ],
            "ids": [
              [
                16,
                10
              ]
            ],
            "text": "36 Ver más arriba, p. 90, nota 24, que la luz del shajar es "
          },
          {
            "bbox": [
              255.451904296875,
              602.6144409179688,
              444.0895690917969,
              609.4406127929688
            ],
            "ids": [
              [
                16,
                11
              ]
            ],
            "text": "llamada Aielet HaShajar. En el léxico de la Kabalá, Aielet "
          },
          {
            "bbox": [
              255.45187377929688,
              611.6144409179688,
              444.0821228027344,
              618.4406127929688
            ],
            "ids": [
              [
                16,
                12
              ]
            ],
            "text": "HaShajar es una apelación para la Shejiná (Zohar II, 19b), es "
          },
          {
            "bbox": [
              255.45265197753906,
              619.1394653320312,
              444.1029357910156,
              627.4419555664062
            ],
            "ids": [
              [
                16,
                13
              ]
            ],
            "text": "decir Maljut, cuya rectifi cación y retorno a la plenitud se lleva "
          },
          {
            "bbox": [
              255.45266723632812,
              629.6144409179688,
              311.05755615234375,
              634.9244995117188
            ],
            "ids": [
              [
                16,
                14
              ]
            ],
            "text": "a cabo con el alba."
          }
        ]
      }
    ]

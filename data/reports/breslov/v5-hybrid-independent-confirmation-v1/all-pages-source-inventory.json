          }
        ]
      },
      {
        "index": 1,
        "class": "page-header",
        "bbox": [
          53.858299255371094,
          47.827545166015625,
          137.24227905273438,
          54.539546966552734
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              47.827545166015625,

              245.3351593017578,
              412.84161376953125
            ],
            "ids": [
              [
                8,
                6
              ]
            ],
            "text": "Rashbi 105 y siguientes). Las mitzvot que lleva a cabo un judío "
          },
          {
            "bbox": [
              56.69288635253906,
              415.01544189453125,
              206.03289794921875,
              421.84161376953125
            ],
            "ids": [
              [
                8,
                7
              ]
            ],
            "text": "son el vehículo principal para generar esta unión. "
          }
        ]
      },
      {
        "index": 9,

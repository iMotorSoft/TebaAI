                0
              ]
            ],
            "text": "8   LIKUTEY HALAJOT"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          53.85809326171875,
          70.85540771484375,
          442.1850280761719,
          226.04559326171875
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              70.85540771484375,
              442.1585998535156,
              80.86712646484375
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "Todo aquel que disponga su corazón para estudiar verdaderamente las "
          },
          {
            "bbox": [
              53.85850143432617,
              84.055419921875,
              442.15191650390625,
              94.045654296875
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "incomparables enseñanzas del Rebe, que son más profundas que los más hondos abismos "
          },
          {
            "bbox": [
              53.85850143432617,
              97.25543212890625,
              442.1618347167969,
              107.26715087890625
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "y más anchas que el mar, y que se avoque a estas nuevas ideas y explicaciones de las "
          },
          {
            "bbox": [
              53.85850143432617,
              110.4554443359375,
              442.1575012207031,
              120.4671630859375
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "enseñanzas que HaShem con gracia me ha otorgado revelar, comprenderá muy bien "
          },
          {
            "bbox": [
              53.85850143432617,
              123.65545654296875,
              442.1651306152344,
              133.66717529296875
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "que, considerando su asombrosa profundidad, aún no las he llegado a aclarar de manera "
          },
          {
            "bbox": [
              53.85850143432617,
              134.84130859375,
              442.1850280761719,
              146.845703125
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "adecuada. Éste es el caso, incluso allí, en donde he explicado el tema extendiéndome "
          },
          {
            "bbox": [
              53.85850143432617,
              150.0552978515625,
              442.1538391113281,
              160.06719970703125
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "considerablemente y por ciertoen aquellas instancias en que hube de ser conciso. Debes "
          },
          {
            "bbox": [
              53.85809326171875,
              163.25531005859375,
              442.1217956542969,
              173.24554443359375
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "saber que todas las enseñanzas que el Rebe reveló son enteramente nuevas hakdamot "
          },
          {
            "bbox": [
              53.85809326171875,
              176.455322265625,
              442.163818359375,
              186.467041015625
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "(sin embargo y aunque todas se basan en las mitzvot de la Torá recibidas de antaño, "
          },
          {
            "bbox": [
              53.85809326171875,
              189.65533447265625,
              442.1680603027344,
              199.66705322265625
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "son principios introductorios completamente originales). Todas presentan un asombroso "
          },
          {
            "bbox": [
              53.85809326171875,
              202.8499755859375,
              442.1735534667969,
              212.8670654296875
            ],
            "ids": [
              [
                1,
                10
              ]
            ],
            "text": "consejo y guía sobre cómo acercarse a HaShem, para cada persona a partir del nivel "
          },
          {
            "bbox": [
              53.85809326171875,
              216.05535888671875,
              199.8721160888672,
              226.04559326171875
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "espiritual en el cual se encuentre."
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.858089447021484,
          232.09005737304688,
          442.1889953613281,
          321.3018493652344
        ],
        "lines": [
          {
            "bbox": [
              82.25788879394531,
              232.09005737304688,
              442.16363525390625,
              242.08029174804688
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "Nuestra principal intención debe ser el poner en práctica estas enseñanzas con "
          },
          {
            "bbox": [
              53.858089447021484,
              245.29006958007812,
              442.17034912109375,
              255.30178833007812
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "simpleza, tal como ellas surgieron de los labios del Rebe con sinceridad y simplicidad. "
          },
          {
            "bbox": [
              53.858089447021484,
              258.4900817871094,
              442.1658020019531,
              268.5018005371094
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "Sin embargo, debido a nuestra materialidad y a la opacidad de nuestras mentes, es "
          },
          {
            "bbox": [
              53.858089447021484,
              271.6900939941406,
              442.1889953613281,
              281.7018127441406
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": "extremadamente difícil y oneroso el imbuir la sinceridad y la simpleza de esas enseñanzas "
          },
          {
            "bbox": [
              53.858089447021484,
              284.8901062011719,
              442.172607421875,
              294.9018249511719
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "en el corazón de la gente. Ello se debe a que el intelecto humano se inclina hacia los "
          },
          {
            "bbox": [
              53.858089447021484,
              298.0847473144531,
              442.1625671386719,
              308.1018371582031
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "saberes mundanos, que en su mayor parte extravían el corazón alejándolo de la verdad "
          },
          {
            "bbox": [
              53.858089447021484,
              311.2901306152344,
              279.62213134765625,
              321.3018493652344
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "esencial implícita en la simpleza y en la sinceridad."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          53.857818603515625,
          327.32373046875,
          442.1816711425781,
          482.5360107421875
        ],
        "lines": [
          {
            "bbox": [
              82.25788879394531,
              327.32373046875,
              442.1519775390625,
              337.31451416015625
            ],
            "ids": [
              [
                1,
                19
              ]
            ],
            "text": "Esto es en especial asíen lo que respecta a las enseñanzas del Rebe, dado que "
          },
          {
            "bbox": [
              53.858612060546875,
              340.5242919921875,
              442.1476135253906,
              350.5360107421875
            ],
            "ids": [
              [
                1,
                20
              ]
            ],
            "text": "en verdad su sinceridad y simpleza son insondables, “profundas, profundas, ¿quién "
          },
          {
            "bbox": [
              53.858612060546875,
              353.3652038574219,
              442.155029296875,
              363.7359924316406
            ],
            "ids": [
              [
                1,
                21
              ]
            ],
            "text": "puede discernirlas?”.[21] En cada cosa que él reveló hay montañas de Halajot (discursos), "
          },
          {
            "bbox": [
              53.85829162597656,
              364.760986328125,
              442.1159362792969,
              376.93798828125
            ],
            "ids": [
              [
                1,
                22
              ]
            ],
            "text": "“profundos manantiales fl uyendo en el valle y en el monte”.[22] Pues sus enseñanzas son "
          },
          {
            "bbox": [
              53.857818603515625,
              380.1243896484375,
              442.1589050292969,
              390.1361083984375
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "como una fuente surgente, como el lector podrá percibir en los lugares en que HaShem "
          },
          {
            "bbox": [
              53.857818603515625,
              393.32427978515625,
              442.1354064941406,
              403.33612060546875
            ],
            "ids": [
              [
                1,
                24
              ]
            ],
            "text": "ha sido bueno y me ha permitido encontrar asombrosas y tremendas ideas, al igual que la "
          },
          {
            "bbox": [
              53.858489990234375,
              406.5242919921875,
              442.18048095703125,
              416.5145263671875
            ],
            "ids": [
              [
                1,
                25
              ]
            ],
            "text": "profunda intención detrás de muchas mitzvot, expresadas en una sola enseñanza revelada "
          },
          {
            "bbox": [
              53.858489990234375,
              419.71893310546875,
              442.1210632324219,
              429.73602294921875
            ],
            "ids": [
              [
                1,
                26
              ]
            ],
            "text": "por el Rebe. Por ejemplo, la lección Sasón Vesimja Iasigu VeNasu Iagon VaAnajá (LM "
          },
          {
            "bbox": [
              53.85955810546875,
              432.92431640625,
              442.1816711425781,
              442.93603515625
            ],
            "ids": [
              [
                1,
                27
              ]
            ],
            "text": "II, 23) consiste de un solo concepto: aferrar la tristeza y la melancolía y llevarlas hacia "
          },
          {
            "bbox": [
              53.85955810546875,
              446.1189270019531,
              442.1663513183594,
              456.1360168457031
            ],
            "ids": [
              [
                1,
                28
              ]
            ],
            "text": "la alegría, como se explica allí. HaShem me ayudó e iluminó mis ojos para encontrar "
          },
          {
            "bbox": [
              53.85955810546875,
              459.32427978515625,
              442.1419677734375,
              469.33599853515625
            ],
            "ids": [
              [
                1,
                29
              ]
            ],
            "text": "muchas y asombrosas ideas en base a ésta sola hakdamá, como podrá percibir el lector "
          },
          {
            "bbox": [
              53.85955810546875,
              472.5242919921875,
              275.9319763183594,
              482.5360107421875
            ],
            "ids": [
              [
                1,
                30
              ]
            ],
            "text": "al comienzo de Even HaEzer y en otras instancias."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          53.858489990234375,
          488.5589904785156,
          442.18603515625,
          604.1710205078125
        ],
        "lines": [
          {
            "bbox": [
              82.25935363769531,
              486.39569091796875,
              442.13433837890625,
              498.57269287109375
            ],
            "ids": [
              [
                1,
                31
              ]
            ],
            "text": "Sin embargo, la principal intención sigue siendo el signifi cado simple, el "
          },
          {
            "bbox": [
              53.85955810546875,
              501.75897216796875,
              442.1827697753906,
              511.77069091796875
            ],
            "ids": [
              [
                1,
                32
              ]
            ],
            "text": "transformar la tristeza y la melancolía en alegría - en otras palabras, transformar toda "
          },
          {
            "bbox": [
              53.85955810546875,
              514.958984375,
              442.18603515625,
              524.970703125
            ],
            "ids": [
              [
                1,
                33
              ]
            ],
            "text": "la tristeza en alegría, como se explica allí. Pero aún este nivel simple -el hecho de que "
          },
          {
            "bbox": [
              53.85955810546875,
              528.1536254882812,
              442.18389892578125,
              538.1707153320312
            ],
            "ids": [
              [
                1,
                34
              ]
            ],
            "text": "uno debe trabajar para superar toda clase de tristezas y transformarlas en alegría- es algo "
          },
          {
            "bbox": [
              53.85955810546875,
              541.3590087890625,
              442.17724609375,
              551.3707275390625
            ],
            "ids": [
              [
                1,
                35
              ]
            ],
            "text": "difícil y oneroso de imbuir en el corazón de la gente. Pero HaShem me ayudó a elaborar "
          },
          {
            "bbox": [
              53.85955810546875,
              554.5589599609375,
              442.1529541015625,
              564.5706787109375
            ],
            "ids": [
              [
                1,
                36
              ]
            ],
            "text": "sobre esto y a demostrar y revelar que la observancia de todos los aspectos de la Torá "
          },
          {
            "bbox": [
              53.85955810546875,
              567.7589721679688,
              442.1773681640625,
              577.7706909179688
            ],
            "ids": [
              [
                1,
                37
              ]
            ],
            "text": "depende de ello, pues la alegría es la quintaesencia de toda la Torá y de las mitzvot. "
          },
          {
            "bbox": [
              53.85955810546875,
              578.795654296875,
              442.1399230957031,
              590.97265625
            ],
            "ids": [
              [
                1,
                38
              ]
            ],
            "text": "Al avanzar el discurso uno puede ver desde lejos el tremendo benefi cio de la alegría y "
          },
          {
            "bbox": [
              53.858489990234375,
              594.1539306640625,
              442.1805725097656,
              604.1710205078125
            ],
            "ids": [
              [
                1,
                39
              ]
            ],
            "text": "observarcuánto debemos trabajar para transformar la tristeza en alegría. Aun así, el foco "
          }
        ]
      },

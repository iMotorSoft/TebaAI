              255.44845581054688,
              594.396484375,
              444.0868835449219,
              601.22265625
            ],
            "ids": [
              [
                12,
                30
              ]
            ],
            "text": "palabras daat ( )דעתy mikdash ( )מקדשaparecen en versículos "
          },
          {

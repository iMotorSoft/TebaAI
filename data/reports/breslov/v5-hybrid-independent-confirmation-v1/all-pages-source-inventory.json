              442.2330627441406,
              365.4749755859375
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Este discurso se basa en la lección Vaiasev Elohim (LM I, 62), en la cual el "
          },
          {
            "bbox": [
              53.858123779296875,
              367.5736389160156,
              442.2401428222656,
              377.91497802734375
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "Rebe Najmán trata sobre cómo fortalecer la emuná en HaShem. Estudia allí las "
          },
          {
            "bbox": [
              53.858154296875,
              380.0649719238281,
              136.86814880371094,
              389.91497802734375
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "palabras del Rebe."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          53.85797119140625,
          394.4076232910156,
          442.33099365234375,
          476.74896240234375
        ],
        "lines": [
          {
            "bbox": [
              82.2581558227539,
              394.4076232910156,
              442.3301696777344,
              404.74896240234375
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "El Rebe aclara la distinción entre dos clases de preguntas sobre la emuná. "
          },
          {
            "bbox": [
              53.858184814453125,
              406.60894775390625,
              442.33013916015625,
              416.74896240234375
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "Hay preguntas cuya solución la persona puede comprender rápidamente. "
          },
          {
            "bbox": [
              53.858154296875,
              418.59832763671875,
              442.33099365234375,
              428.75897216796875
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "Concerniente a esto afirmaron Jazal, “Sabe qué responderle…”.[1 ]En verdad, "
          },
          {
            "bbox": [
              53.85797119140625,
              430.8989562988281,
              442.3271484375,
              440.75897216796875
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "con respecto a aquello que HaShem ha puesto dentro de la posibilidad de "
          },
          {
            "bbox": [
              53.85797119140625,
              442.60894775390625,
              442.3202209472656,
              452.74896240234375
            ],
            "ids": [
              [
                4,
                7
              ]
            ],
            "text": "comprensión de la mente humana, aguzar el intelecto para entender el tema "
          },
          {
            "bbox": [
              53.85797119140625,
              454.60894775390625,
              442.322021484375,
              464.75897216796875
            ],
            "ids": [
              [
                4,
                8
              ]
            ],
            "text": "es claramente una gran mitzvá. Por lo tanto el dicho: “Sabe qué responderle a "
          },
          {
            "bbox": [
              53.85797119140625,
              466.8989562988281,
              108.17797088623047,
              476.74896240234375
            ],
            "ids": [
              [
                4,
                9
              ]
            ],
            "text": "un hereje”."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.85797119140625,
          481.4439697265625,
          353.9150390625,
          527.593994140625
        ],
        "lines": [
          {
            "bbox": [
              82.25797271728516,
              481.4439697265625,
              353.9150390625,
              491.583984375
            ],
            "ids": [
              [
                4,
                10
              ]
            ],
            "text": "Pero también hay preguntas cuya solución es insondable "
          },
          {
            "bbox": [
              53.85797119140625,
              493.4439697265625,
              353.9061279296875,
              503.583984375
            ],
            "ids": [
              [
                4,
                11
              ]
            ],
            "text": "para el intelecto humano. Sólo en el futuro será revelada "
          },
          {
            "bbox": [
              53.85797119140625,
              505.6029968261719,
              353.91107177734375,
              515.583984375
            ],
            "ids": [
              [
                4,
                12
              ]
            ],
            "text": "la respuesta[.][2]Mientras tanto, la persona no debe explorar "
          },
          {
            "bbox": [
              53.858001708984375,
              517.4439697265625,
              353.91302490234375,
              527.593994140625
            ],
            "ids": [
              [
                4,
                13
              ]
            ],
            "text": "cuestiones de esta clase. Está escrito con respecto a alguien que "
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          359.4570007324219,
          477.60894775390625,
          441.7049865722656,
          523.0650024414062
        ],
        "lines": [

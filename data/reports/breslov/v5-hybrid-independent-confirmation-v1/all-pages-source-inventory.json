            "bbox": [
              53.861236572265625,
              578.260498046875,
              242.51478576660156,
              585.086669921875
            ],
            "ids": [
              [
                8,
                20
              ]
            ],
            "text": "percepciones de Divinidad, hay peligro de que la sabiduría "
          },
          {
            "bbox": [
              53.861236572265625,
              587.260498046875,
              242.5237579345703,
              594.086669921875
            ],
            "ids": [
              [
                8,
                21
              ]
            ],
            "text": "inferior que produce carezca de vitalidad - i.e., sea estrecha y "
          },
          {
            "bbox": [
              53.861236572265625,
              596.260498046875,
              105.9337387084961,
              603.072021484375
            ],
            "ids": [
              [
                8,
                22
              ]
            ],
            "text": "poco inspiradora."
          }

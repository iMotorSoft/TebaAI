          },
          {
            "bbox": [
              82.02198791503906,
              474.1409606933594,
              276.1019287109375,
              483.7109680175781
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "emuná la protege entonces mientras duerme."
          }

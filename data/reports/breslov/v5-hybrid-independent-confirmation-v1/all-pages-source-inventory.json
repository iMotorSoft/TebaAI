                12,
                2
              ]
            ],
            "text": "HaShem será Uno y Su "
          },
          {
            "bbox": [
              354.8030090332031,
              275.6309814453125,
              422.3710021972656,
              281.72698974609375
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "Nombre será Uno”."
          },
          {
            "bbox": [
              354.8030090332031,
              285.7109680175781,
              402.32000732421875,
              292.2869873046875
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "(Zacarías 14:9).Zacarías 14:9).)."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.85829162597656,
          285.1589660644531,
          442.329345703125,
          355.2989807128906
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              285.1589660644531,
              402.32000732421875,
              295.2989807128906
            ],
            "ids": [
              [
                7,
                0
              ],
              [
                12,
                4
              ]
            ],
            "text": "Y es por esto por lo que decimos entonces, “Amén. (Zacarías 14:9).Zacarías 14:9).)."
          },
          {
            "bbox": [
              53.858306884765625,
              297.448974609375,
              442.32135009765625,
              307.2989807128906
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "Sea Su Gran Nombre bendecido para siempre por toda la eternidad. Bendito "
          },
          {
            "bbox": [
              53.858306884765625,
              309.1589660644531,
              442.328369140625,
              319.3089904785156
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "y alabado… es el Nombre del Santo, bendito sea, más exaltado que todas las "
          },
          {
            "bbox": [
              53.858306884765625,
              321.448974609375,
              442.32830810546875,
              331.2989807128906
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "bendiciones y canciones, alabanzas y consuelos”. Todo esto corresponde a la "
          },
          {
            "bbox": [
              53.858306884765625,
              333.1589660644531,
              442.329345703125,
              343.3089904785156
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "canción que surgirá en el futuro, que es igualmente “más exaltada que todas las "
          },
          {
            "bbox": [
              53.85829162597656,
              345.448974609375,
              181.82830810546875,
              355.2989807128906
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "bendiciones y canciones”."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          53.858306884765625,
          359.87298583984375,
          442.33245849609375,
          466.14300537109375
        ],
        "lines": [
          {
            "bbox": [
              82.25829315185547,
              359.87298583984375,
              442.3323059082031,
              370.13299560546875
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "Por lo tanto los hijos recitan esta tremenda alabanza en benefi cio del alma "
          },
          {
            "bbox": [
              53.858306884765625,
              371.87298583984375,
              442.330322265625,
              382.13299560546875
            ],
            "ids": [
              [
                7,
                7
              ]
            ],
            "text": "de su padre y de su madre, para elevarlas y rectifi carlas. Su principal tikún es "
          },
          {
            "bbox": [
              53.85833740234375,
              383.93658447265625,
              442.329345703125,
              394.13299560546875
            ],
            "ids": [
              [
                7,
                8
              ]
            ],
            "text": "permitir que sus almas despierten con un más elevado nivel de daat, siendo esto un "
          },
          {
            "bbox": [
              53.858367919921875,
              395.99298095703125,
              442.33038330078125,
              406.14300537109375
            ],
            "ids": [
              [
                7,
                9
              ]
            ],
            "text": "aspecto de la resurrección de los muertos/del jidush haolam, que es generado "
          },
          {
            "bbox": [
              53.8583984375,
              407.99298095703125,
              442.33245849609375,
              418.13299560546875
            ],
            "ids": [
              [
                7,
                10
              ]
            ],
            "text": "por la tremenda alabanza contenida en el kadish. Siendo la canción del futuro, "
          },
          {
            "bbox": [
              53.85838317871094,
              419.928955078125,
              442.33038330078125,
              430.13299560546875
            ],
            "ids": [
              [
                7,
                11
              ]
            ],
            "text": "el kadish es representativo del anhelado deleite del Mundo que Viene, pues en "
          },
          {
            "bbox": [
              53.8583984375,
              431.99298095703125,
              442.32135009765625,
              442.14300537109375
            ],
            "ids": [
              [
                7,
                12
              ]
            ],
            "text": "ese momento reconoceremos a HaShem y conoceremos todo lo que los judíos "
          },
          {
            "bbox": [
              53.8583984375,
              443.99298095703125,
              442.32159423828125,
              454.13299560546875
            ],
            "ids": [
              [
                7,
                13
              ]
            ],
            "text": "piadosos y los Tzadikim han logrado a través de sus devociones espirituales. "
          },
          {
            "bbox": [
              53.8583984375,
              456.27301025390625,
              223.24745178222656,
              466.14300537109375
            ],
            "ids": [
              [
                7,
                14
              ]
            ],
            "text": "Afortunado aquel que anhela esto."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          82.25839233398438,
          473.81298828125,
          411.35040283203125,
          531.3429565429688
        ],
        "lines": [
          {
            "bbox": [
              82.2583999633789,
              473.81298828125,
              411.35040283203125,
              481.4529724121094
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "El Rabí Natán ha demostrado cómo el recitado del kadish en el iortzait se "
          },
          {
            "bbox": [
              82.25839233398438,
              485.74298095703125,
              411.3503723144531,
              494.98297119140625
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "relaciona con la resurrección de los muertos, la renovación del daat, la "
          },
          {
            "bbox": [
              82.25839233398438,
              497.5829772949219,
              411.3304443359375,
              507.98297119140625
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "característica de guevurá de la “plegaria de juicio”, la fe en el jidush haolam "
          },
          {
            "bbox": [
              82.2584228515625,
              509.8229675292969,
              411.33148193359375,
              519.3429565429688
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "y la nueva canción del futuro. Ahora demuestra que el ayuno en el iortzait "
          },
          {
            "bbox": [
              82.2584228515625,
              521.5830078125,
              190.6784210205078,
              531.3429565429688
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "produce un tikún similar."
          }
        ]
      },
      {
        "index": 10,
        "class": "section-header",
        "bbox": [
          53.858421325683594,
          546.1829833984375,
          217.53811645507812,
          553.4229736328125
        ],
        "lines": [
          {
            "bbox": [
              53.858421325683594,
              546.1829833984375,
              217.53811645507812,
              553.4229736328125
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "8 ■ AYUNANDO EN EL IORTZAIT"
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          53.8580322265625,
          569.6629638671875,
          442.3259582519531,
          591.802978515625
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              569.6629638671875,
              442.24005126953125,
              579.802978515625
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "Por lo tanto uno no come ni bebe en el día del iortzait, para vencer la "
          },
          {
            "bbox": [
              53.8580322265625,
              581.6629638671875,
              442.3259582519531,
              591.802978515625
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "influencia del alimento del cuerpo a través del ayuno. Pues por medio de todos "
          }
        ]
      },

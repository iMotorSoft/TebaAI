              556.1329956054688
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          53.85810089111328,
          568.8844604492188,
          242.51168823242188,
          620.6959838867188
        ],
        "lines": [
          {
            "bbox": [
              53.85810089111328,
              568.8844604492188,
              242.50714111328125,
              575.7106323242188
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "con el esplendor y los colores superiores. La conexión que "
          },
          {
            "bbox": [
              53.85810089111328,
              577.8844604492188,
              242.51168823242188,
              584.7106323242188
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "agrega aquí con las vestimentas, con las ropas del alma, "
          },
          {
            "bbox": [
              53.85810089111328,
              586.8844604492188,
              242.4951171875,
              593.6959838867188
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "puede encontrarse en el Zohar (I, 217a), que enseña, “Haz "
          },
          {
            "bbox": [
              53.85810852050781,
              595.8844604492188,
              242.5071563720703,
              602.7106323242188
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "vestimentas santas para tu hermano Aarón, para gloria y para "
          },
          {
            "bbox": [
              53.85810852050781,
              604.8844604492188,
              242.49961853027344,
              611.7106323242188
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "tiferet (esplendor)” (Shemot 28:2) - i.e. vestimentas en las "
          },
          {
            "bbox": [
              53.85810852050781,
              613.8844604492188,
              198.60813903808594,
              620.6959838867188
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "cuales se hacen presentes los colores superiores."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.85810852050781,
          622.8844604492188,
          242.49293518066406,
          638.7106323242188
        ],
        "lines": [
          {
            "bbox": [
              53.85810852050781,
              622.8844604492188,
              242.49293518066406,
              629.7106323242188
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "87 Zohar I, 23b. Ver también Tikuney Zohar #21, p. 55b, que los "
          },
          {
            "bbox": [
              53.85887145996094,
              630.4094848632812,
              240.62913513183594,
              638.7119750976562
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "tzitzit son “su cobertura” y los tefi lin son “la vestimenta para su piel”."
          }
        ]
      },
      {
        "index": 10,
        "class": "footnote",
        "bbox": [
          53.858848571777344,
          640.8844604492188,
          242.4921112060547,
          647.7106323242188
        ],
        "lines": [
          {
            "bbox": [
              53.858848571777344,
              639.4094848632812,
              242.4921112060547,
              647.7119750976562
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "88 En Shaar HaKavanot, Drushei Tefi lin 7, el Ari zal enseña "
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          252.6148681640625,
          568.8927001953125,
          441.26446533203125,
          602.7042236328125
        ],
        "lines": [
          {
            "bbox": [
              252.6148681640625,
              567.417724609375,
              441.2502746582031,
              575.72021484375
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "que la luz espiritual que emana de los tefi lin que la persona se "
          },
          {
            "bbox": [
              252.6156005859375,
              577.8927001953125,
              441.26446533203125,
              584.7042236328125
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "coloca por la mañana deriva de su servicio a HaShem por la "
          },
          {
            "bbox": [
              252.6156005859375,
              586.8927001953125,
              441.247314453125,
              593.7042236328125
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "noche. Aquí el Rabí Natán conecta esta idea con el birur de "
          },
          {
            "bbox": [
              252.61558532714844,
              595.8927001953125,
              308.24310302734375,
              602.7042236328125
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "los puntos buenos."
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          252.61558532714844,
          604.8927001953125,
          338.91876220703125,
          610.2137451171875
        ],
        "lines": [
          {
            "bbox": [
              252.61558532714844,
              604.8927001953125,
              338.91876220703125,
              610.2137451171875
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "89 Ver la nota 26 más arriba."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          252.61558532714844,
          613.8927001953125,
          441.2750549316406,
          647.7188720703125
        ],
        "lines": [
          {
            "bbox": [
              252.61558532714844,
              613.8927001953125,
              441.2750549316406,
              620.7042236328125
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "90 En §4, el Rabí Natán explicó que, conceptualmente, fueron "
          },
          {
            "bbox": [
              252.61558532714844,
              622.8890380859375,
              441.2608642578125,
              629.7188720703125
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "los puntos buenos con los que contribuyó el pueblo judío para la "
          },
          {
            "bbox": [
              252.61558532714844,
              631.8927001953125,
              441.2571105957031,
              638.7042236328125
            ],
            "ids": [
              [
                6,
                7
              ]
            ],
            "text": "construcción del Mishkán. Cada punto bueno tiene su propio color "
          },
          {
            "bbox": [
              252.61630249023438,
              640.8890380859375,
              435.36883544921875,
              647.7188720703125
            ],
            "ids": [
              [
                6,
                8
              ]
            ],
            "text": "único; en conjunto, forman el espectro completo de los colores. "
          }
        ]
      }
    ]

                9,
                5
              ]
            ],
            "text": "vestimentas mediante las cuales transmitir una percepción de (Ester 1:6)"
          },
          {
            "bbox": [
              53.85702133178711,
              344.778076171875,
              376.6600646972656,
              354.9180908203125
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "Divinidad incluso a los más alejados espiritualmente. De manera "
          },
          {
            "bbox": [
              53.857025146484375,
              356.778076171875,
              442.3171081542969,
              366.9281005859375
            ],
            "ids": [
              [
                5,
                8
              ]
            ],
            "text": "conceptual, las constricciones, que corresponden a la sabiduría inferior, "
          },
          {
            "bbox": [
              53.857025146484375,
              369.0680847167969,
              442.3240051269531,
              378.9180908203125
            ],
            "ids": [
              [
                5,
                9
              ]
            ],
            "text": "incluyen todos los colores. Esos colores son la totalidad de los recipientes y "
          },
          {
            "bbox": [
              53.857025146484375,
              380.778076171875,
              442.3170471191406,
              390.9180908203125
            ],
            "ids": [
              [
                5,
                10
              ]
            ],
            "text": "vestimentas de santidad a través de las cuales uno percibe Su Divinidad, como "
          },

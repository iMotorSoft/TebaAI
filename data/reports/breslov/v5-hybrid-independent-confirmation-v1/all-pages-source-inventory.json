              47.827545166015625,
              160.70889282226562,
              54.539546966552734
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "SOBRE EL LIKUTEY HALAJOT"
          }
        ]
      },
      {
        "index": 2,
        "class": "text",
        "bbox": [
          56.692901611328125,
          70.85540771484375,
          444.9930114746094,
          133.66717529296875
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              70.85540771484375,
              444.9886474609375,
              80.86712646484375
            ],
            "ids": [
              [
                0,
                0
              ]
            ],
            "text": "la mayor parte de los discursos), el Rabí Natán introduce sus propias ideas originales. "
          },
          {
            "bbox": [
              56.692901611328125,
              84.050048828125,
              444.9930114746094,
              94.067138671875
            ],
            "ids": [
              [
                0,
                1
              ]
            ],
            "text": "Es aquí donde aprendemos cuál es el objetivo del Rabí Natán y por qué ha conectado "
          },
          {
            "bbox": [
              56.692901611328125,
              97.25543212890625,
              444.98095703125,
              107.26715087890625
            ],
            "ids": [
              [
                0,
                2
              ]
            ],
            "text": "esta halajá del Shuljan Aruj con esa enseñanza del Rebe. En las secciones siguientes "
          },
          {
            "bbox": [
              56.69291687011719,
              110.4554443359375,
              444.9929504394531,
              120.4456787109375
            ],
            "ids": [
              [
                0,
                3
              ]
            ],
            "text": "se va desarrollando el cuerpo del discurso cuando el Rabí Natán demuestra cómo los "
          },
          {
            "bbox": [
              56.69291687011719,
              121.49214935302734,
              349.5035095214844,
              133.66915893554688
            ],
            "ids": [
              [
                0,
                4
              ]
            ],
            "text": "conceptos del Rebe iluminan el signifi cado profundo de la halajá.[7]"
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          56.691497802734375,
          139.6903076171875,
          445.024658203125,
          305.87847900390625
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              139.6903076171875,
              444.9734802246094,
              149.1595458984375
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "Al construir sus discursos, el Rabí Natán hace un uso considerable del mismo "
          },
          {
            "bbox": [
              56.6931037902832,
              152.53126525878906,
              442.2044982910156,
              162.90203857421875
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "proceso de asociación empleado copiosamente por el Rebe Najmán en sus lecciones.[8]"
          },
          {
            "bbox": [
              56.6923828125,
              166.09027099609375,
              445.0155334472656,
              176.10198974609375
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "En el centro de esta interpretación-analogía-y-comparación se encuentra el mecanismo "
          },
          {
            "bbox": [
              56.6923828125,
              178.9311981201172,
              444.9541015625,
              189.302001953125
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "exegético conocido como bejiná.[9] En el pensamiento de Breslov, el término bejiná es "
          },
          {
            "bbox": [
              56.691497802734375,
              192.49029541015625,
              445.024658203125,
              202.48052978515625
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "usado para conectar palabras o ideas aparentemente disímiles, estableciendo una relación "
          },
          {
            "bbox": [
              56.691497802734375,
              203.52700805664062,
              444.95513916015625,
              215.70401000976562
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "entre ellas de modo que “A” esté asociada con “B”. En términos más específi cos, “A” y "
          },
          {
            "bbox": [
              56.691497802734375,
              216.72702026367188,
              444.9651794433594,
              228.90402221679688
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "“B” representan dos conceptos complejos. Al afi rmar que “A” es bejiná de “B” se indica "
          },
          {
            "bbox": [
              56.691497802734375,
              232.09033203125,
              445.0091247558594,
              242.08056640625
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "que en virtud de una característica en común compartida entre ambos, los dos conceptos "
          },
          {
            "bbox": [
              56.691497802734375,
              245.28497314453125,
              445.0093078613281,
              255.30206298828125
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "complejos pueden ser superpuestos de modo que la característica adicional de uno puede "
          },
          {
            "bbox": [
              56.691497802734375,
              258.4903564453125,
              444.9915771484375,
              268.5020751953125
            ],
            "ids": [
              [
                1,
                9
              ]
            ],
            "text": "ser vista también en el otro. En general, esta superposición es demostrada entonces "
          },
          {
            "bbox": [
              56.691497802734375,
              271.68499755859375,
              445.00933837890625,
              281.70208740234375
            ],
            "ids": [
              [
                1,
                10
              ]
            ],
            "text": "trayendo como referencia una asociación bíblica o kabalística. Es este “asemejar una "
          },
          {
            "bbox": [
              56.691497802734375,
              284.890380859375,
              445.01806640625,
              294.880615234375
            ],
            "ids": [
              [
                1,
                11
              ]
            ],
            "text": "cosa con otra” lo que da fe de la cualidad caleidoscópica de virtualmente todas las "
          },
          {
            "bbox": [
              56.691497802734375,
              298.09039306640625,
              158.3095245361328,
              305.87847900390625
            ],
            "ids": [
              [
                1,
                12
              ]
            ],
            "text": "enseñanzas de Breslov."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          56.691497802734375,
          314.1239929199219,
          445.0377197265625,
          440.712158203125
        ],
        "lines": [
          {
            "bbox": [
              85.09129333496094,
              311.960693359375,
              444.970703125,
              324.1376953125
            ],
            "ids": [
              [
                1,
                13
              ]
            ],
            "text": "Otra característica defi nitoria del Likutey Halajot es lo que podría llamarse el "
          },
          {
            "bbox": [
              56.691497802734375,
              327.3240051269531,
              444.998291015625,
              337.3357238769531
            ],
            "ids": [
              [
                1,
                14
              ]
            ],
            "text": "estilo de improvisación del Rabí Natán. En la mayor parte de las homilías y discursos "
          },
          {
            "bbox": [
              56.691497802734375,
              340.5186462402344,
              445.0069274902344,
              350.5357360839844
            ],
            "ids": [
              [
                1,
                15
              ]
            ],
            "text": "jasídicos, el autor sigue un plan cuidadosamente establecido o una guía para desarrollar "
          },
          {
            "bbox": [
              56.691497802734375,
              353.7240295410156,
              445.00701904296875,
              363.7142639160156
            ],
            "ids": [
              [
                1,
                16
              ]
            ],
            "text": "sus ideas de manera lineal. En contraste, el pensamiento del Rabí Natán es lateral: un "
          },
          {
            "bbox": [
              56.691497802734375,
              366.9240417480469,
              445.0225524902344,
              376.9357604980469
            ],
            "ids": [
              [
                1,
                17
              ]
            ],
            "text": "acercamiento intuitivo y así espontáneo, similar a la improvisación musical. El Rabí "
          },
          {
            "bbox": [
              56.691497802734375,
              380.1240539550781,
              445.015869140625,
              390.1357727050781
            ],
            "ids": [
              [
                1,
                18
              ]
            ],
            "text": "Natán establece su tema y se embarca en una cierta línea de pensamiento; luego vuelve "
          },
          {
            "bbox": [
              56.691497802734375,
              393.3240661621094,
              445.0377197265625,
              403.3357849121094
            ],
            "ids": [
              [
                1,
                19
              ]
            ],
            "text": "hacia atrás, en general repitiendo el tema o parte de él, sólo para empezar en una dirección "
          },
          {
            "bbox": [
              56.691497802734375,
              406.5240783691406,
              445.00048828125,
              416.5357971191406
            ],
            "ids": [
              [
                1,
                20
              ]
            ],
            "text": "nueva y fresca. Aun así, el discurso del Rabí Natán siempre permanece sólidamente "
          },
          {
            "bbox": [
              56.691497802734375,
              419.7187194824219,
              444.98382568359375,
              429.7358093261719
            ],
            "ids": [
              [
                1,
                21
              ]
            ],
            "text": "enraizado en la enseñanza del Rabí Najmán, de modo que sus exploraciones son todas "
          },
          {
            "bbox": [
              56.691497802734375,
              432.924072265625,
              303.5425720214844,
              440.712158203125
            ],
            "ids": [
              [
                1,
                22
              ]
            ],
            "text": "comentarios incisivos sobre las lecciones de su maestro."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          56.690399169921875,
          448.95880126953125,
          445.0124816894531,
          524.970458984375
        ],
        "lines": [
          {
            "bbox": [
              85.09129333496094,
              448.95880126953125,
              445.0103454589844,
              458.97052001953125
            ],
            "ids": [
              [
                1,
                23
              ]
            ],
            "text": "En el Likutey Halajot el Rabí Natán también demuestra la naturaleza abarcadora y "
          },
          {
            "bbox": [
              56.690399169921875,
              462.1587829589844,
              444.99163818359375,
              472.1705017089844
            ],
            "ids": [
              [
                1,
                24
              ]
            ],
            "text": "general de las lecciones de su maestro y cómo sus construcciones conceptuales dan luz "
          },
          {
            "bbox": [
              56.690399169921875,
              475.3587646484375,
              445.0092468261719,
              483.1468505859375
            ],
            "ids": [
              [
                1,
                25
              ]
            ],
            "text": "a tantas otras facetas de la Torá. A través de esas enseñanzas comenzamos a detectar la "
          },
          {
            "bbox": [
              56.690399169921875,
              488.55877685546875,
              445.0124816894531,
              496.34686279296875
            ],
            "ids": [
              [
                1,
                26
              ]
            ],
            "text": "sabiduría Divina inherente a cada elemento de la existencia. Descubrimos la conexión "
          },
          {
            "bbox": [
              56.690399169921875,
              501.7587890625,
              444.9926452636719,
              511.7705078125
            ],
            "ids": [
              [
                1,
                27
              ]
            ],
            "text": "de cada uno de los componentes de la creación con su Creador y en particular el lazo "
          },
          {
            "bbox": [
              56.690399169921875,
              514.953369140625,
              314.55242919921875,
              524.970458984375
            ],
            "ids": [
              [
                1,
                28
              ]
            ],
            "text": "especial que nosotros, como judíos, tenemos con HaShem."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          226.17300415039062,
          537.1499633789062,
          274.14404296875,
          544.2490844726562
        ],
        "lines": [
          {
            "bbox": [
              226.17300415039062,
              537.1499633789062,
              274.14404296875,
              544.2490844726562
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 7,
        "class": "footnote",
        "bbox": [
          56.691986083984375,
          558.4115600585938,
          444.5631408691406,
          599.0073852539062
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              558.4115600585938,
              444.4552001953125,
              566.6073608398438
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "7 Las excepciones a este formato se presentan principalmente en los discursos de la Halajá 1 (series alef); "
          },
          {
            "bbox": [
              56.691986083984375,
              569.2159423828125,
              170.06494140625,
              577.3897705078125
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "ver más adelante, p. 22, nota 1."
          },
          {
            "bbox": [
              56.691986083984375,
              580.0115966796875,
              444.5631408691406,
              588.2073974609375
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "8 El Rabí Natán oyó que cierta vez dijo el Rebe Najmán, “Mis enseñanzas de Torá están construidas "
          },
          {
            "bbox": [
              56.691986083984375,
              590.8159790039062,
              193.03118896484375,
              599.0073852539062
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "totalmente de bejinot” (Tzadik #350)."
          }
        ]
      },
      {
        "index": 8,
        "class": "footnote",
        "bbox": [
          56.69195556640625,
          601.615966796875,
          444.5634460449219,
          642.2073974609375
        ],
        "lines": [
          {
            "bbox": [
              56.691986083984375,
              601.615966796875,
              444.48614501953125,
              609.807373046875
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "9 Hemos traducido el término bejiná de diversas maneras, incluyendo literalmente, “aspecto” y, "
          },
          {
            "bbox": [
              56.691986083984375,
              612.4159545898438,
              444.44256591796875,
              620.6073608398438
            ],
            "ids": [
              [
                5,
                5
              ]
            ],
            "text": "contextualmente, “concepto” o “dimensión”. Para “A es bejinat de B”, hemos decidido recurrir a "
          },
          {
            "bbox": [
              56.69195556640625,
              623.2159423828125,
              444.5634460449219,
              631.4073486328125
            ],
            "ids": [
              [
                5,
                6
              ]
            ],
            "text": "formulaciones lingüísticas, incluyendo “el concepto de”, “corresponde a”, “se relaciona con”, “es paralelo "
          },
          {
            "bbox": [
              56.69195556640625,
              634.0159912109375,
              173.5209197998047,
              642.2073974609375
            ],
            "ids": [
              [
                5,
                7
              ]
            ],
            "text": "de”, “es sinónimo de”, y demás."
          }
        ]
      }
    ]
  },

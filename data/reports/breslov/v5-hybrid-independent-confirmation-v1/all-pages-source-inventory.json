              529.6939697265625,
              442.3310241699219,
              539.593994140625
            ],
            "ids": [
              [
                4,
                14
              ]
            ],
            "text": "se apoya en su intelecto para profundizar en tales cuestiones, “Todo aquel que "
          },
          {
            "bbox": [
              53.8580322265625,
              541.4439697265625,
              442.237060546875,
              551.583984375
            ],
            "ids": [
              [
                4,
                15
              ]
            ],
            "text": "vaya hacia ella no retornará” - i.e., no volverá a su anterior nivel de devoción y "
          },
          {
            "bbox": [
              53.8580322265625,
              553.4439697265625,
              442.33013916015625,
              563.583984375
            ],
            "ids": [
              [
                4,
                16
              ]
            ],
            "text": "de fe simple.[3]Pues cuando se trata de preguntas de esta clase, está prohibido "
          }
        ]
      },

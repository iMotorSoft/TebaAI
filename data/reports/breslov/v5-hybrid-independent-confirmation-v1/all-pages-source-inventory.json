              126.48979949951172,
              535.3886108398438
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "29 Bereshit Rabah 93:2."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          53.858299255371094,
          539.0785522460938,
          242.51187133789062,
          608.8900756835938
        ],
        "lines": [
          {
            "bbox": [
              53.858299255371094,
              539.0785522460938,
              242.49685668945312,
              545.9047241210938
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "30 El Zohar (I, 206b) explica esta reunión de los reyes, de "
          },
          {
            "bbox": [
              53.858299255371094,
              548.0785522460938,
              242.49154663085938,
              554.9047241210938
            ],
            "ids": [
              [
                10,
                2
              ]
            ],
            "text": "Iosef y de Iehudá, como el ijud de Zeir Anpin/HaKadosh "
          },
          {
            "bbox": [
              53.859039306640625,
              557.0748901367188,
              242.49830627441406,
              563.9047241210938
            ],
            "ids": [
              [
                10,
                3
              ]
            ],
            "text": "Baruj Hu con Maljut/la Shejiná. Iosef, siendo el ejemplo "
          },
          {
            "bbox": [
              53.858299255371094,
              564.6035766601562,
              242.4900665283203,
              572.9060668945312
            ],
            "ids": [
              [
                10,
                4
              ]
            ],
            "text": "bíblico del Tzadik, personifi ca a Iesod, el componente de Zeir "
          },
          {
            "bbox": [
              53.85905456542969,
              575.0785522460938,
              242.51187133789062,
              581.9047241210938
            ],
            "ids": [
              [
                10,
                5
              ]
            ],
            "text": "Anpin abocado a la unión. Iehudá, siendo el progenitor de la "
          },
          {
            "bbox": [
              53.85905456542969,
              582.6035766601562,
              242.49005126953125,
              590.9060668945312
            ],
            "ids": [
              [
                10,
                6
              ]
            ],
            "text": "dinastía de David, personifi ca a Maljut, la pareja de Zeir Anpin. "
          },
          {
            "bbox": [
              53.859039306640625,
              591.6035766601562,
              242.49903869628906,
              599.9060668945312
            ],
            "ids": [
              [
                10,
                7
              ]
            ],
            "text": "El acercarse de ambos signifi ca el ijud “cara a cara” de esas "
          },
          {
            "bbox": [
              53.859046936035156,
              602.0785522460938,
              107.1840591430664,
              608.8900756835938
            ],
            "ids": [
              [
                10,
                8
              ]
            ],
            "text": "personas Divinas."
          }
        ]
      },
      {
        "index": 14,
        "class": "text",
        "bbox": [
          53.85904312133789,
          611.0785522460938,
          242.51104736328125,
          644.9047241210938
        ],
        "lines": [
          {
            "bbox": [

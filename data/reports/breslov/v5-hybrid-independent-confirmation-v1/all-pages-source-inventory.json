              575.8406982421875,
              441.2452392578125,
              584.1431884765625
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "43 Las guevurot, los elementos en la raíz de la sefi rá de "
          },
          {
            "bbox": [
              252.61351013183594,
              586.315673828125,
              441.25775146484375,
              593.141845703125
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "Guevurá (Fuerza), representan constricción y severidad (ver "
          },
          {
            "bbox": [
              252.61351013183594,
              595.315673828125,
              441.2572021484375,
              602.141845703125
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "más arriba, p. 96, notas 52 y p. 122, nota 75). El Rabí Natán "
          },
          {
            "bbox": [
              252.61351013183594,
              604.315673828125,
              441.24822998046875,
              611.141845703125
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "explica aquí que es la fuerza asociada con las guevurot la que "
          },
          {
            "bbox": [
              252.61351013183594,
              613.315673828125,
              441.2830810546875,
              620.141845703125
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "permite que la persona quiebre la garra del sueño y se levante a "
          },
          {
            "bbox": [
              252.61351013183594,
              622.315673828125,
              441.24822998046875,
              629.141845703125
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "medianoche. Más adelante (§5), conectará las guevurot con la "
          },
          {
            "bbox": [
              252.61427307128906,
              631.315673828125,
              435.8916015625,
              638.141845703125
            ],
            "ids": [
              [
                12,
                6
              ]
            ],
            "text": "plegaria de din del baal koaj, de aquél de fortaleza espiritual."
          },
          {
            "bbox": [
              252.61354064941406,
              640.315673828125,
              415.99725341796875,
              647.141845703125
            ],

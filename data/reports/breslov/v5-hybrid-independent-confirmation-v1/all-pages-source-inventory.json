              441.74298095703125,
              428.7599792480469
            ],
            "ids": [
              [
                13,
                0
              ]
            ],
            "text": "“¿Donde están Tus celos "
          },
          {
            "bbox": [
              355.03900146484375,
              430.7519836425781,
              430.6309814453125,
              438.36798095703125
            ],
            "ids": [
              [
                13,
                1
              ]
            ],
            "text": "y Tus obras potentes? "
          },
          {
            "bbox": [
              355.03900146484375,
              440.35198974609375,
              433.7349853515625,
              447.9679870605469
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "¡Acaso se ha reducido "
          },
          {
            "bbox": [
              355.03900146484375,
              449.9519958496094,
              415.510986328125,
              456.0320129394531
            ],
            "ids": [
              [
                13,
                3
              ]
            ],
            "text": "la conmoción de "
          },
          {
            "bbox": [
              355.03900146484375,
              459.552001953125,
              428.406982421875,
              467.1679992675781
            ],
            "ids": [
              [
                13,
                4
              ]
            ],
            "text": "Tus entrañas y de Tu "
          },
          {
            "bbox": [
              355.03900146484375,
              469.1520080566406,
              437.72698974609375,
              476.76800537109375
            ],
            "ids": [
              [
                13,
                5
              ]
            ],
            "text": "compasión hacia mí!… "
          },
          {
            "bbox": [
              355.03900146484375,
              478.75201416015625,
              437.29498291015625,
              486.3680114746094
            ],
            "ids": [
              [
                13,
                6
              ]
            ],
            "text": "¿Por qué, HaShem, nos "
          },
          {
            "bbox": [
              355.03900146484375,
              488.3520202636719,
              429.718994140625,
              495.968017578125
            ],
            "ids": [
              [
                13,
                7
              ]
            ],
            "text": "permites errar de Tus "
          },
          {
            "bbox": [
              355.03900146484375,
              497.9520263671875,
              429.27899169921875,
              505.5680236816406
            ],
            "ids": [
              [
                13,
                8
              ]
            ],
            "text": "caminos y endurecer "
          },
          {
            "bbox": [
              355.03900146484375,
              507.9120178222656,
              441.29498291015625,
              515.1680297851562
            ],
            "ids": [
              [
                13,
                9
              ]
            ],
            "text": "nuestro corazón para no "
          },
          {
            "bbox": [
              355.03900146484375,
              517.4400634765625,
              389.7030029296875,
              523.2320556640625
            ],
            "ids": [
              [
                13,
                10
              ]
            ],
            "text": "temerte?”."
          },
          {
            "bbox": [
              355.03900146484375,
              527.2320556640625,
              406.96099853515625,
              533.912109375
            ],
            "ids": [
              [
                13,
                11
              ]
            ],
            "text": "(Isaías 63:15, 17)"
          }
        ]
      },

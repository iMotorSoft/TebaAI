          56.692901611328125,
          230.8209686279297,
          445.16302490234375,
          252.68096923828125
        ],
        "lines": [
          {
            "bbox": [
              56.692901611328125,
              230.8209686279297,
              445.16302490234375,
              240.6909637451172
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "HaPanim, la fuente de la vitalidad esencial de Maljut que le permite ascender "
          },
          {
            "bbox": [
              56.692901611328125,
              242.4209747314453,
              233.91189575195312,
              252.68096923828125
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "y ser purifi cada de los Cuatro Reinos."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          56.692901611328125,
          255.75596618652344,
          445.1609802246094,
          291.5159912109375
        ],
        "lines": [
          {
            "bbox": [
              85.09290313720703,
              255.75596618652344,
              445.1609802246094,
              267.5159606933594
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "Éste es también el motivo por el cual la persona no debe evacuar el vientre "
          },
          {
            "bbox": [
              56.692901611328125,
              269.3759765625,
              445.16015625,
              279.5260009765625
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "ubicada entre el este y el oeste,[76]dado que así estaría enfrentando a Ierushalaim, "
          },
          {
            "bbox": [
              56.6929931640625,
              281.60498046875,
              404.9908142089844,
              291.5159912109375
            ],
            "ids": [
              [
                5,
                4
              ]
            ],
            "text": "lugar del Beit HaMikdash, donde se revelaba el principal Or HaPanim.[77]"
          }
        ]
      },
      {
        "index": 7,
        "class": "section-header",
        "bbox": [
          56.692901611328125,
          303.58599853515625,
          177.4326171875,
          314.9259948730469
        ],
        "lines": [
          {
            "bbox": [

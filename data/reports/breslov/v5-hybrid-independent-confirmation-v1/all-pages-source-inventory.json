              217.97096252441406,
              423.1266784667969,
              228.1109619140625
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "llena de Su gloria”, como está explicado claramente en la lección del Rebe.[57]"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.85791015625,
          230.22096252441406,
          442.34307861328125,
          324.1109619140625
        ],
        "lines": [
          {
            "bbox": [
              82.25789642333984,
              230.22096252441406,
              442.33184814453125,
              240.1109619140625
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Por lo tanto la glosa en el Shuljan Aruj, “He puesto a HaShem siempre "
          },
          {
            "bbox": [
              53.85791015625,
              241.97096252441406,
              442.34307861328125,
              252.12095642089844
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "delante de mí” -que significa saber que “la tierra entera está llena de Su gloria” - "
          },
          {
            "bbox": [
              53.85791015625,
              253.97096252441406,
              442.3310241699219,
              264.1109619140625
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "está yuxtapuesta a la idea de despertar el alba. Pues ambas son interdependientes: "
          },
          {
            "bbox": [
              53.85791015625,
              265.970947265625,
              442.32598876953125,
              276.1209716796875
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "podemos tener el mérito de saber completamente y de todo corazón que “la "
          },
          {
            "bbox": [
              53.85791015625,
              277.970947265625,
              442.3309631347656,
              288.1209716796875
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "tierra entera está llena de Su gloria” por medio del daat que hacemos descender "
          },
          {
            "bbox": [
              53.85791015625,
              288.3509521484375,
              442.3318786621094,
              300.1209716796875
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "al levantarnos a medianoche. Éste es el daat que se relaciona con el estudio de las "
          },
          {
            "bbox": [
              53.85791015625,
              301.970947265625,
              442.23992919921875,
              312.1109619140625
            ],
            "ids": [
              [
                2,
                6
              ]
            ],
            "text": "reglamentaciones de la ley judía, como se explicó anteriormente en conexión "
          },
          {
            "bbox": [
              53.85791015625,
              313.970947265625,
              439.3759460449219,
              324.1109619140625
            ],
            "ids": [
              [
                2,
                7
              ]
            ],
            "text": "con el versículo “Me levantaré a medianoche para alabarte por Tus justas leyes”."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          82.25791931152344,
          331.7999572753906,
          411.3518371582031,
          353.3699645996094
        ],
        "lines": [
          {
            "bbox": [
              82.25791931152344,
              331.7999572753906,
              411.3518371582031,
              341.3199768066406
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "El Rabí Natán demuestra que el levantarse a medianoche para estudiar Torá y "
          },
          {
            "bbox": [
              82.25791931152344,
              343.7999572753906,
              408.56781005859375,
              353.3699645996094
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "servir a HaShem también exalta la cualidad de las plegarias a la mañana siguiente."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          53.85791015625,
          361.3089599609375,
          345.10205078125,
          443.448974609375
        ],
        "lines": [
          {
            "bbox": [
              82.25791931152344,
              361.3089599609375,
              345.01190185546875,
              371.448974609375
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Y éste es el significado de “para alabarte” - la palabra "
          },
          {
            "bbox": [
              53.85791015625,
              373.24493408203125,
              345.1020202636719,
              383.52716064453125
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "lehodot connota plegaria,[58] al igual que la palabra odejaen "
          },
          {
            "bbox": [
              53.858001708984375,
              385.3089599609375,
              345.10009765625,
              395.448974609375
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "“odeja con un corazón recto cuando estudie Tus justas "
          },
          {
            "bbox": [
              53.85800552368164,
              397.3089599609375,
              342.1418151855469,
              407.448974609375
            ],
            "ids": [
              [
                4,
                3
              ]
            ],
            "text": "leyes”,[59] tal cual está explicado en la lección del Rebe.[60]"
          },
          {
            "bbox": [
              53.858001708984375,
              409.4889831542969,
              345.00897216796875,
              419.448974609375
            ],
            "ids": [
              [
                4,
                4
              ]
            ],
            "text": "Merecemos alabar a HaShem a través de una plegaria desde "
          },
          {
            "bbox": [
              53.858001708984375,
              421.4889831542969,
              345.10205078125,
              429.198974609375
            ],
            "ids": [
              [
                4,
                5
              ]
            ],
            "text": "el fondo del corazón cuando nos levantamos a medianoche "
          },
          {
            "bbox": [
              53.858001708984375,
              433.468017578125,
              233.7078399658203,
              443.448974609375
            ],
            "ids": [
              [
                4,
                6
              ]
            ],
            "text": "para estudiar Torá y servir a HaShem.[61]"
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          350.64599609375,
          358.12896728515625,
          442.66998291015625,
          394.54498291015625
        ],
        "lines": [
          {
            "bbox": [
              350.64599609375,
              358.12896728515625,
              407.5419921875,
              364.208984375
            ],
            "ids": [
              [
                16,
                0
              ]
            ],
            "text": "“Me levantaré a "
          },
          {
            "bbox": [
              350.64599609375,
              367.7289733886719,
              442.66998291015625,
              375.344970703125
            ],
            "ids": [
              [
                16,
                1
              ]
            ],
            "text": "medianoche para alabarte "
          },
          {
            "bbox": [
              350.64599609375,
              377.1369934082031,
              433.01318359375,
              384.9449768066406
            ],
            "ids": [
              [
                16,
                2
              ]
            ],
            "text": "(lehodot) por Tus justas "
          },
          {
            "bbox": [
              350.64599609375,
              386.9289855957031,
              373.75799560546875,
              394.54498291015625
            ],
            "ids": [
              [
                16,
                3
              ]
            ],
            "text": "leyes”."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          350.64599609375,
          397.00897216796875,
          399.8370056152344,
          403.5849914550781
        ],
        "lines": [
          {
            "bbox": [
              350.64599609375,
              397.00897216796875,
              399.8370056152344,
              403.5849914550781
            ],
            "ids": [
              [
                16,
                4
              ]
            ],
            "text": "(Salmos 119:62)"
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          350.64581298828125,
          408.8985595703125,
          439.57379150390625,
          444.8189697265625
        ],
        "lines": [
          {
            "bbox": [
              350.64581298828125,
              408.8985595703125,
              435.64501953125,
              416.99456787109375
            ],
            "ids": [
              [
                17,
                0
              ]
            ],
            "text": "“Te alabaré (Odeja) con "
          },
          {
            "bbox": [
              350.64581298828125,
              418.56256103515625,
              439.57379150390625,
              424.642578125
            ],
            "ids": [
              [
                17,
                1
              ]
            ],
            "text": "un corazón recto cuando "
          },
          {
            "bbox": [
              350.64581298828125,
              428.1625671386719,
              436.0137939453125,
              435.778564453125
            ],
            "ids": [
              [
                17,
                2
              ]
            ],
            "text": "estudie Tus justas leyes”."
          },
          {
            "bbox": [
              350.64581298828125,
              438.2425842285156,
              388.1759948730469,
              444.8189697265625
            ],
            "ids": [
              [
                17,
                3
              ]
            ],
            "text": "(ibid. 119:7)"
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          82.25789642333984,
          451.1379699707031,
          411.34783935546875,
          482.73797607421875
        ],
        "lines": [
          {
            "bbox": [
              82.25789642333984,
              451.1379699707031,
              411.34783935546875,
              460.6579895019531
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "El Rabí Natán interrumpe su discurso conectando la devoción antes del "
          },
          {
            "bbox": [
              82.25789642333984,
              463.1379699707031,
              411.3439025878906,
              472.7079772949219
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "alba con la plegaria para aclarar más aún el significado de levantarse a "
          },
          {
            "bbox": [
              82.25789642333984,
              475.1379699707031,
              138.3878936767578,
              482.73797607421875
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "medianoche."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          53.857940673828125,
          492.8279724121094,
          442.3389587402344,
          572.5379638671875
        ],
        "lines": [
          {
            "bbox": [
              82.25789642333984,
              492.8279724121094,
              442.3299255371094,
              502.7979736328125
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "Así, el levantarse a medianoche, es la esencia de lo que el Shuljan "
          },
          {
            "bbox": [
              53.857940673828125,
              504.64794921875,
              442.32501220703125,
              514.7879638671875
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "Aruj denomina “despertar el alba”. Pues lo más importante es levantarse a "
          },
          {
            "bbox": [
              53.857940673828125,
              516.93798828125,
              442.3280944824219,
              526.7979736328125
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "medianoche. Pero incluso alguien que es incapaz de levantarse a medianoche "
          },
          {
            "bbox": [
              53.857940673828125,
              528.93798828125,
              442.3260803222656,
              538.7879638671875
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "puede lograr mucho cuando se fortalece para levantarse al menos antes de la "
          },
          {
            "bbox": [
              53.857940673828125,
              540.64794921875,
              442.3179931640625,
              550.7879638671875
            ],
            "ids": [
              [
                6,
                4
              ]
            ],
            "text": "llegada de la luz del día para estudiar Torá y servir a HaShem. De esta manera, "
          },
          {
            "bbox": [
              53.857940673828125,
              552.93798828125,
              442.3389587402344,
              562.7979736328125
            ],
            "ids": [
              [
                6,
                5
              ]
            ],
            "text": "desbloquea los senderos del intelecto relativos a su nivel espiritual, de acuerdo "
          },
          {
            "bbox": [
              53.857940673828125,
              564.93798828125,
              442.3319396972656,
              572.5379638671875
            ],
            "ids": [
              [
                6,
                6
              ]
            ],
            "text": "con su servicio a HaShem en las horas anteriores al alba. Mediante sus devociones "
          }
        ]
      },
      {
        "index": 14,
        "class": "text",
        "bbox": [
          224.7550048828125,
          586.0740966796875,
          272.7260437011719,
          593.173095703125
        ],

              334.8862609863281
            ],
            "ids": [
              [
                19,
                0
              ]
            ],
            "text": "“Como la cierva "
          },
          {
            "bbox": [
              377.0078125,
              338.3902587890625,
              413.91180419921875,
              344.47027587890625
            ],
            "ids": [
              [
                19,
                1
              ]
            ],
            "text": "anhela las "
          },
          {
            "bbox": [
              377.0078125,
              347.9902648925781,
              435.247802734375,
              354.0702819824219
            ],
            "ids": [
              [
                19,
                2
              ]
            ],
            "text": "corrientes de las "
          },
          {
            "bbox": [
              377.0078125,
              357.59027099609375,
              442.7998046875,
              365.24627685546875
            ],
            "ids": [
              [
                19,
                3
              ]
            ],
            "text": "aguas, así mi alma "
          },
          {
            "bbox": [
              377.0078125,
              367.1902770996094,
              436.143798828125,
              374.8062744140625
            ],
            "ids": [
              [
                19,
                4
              ]
            ],
            "text": "clama por Ti, oh "
          },
          {
            "bbox": [
              377.0078125,
              377.0782775878906,
              398.79180908203125,
              382.8623046875
            ],
            "ids": [

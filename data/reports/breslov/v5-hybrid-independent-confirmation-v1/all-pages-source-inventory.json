              80.7465591430664
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "Reshimu (Reminiscencia)"
          }
        ]
      },
      {
        "index": 3,
        "class": "text",
        "bbox": [
          53.858001708984375,
          88.86274719238281,
          442.24334716796875,
          158.75299072265625
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              88.86274719238281,
              442.23834228515625,
              98.75274658203125
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Cuando HaShem retrajo Su Luz Infinita desde el punto central para formar el "
          },
          {
            "bbox": [
              53.858299255371094,
              100.5487060546875,
              442.24334716796875,
              110.91483306884766
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "jalal hapanui a través del proceso del tzimtzum, el reshimu, una impresión residual "
          },
          {
            "bbox": [
              53.858306884765625,
              112.5487060546875,
              442.2402648925781,
              122.75274658203125
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "de esa Luz, quedó en el espacio primordial. La luz imperceptible del reshimu, que "
          },
          {
            "bbox": [
              53.8582763671875,
              124.60209655761719,
              441.5702819824219,
              134.8309326171875
            ],
            "ids": [
              [
                2,
                3
              ]
            ],
            "text": "quedó igual que una reminiscencia luego de la puesta del sol, sustentó el jalal "
          },
          {
            "bbox": [
              53.8582763671875,
              136.5487060546875,
              442.239990234375,
              146.9148406982422
            ],
            "ids": [
              [
                2,
                4
              ]
            ],
            "text": "hapanui junto con el Rayo de la Luz original que HaShem introdujo allí.[3] Pues nada "
          },
          {
            "bbox": [
              53.858001708984375,
              148.8629913330078,
              394.387939453125,
              158.75299072265625
            ],
            "ids": [
              [
                2,
                5
              ]
            ],
            "text": "puede existir a no ser que contenga al menos una traza de la Luz Infinita."
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          53.85797119140625,
          166.21795654296875,
          442.2420959472656,
          248.4219970703125
        ],
        "lines": [
          {
            "bbox": [
              82.25800323486328,
              166.21795654296875,
              442.237060546875,
              176.4219970703125
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Los kabalistas explican que la luz del reshimu se volvió la materia de la "
          },
          {
            "bbox": [
              53.8580322265625,
              178.2408447265625,
              442.2409973144531,
              188.59934997558594
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "creación. Como la sustancia (recipiente) de las sefirot, las emanaciones Divinas que "
          },
          {
            "bbox": [
              53.858001708984375,
              190.21795654296875,
              442.237060546875,
              200.59934997558594
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "actúan como canales o filtros para revelar el Ein Sof, el reshimu limitó y delineó la "
          },
          {
            "bbox": [
              53.85797119140625,
              202.4619903564453,
              442.2420959472656,
              212.4219970703125
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "Luz Infinita de HaShem para que pudiera ser llevada hacia el ámbito finito del límite "
          },
          {
            "bbox": [
              53.85797119140625,
              214.21795654296875,
              441.5719299316406,
              224.4219970703125
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "y del número. Hasta que no se produjo esa manifestación, sólo la luz del reshimu "
          },
          {
            "bbox": [
              53.85797119140625,
              226.4619903564453,
              442.2279052734375,
              236.4219970703125
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "llenaba el Vacío, como la sensación de una presencia ya ida pero que nunca partió "
          },
          {
            "bbox": [
              53.85797119140625,
              238.57199096679688,
              129.50794982910156,
              248.4219970703125
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "completamente."
          }
        ]
      },
      {
        "index": 5,
        "class": "section-header",
        "bbox": [
          53.85820007324219,
          262.4999694824219,
          151.4241943359375,
          273.14697265625
        ],
        "lines": [
          {
            "bbox": [
              53.85820007324219,
              262.4999694824219,
              151.4241943359375,
              273.14697265625
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "Kav (Rayo o Línea)"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.858184814453125,
          280.7081298828125,
          442.24224853515625,
          324.44097900390625
        ],
        "lines": [
          {
            "bbox": [
              82.2582015991211,
              280.7081298828125,
              442.24224853515625,
              290.69097900390625
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "Luego del primer tzimtzum, HaShem continuó retirando Su Presencia "
          },
          {
            "bbox": [
              53.85820007324219,
              292.4869384765625,
              442.2391052246094,
              302.8530578613281
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "y expandiendo el tamaño del jalal hapanui. Una vez que la Luz Infinita fue "
          },
          {
            "bbox": [
              53.858184814453125,
              304.4869384765625,
              442.24017333984375,
              314.69097900390625
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "constreñida y retraída hacia los extremos, lo que quedó en el Vacío fue el reshimu, "
          },
          {
            "bbox": [
              53.85821533203125,
              316.8409729003906,
              132.3181915283203,
              324.44097900390625
            ],
            "ids": [
              [
                5,
                3
              ]
            ],
            "text": "la reminiscencia."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          53.85821533203125,
          334.1798400878906,
          442.2443542480469,
          378.1109924316406
        ],
        "lines": [
          {
            "bbox": [
              82.25821685791016,
              334.1798400878906,
              441.56427001953125,
              344.538330078125
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "HaShem hizo entrar entonces un kav, un Rayo o Línea, desde el Or Ein Sof "
          },
          {
            "bbox": [
              53.85821533203125,
              346.2027282714844,
              442.2443542480469,
              356.3609924316406
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "hacia dentro del Vacío. Este kav, que descendió desde el límite del Espacio Vacío "
          },
          {
            "bbox": [
              53.85821533203125,
              358.4010009765625,
              442.2312927246094,
              368.3609924316406
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "hacia el exacto centro de ese Espacio, significa la revelación de la Inmanencia de "
          },
          {
            "bbox": [
              53.85821533203125,
              370.2103576660156,
              247.7501983642578,
              378.1109924316406
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "HaShem en la Creación. Escribe el Ari zal:"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          82.25830078125,
          387.6111145019531,
          411.2995300292969,
          477.2873229980469
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              387.6111145019531,
              411.29937744140625,
              397.4589538574219
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "Este kav descendió hacia el jalal hapanui en etapas. El kav, en su extremo "
          },
          {
            "bbox": [
              82.25921630859375,
              399.0328674316406,
              410.6561584472656,
              408.8734436035156
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "superior, estaba en contacto con el Or Ein Sof [que rodeaba el jalal "
          },
          {
            "bbox": [
              82.25918579101562,
              410.4111022949219,
              411.29193115234375,
              420.2589416503906
            ],
            "ids": [
              [
                7,
                2
              ]
            ],
            "text": "hapanui], extendiéndose [dentro del Vacío hacia el extremo final], pero no "
          },
          {
            "bbox": [
              82.25918579101562,
              421.86181640625,
              410.660888671875,
              431.5792236328125
            ],
            "ids": [
              [
                7,
                3
              ]
            ],
            "text": "totalmente hacia la extremidad final [para no producir el colapso del jalal "
          },
          {
            "bbox": [
              82.25918579101562,
              433.2110900878906,
              411.29644775390625,
              443.07342529296875
            ],
            "ids": [
              [
                7,
                4
              ]
            ],
            "text": "hapanui y su desaparición en el Or Ein Sof]. Por medio de ese kav [como un "
          },
          {
            "bbox": [
              82.25918579101562,
              444.6328430175781,
              411.2995300292969,
              454.4734191894531
            ],
            "ids": [
              [
                7,
                5
              ]
            ],
            "text": "conducto], el Or Ein Sof fue hecho descender y expandir… El flujo de la Luz "
          },
          {
            "bbox": [
              82.2591781616211,
              456.242919921875,
              411.2976379394531,
              465.7049255371094
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "Superior del Infinito se difundió y fluyó hacia abajo para transformarse en "
          },
          {
            "bbox": [
              82.2591781616211,
              468.22161865234375,
              273.5084533691406,
              477.2873229980469
            ],
            "ids": [
              [
                7,
                7
              ]
            ],
            "text": "los mundos dentro del Vacío (Etz Jaim 1:2)."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.857269287109375,
          485.294921875,
          442.2392578125,
          555.6763305664062
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              485.294921875,
              442.2344055175781,
              495.6610412597656
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Dentro del jalal hapanui, el kav asumió dos modos complementarios: el de los "
          },
          {
            "bbox": [
              53.85829162597656,
              497.294921875,
              442.2353210449219,
              507.49896240234375
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "igulim (esferas, similares a las capas de la cebolla) y iosher (lineal, parecido a un ser "
          },
          {
            "bbox": [
              53.8572998046875,
              509.3406982421875,
              442.234375,
              519.4989624023438
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "humano de pie). Los kabalistas explican que el kav de Luz descendió y se extendió "
          },
          {
            "bbox": [
              53.857269287109375,
              521.3178100585938,
              442.2392578125,
              531.6763305664062
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "primero a partir del Ein Sof, fluyendo hacia el Espacio Vacío en la forma de igulim, "
          },
          {
            "bbox": [
              53.8572998046875,
              533.5389404296875,
              442.22943115234375,
              543.4989624023438
            ],
            "ids": [
              [
                8,
                4
              ]
            ],
            "text": "formando entonces sucesivas esferas concéntricas, irradiadas hacia adentro a partir "
          },
          {
            "bbox": [
              53.8572998046875,
              545.3178100585938,
              176.17529296875,
              555.6763305664062
            ],
            "ids": [
              [
                8,
                5
              ]
            ],
            "text": "del Or Ein Sof circundante."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          82.25830078125,
          562.7926025390625,
          413.7513427734375,
          595.412353515625
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              562.7926025390625,
              413.7438659667969,
              572.4429931640625
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "La Luz del kav se extendió a lo largo del perímetro externo del Espacio "
          },
          {
            "bbox": [
              82.25830078125,
              574.3819580078125,
              413.7325134277344,
              583.8439331054688
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "esférico, que posee similarmente un aspecto esférico… con ello creó la "
          },
          {
            "bbox": [
              82.25830078125,
              585.4196166992188,
              413.7513427734375,
              595.412353515625
            ],
            "ids": [
              [
                9,
                2
              ]
            ],
            "text": "primera sefirá, Kéter, la más cercana al Ein Sof. Luego de esto el kav descendió "
          }
        ]
      },
      {

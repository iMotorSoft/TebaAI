              177.92098999023438
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "2 ■ LA “PLEGARIA DE JUICIO” DE GUEVURÁ"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          82.25810241699219,
          186.2010040283203,
          411.35003662109375,
          229.83099365234375
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              186.2010040283203,
              411.3480529785156,
              195.7209930419922
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "El Rabí Natán comienza su discurso conectando la renovación personal al "
          },
          {
            "bbox": [
              82.25810241699219,
              198.2010040283203,
              411.34796142578125,
              207.7209930419922
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "despertar con la renovación del mundo que coincidirá con la resurrección "
          },
          {
            "bbox": [
              82.25810241699219,
              210.2010040283203,
              411.35003662109375,
              219.77099609375
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "de los muertos. En un sentido más profundo, ambos significan el despertar "
          },
          {
            "bbox": [
              82.25810241699219,
              222.12100219726562,
              119.58809661865234,
              229.83099365234375
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "del daat."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.858001708984375,
          239.88999938964844,
          442.33001708984375,
          309.8499755859375
        ],
        "lines": [
          {
            "bbox": [
              82.25810241699219,
              239.88999938964844,
              442.2241516113281,
              249.85000610351562
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "Todo esto que hemos sintetizado de la lección del Rebe con respecto al "
          },
          {
            "bbox": [
              53.85810089111328,
              251.53916931152344,
              442.2373046875,
              261.8500061035156
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "tikún del daat se relaciona con el despertar. El retorno del alma sensible al cuerpo "
          },
          {
            "bbox": [
              53.85810852050781,
              263.7099914550781,
              442.328125,
              273.8600158691406
            ],
            "ids": [
              [
                9,
                2
              ]
            ],
            "text": "cada mañana es análogo a la resurrección de los muertos en el futuro que, en sí "
          },
          {
            "bbox": [
              53.85809326171875,
              275.5899963378906,
              442.238037109375,
              285.8500061035156
            ],
            "ids": [
              [
                9,
                3
              ]
            ],
            "text": "misma, ejemplifi ca el jidush haolam.[34] Esto está sustentado por las palabras de "
          },
          {
            "bbox": [
              53.858001708984375,
              287.7099609375,
              442.33001708984375,
              297.8599853515625
            ],
            "ids": [
              [
                9,
                4
              ]
            ],
            "text": "la bendición que recitamos diariamente al despertar, “Bendito eres Tú… Quien "
          },
          {
            "bbox": [
              53.858001708984375,
              299.8690185546875,
              256.6878356933594,
              309.8499755859375
            ],
            "ids": [
              [
                9,
                5
              ]
            ],
            "text": "restaura el alma a los cuerpos muertos”.[35]"
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          82.25830078125,
          317.5389709472656,
          411.3482971191406,
          351.0589904785156
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              317.5389709472656,
              411.34027099609375,
              327.0589904785156
            ],
            "ids": [
              [
                10,
                0
              ]
            ],
            "text": "El Rabí Natán enfatiza el beneficio de despertar en la medida en que el "
          },
          {
            "bbox": [
              82.25830078125,
              329.458984375,
              411.3482971191406,
              337.1689758300781
            ],
            "ids": [
              [
                10,
                1
              ]
            ],
            "text": "sueño es esencialmente una restricción del daat. Pero aun así reconoce el "
          },
          {
            "bbox": [
              82.25830078125,
              341.5389709472656,
              299.5482482910156,
              351.0589904785156
            ],
            "ids": [
              [
                10,
                2
              ]
            ],
            "text": "valor del dormir como un descanso para la mente."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          53.858001708984375,
          359.0479736328125,
          442.3323059082031,
          429.18798828125
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              359.0479736328125,
              442.331298828125,
              369.18798828125
            ],
            "ids": [
              [
                11,
                0
              ]
            ],
            "text": "En su raíz, el despertar deriva principalmente de todos los tikunim "
          },
          {
            "bbox": [
              53.858306884765625,
              371.2279968261719,
              442.330322265625,
              380.50799560546875
            ],
            "ids": [
              [
                11,
                1
              ]
            ],
            "text": "mencionados en la lección del Rebe. Por el contrario, la necesidad de dormir "
          },
          {
            "bbox": [
              53.858306884765625,
              383.0279846191406,
              442.2403564453125,
              393.18798828125
            ],
            "ids": [
              [
                11,
                2
              ]
            ],
            "text": "es resultado de una restricción de los mojín y de su desorientación como "
          },
          {
            "bbox": [
              53.85833740234375,
              393.0464782714844,
              442.3323059082031,
              405.26617431640625
            ],
            "ids": [
              [
                11,
                3
              ]
            ],
            "text": "consecuencia del daño del daat por parte de Sitra Ájara. Esto proviene del hecho "
          },
          {
            "bbox": [
              53.85833740234375,
              405.0464782714844,
              442.2400207519531,
              417.26617431640625
            ],
            "ids": [
              [
                11,
                4
              ]
            ],
            "text": "de que “la serpiente era muy astuta”,[36]pues la serpiente/Sitra Ájara incluso ahora "
          },
          {
            "bbox": [
              53.858001708984375,
              419.3379821777344,
              385.2160949707031,
              429.18798828125
            ],
            "ids": [
              [
                11,
                5
              ]
            ],
            "text": "se adhiere a la mente humana debido al pecado del primer hombre."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          53.85797119140625,
          434.1730041503906,
          442.33203125,
          516.02294921875
        ],
        "lines": [
          {
            "bbox": [
              82.25800323486328,
              434.1730041503906,
              442.318115234375,
              444.02301025390625
            ],
            "ids": [
              [
                11,
                6
              ]
            ],
            "text": "Cada uno debe librar una gran batalla con los pensamientos para "
          },
          {
            "bbox": [
              53.858001708984375,
              443.8815002441406,
              442.3230285644531,
              456.1011962890625
            ],
            "ids": [
              [
                11,
                7
              ]
            ],
            "text": "purifi carlos del control de Sitra Ájara, de “la serpiente era muy astuta”. Esto "
          },
          {
            "bbox": [
              53.858001708984375,
              458.1730041503906,
              442.323974609375,
              468.03302001953125
            ],
            "ids": [
              [
                11,
                8
              ]
            ],
            "text": "explica la necesidad del dormir. Pues en el momento en que la mente queda "
          },
          {
            "bbox": [
              53.858001708984375,
              470.16302490234375,
              442.33203125,
              480.02301025390625
            ],
            "ids": [
              [
                11,
                9
              ]
            ],
            "text": "sobresaturada y confusa debido a esa batalla mental con el mal, se hace necesario "
          },
          {
            "bbox": [
              53.85797119140625,
              480.1830139160156,
              442.3299560546875,
              492.03302001953125
            ],
            "ids": [
              [
                11,
                10
              ]
            ],
            "text": "el dormir, que es un descanso para los mojín. Pero entonces el “Sitra Ájara se "
          },
          {
            "bbox": [
              53.85797119140625,
              493.7629699707031,
              442.330078125,
              504.0329895019531
            ],
            "ids": [
              [
                11,
                11
              ]
            ],
            "text": "instala en sus manos”,[37] dado que su poder se manifi esta principalmente con la "
          },
          {
            "bbox": [
              53.858001708984375,
              505.8629455566406,
              155.07701110839844,
              516.02294921875
            ],
            "ids": [
              [
                11,
                12
              ]
            ],
            "text": "partida de los mojín."
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          82.25799560546875,
          523.4720458984375,
          411.3499755859375,
          545.2820434570312
        ],
        "lines": [
          {
            "bbox": [
              82.25800323486328,
              523.4720458984375,
              411.3499755859375,
              533.2319946289062
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "El Rabí Natán revela cómo, al recitar el Kriat Shemá al HaMita y al unirse "
          },
          {
            "bbox": [
              82.25799560546875,
              535.6320190429688,
              408.5709228515625,
              545.2820434570312
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "con los Tzadikim uno puede mitigar la restricción del daat durante el dormir."
          }
        ]
      },
      {
        "index": 11,
        "class": "footnote",
        "bbox": [
          53.858299255371094,
          584.638427734375,
          126.42155456542969,
          591.464599609375
        ],
        "lines": [

          217.39698791503906,
          411.35015869140625,
          240.1669921875
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              217.39698791503906,
              411.35015869140625,
              226.91697692871094
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Para concluir, el Rabí Natán hace referencia a un último concepto de la "
          },
          {
            "bbox": [
              82.25830078125,
              230.35699462890625,
              377.5873107910156,
              240.1669921875
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "lección del Rebe Najmán: el poder de la tzedaka para mitigar el din."
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          53.858001708984375,
          248.1070098876953,
          439.37030029296875,
          343.44708251953125
        ],
        "lines": [
          {
            "bbox": [
              82.25830078125,
              248.1070098876953,
              436.4103088378906,
              258.25701904296875
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Esto también se relaciona con lo que el Rebe escribe en otra instancia"
          },
          {
            "bbox": [
              53.8582763671875,
              260.04296875,
              429.2462463378906,
              270.25701904296875
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "que el levantarse a medianoche y lamentar la destrucción del Beit HaMikdash "
          },
          {
            "bbox": [
              53.858306884765625,
              271.98699951171875,
              442.3290100097656,
              282.24700927734375
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "tan efi caz como dar un pidion.[53, 54]La analogía con un pidion es precisa, pues "
          },
          {
            "bbox": [
              53.858001708984375,
              284.0505676269531,
              442.33001708984375,
              294.2569885253906
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "el pidion es una forma de tzedaka, y ya hemos visto que dar tzedaka quiebra "
          },
          {
            "bbox": [
              53.858001708984375,
              296.2869873046875,
              442.3260803222656,
              306.2470703125
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "el deseo de dinero y así mitiga los dinim.[55]Lo mismo es verdad con respecto "
          },
          {
            "bbox": [
              53.858001708984375,
              308.0506591796875,
              442.24005126953125,
              318.4091491699219
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "al levantarse a medianoche; es como dar un pidion. Al levantarse a medianoche "
          },
          {
            "bbox": [
              53.858001708984375,
              320.3970642089844,
              442.3270263671875,
              330.257080078125
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "uno quiebra el deseo de dormir, que corresponde a quebrar el deseo de dinero, "
          },
          {
            "bbox": [
              53.858001708984375,
              333.30706787109375,
              388.6658020019531,
              343.44708251953125
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "mediante lo cual se mitigan los dinim, como se explicó más arriba.[56]"
          }
        ]

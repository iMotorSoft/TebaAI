              96.43148803710938,
              153.4530029296875,
              428.2541809082031,
              162.12100219726562
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "Los discursos del Rabí Natán en Hashkamat HaBoker – “Levantándose "
          },
          {
            "bbox": [
              68.03057861328125,
              166.91702270507812,
              428.24774169921875,
              177.4440155029297
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "por la Mañana”, se basan en las siguientes leyes que se encuentran en el "
          },
          {
            "bbox": [
              68.03057861328125,
              179.85302734375,
              129.9154815673828,
              191.16102600097656
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "Shuljan Aruj:"
          }
        ]
      },
      {
        "index": 4,
        "class": "text",
        "bbox": [
          68.03150177001953,
          205.82498168945312,
          428.3570251464844,
          254.54498291015625
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              205.82498168945312,
              428.3526306152344,
              216.14498901367188
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "La persona debe fortalecerse como un león para levantarse por la mañana "
          },
          {
            "bbox": [
              68.03150177001953,
              219.02499389648438,
              425.1955871582031,
              229.42498779296875
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "en el servicio a su Creador, de modo que sea ella quien despierte el alba."
          },
          {
            "bbox": [
              68.03150177001953,
              232.2249755859375,
              428.3570251464844,
              242.54498291015625
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "Glosa:“He puesto a HaShem siempre delante de mí”(Tehilim 16:8)- éste es un "
          },
          {
            "bbox": [
              68.031982421875,
              244.2249755859375,
              338.78753662109375,
              254.54498291015625
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "principio muy importante en el cumplimiento de la Torá.[*]"
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          371.3500061035156,
          256.6674499511719,
          425.19671630859375,
          264.92095947265625
        ],
        "lines": [
          {
            "bbox": [
              371.3500061035156,
              256.6674499511719,
              425.19671630859375,
              264.92095947265625
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": "(Oraj Jaim 1:1)"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          68.03150177001953,
          277.8249816894531,
          428.35455322265625,
          301.3450012207031
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              277.8249816894531,
              428.35455322265625,
              288.2249755859375
            ],
            "ids": [
              [
                5,
                0
              ]
            ],
            "text": "Es apropiado que toda persona temerosa de HaShem sienta dolor y angustia "
          },
          {
            "bbox": [
              68.03150177001953,
              291.0249938964844,
              251.95851135253906,
              301.3450012207031
            ],
            "ids": [
              [
                5,
                1
              ]
            ],
            "text": "por la destrucción del Beit HaMikdash."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          387.3890075683594,
          303.1869812011719,
          425.1971130371094,
          310.6839904785156
        ],
        "lines": [
          {
            "bbox": [
              387.3890075683594,
              303.1869812011719,
              425.1971130371094,
              310.6839904785156
            ],
            "ids": [
              [
                5,
                2
              ]
            ],
            "text": "(ibid. 1:3)."
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          68.03150177001953,
          327.02496337890625,
          428.3544921875,
          362.54498291015625
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              327.02496337890625,
              428.3544921875,
              337.4249572753906
            ],
            "ids": [
              [
                6,
                0
              ]
            ],
            "text": "La persona debe colocarse el zapato derecho primero pero no atarlo. Luego "
          },
          {
            "bbox": [
              68.03150177001953,
              339.02496337890625,
              428.3456726074219,
              349.4249572753906
            ],
            "ids": [
              [
                6,
                1
              ]
            ],
            "text": "debe colocarse el zapato izquierdo y atarlo. Luego de ello debe atar el "
          },
          {
            "bbox": [
              68.03150177001953,
              352.3049621582031,
              143.8115234375,
              362.54498291015625
            ],
            "ids": [
              [
                6,
                2
              ]
            ],
            "text": "zapato derecho."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          392.114990234375,
          363.7869873046875,
          425.19708251953125,
          371.28399658203125
        ],
        "lines": [
          {
            "bbox": [
              392.114990234375,
              363.7869873046875,
              425.19708251953125,
              371.28399658203125
            ],
            "ids": [
              [
                6,
                3
              ]
            ],
            "text": "(ibid 2:4)"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          68.03150177001953,
          388.8250732421875,
          341.7815856933594,
          399.14508056640625
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              388.8250732421875,
              341.7815856933594,
              399.14508056640625
            ],
            "ids": [
              [
                7,
                0
              ]
            ],
            "text": "La persona no debe limpiarse utilizando la mano derecha."
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          385.0260009765625,
          400.386962890625,
          425.1971130371094,
          407.88397216796875
        ],
        "lines": [
          {
            "bbox": [
              385.0260009765625,
              400.386962890625,
              425.1971130371094,
              407.88397216796875
            ],
            "ids": [
              [
                7,
                1
              ]
            ],
            "text": "(ibid. 3:10)"
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          68.03150177001953,
          424.2249755859375,
          428.3514709472656,
          458.54498291015625
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              424.2249755859375,
              428.3465881347656,
              434.54498291015625
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "La persona debe lavarse las manos y recitar la bendición “[Bendito sea "
          },
          {
            "bbox": [
              68.03150177001953,
              436.3049621582031,
              428.3514709472656,
              446.54498291015625
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "HaShem… Quien nos santificó con Sus mandamientos y nos ha ordenado] "
          },
          {
            "bbox": [
              68.03150177001953,
              448.2249755859375,
              230.5715789794922,
              458.54498291015625
            ],
            "ids": [
              [
                8,
                2
              ]
            ],
            "text": "con respecto al lavado de manos”."
          }
        ]
      },
      {
        "index": 13,
        "class": "text",
        "bbox": [
          389.75201416015625,
          460.3869934082031,
          425.1971130371094,
          467.8840026855469
        ],
        "lines": [
          {
            "bbox": [
              389.75201416015625,
              460.3869934082031,
              425.1971130371094,
              467.8840026855469
            ],
            "ids": [
              [
                8,
                3
              ]
            ],
            "text": "(ibid. 4:1)"
          }
        ]
      },
      {
        "index": 14,
        "class": "text",
        "bbox": [
          68.03150177001953,
          483.7869567871094,
          242.6456756591797,
          491.92144775390625
        ],
        "lines": [
          {
            "bbox": [
              68.03150177001953,
              483.7869567871094,
              242.6456756591797,
              491.92144775390625
            ],
            "ids": [
              [
                9,
                0
              ]
            ],
            "text": "*La versión completa de la glosa del Rama dice:"
          }
        ]
      },
      {
        "index": 15,
        "class": "text",
        "bbox": [
          68.03094482421875,
          493.9869689941406,
          427.56854248046875,
          644.9469604492188
        ],
        "lines": [
          {
            "bbox": [
              96.43114471435547,
              493.9869689941406,
              427.5609130859375,
              502.1214599609375
            ],
            "ids": [
              [
                9,
                1
              ]
            ],
            "text": "En todo caso, uno no debe retrasar la plegaria más allá del tiempo en que la congregación "
          },
          {
            "bbox": [
              68.03094482421875,
              504.1869812011719,
              427.5625915527344,
              512.2789916992188
            ],
            "ids": [
              [
                9,
                2
              ]
            ],
            "text": "está orando. “He puesto a HaShem siempre delante de mí” - éste es un principio muy importante "
          },
          {
            "bbox": [
              68.03094482421875,
              514.3870239257812,
              427.55816650390625,
              522.47900390625
            ],
            "ids": [
              [
                9,
                3
              ]
            ],
            "text": "en el cumplimiento de la Torá y una de las virtudes de los rectos que caminan ante HaShem. "
          },
          {
            "bbox": [
              68.03094482421875,
              524.5869750976562,
              427.54888916015625,
              532.678955078125
            ],
            "ids": [
              [
                9,
                4
              ]
            ],
            "text": "Porque cuando la persona está sola en su casa, se sienta y se mueve de manera diferente que "
          },
          {
            "bbox": [
              68.03094482421875,
              534.7869873046875,
              427.550537109375,
              542.9214477539062
            ],
            "ids": [
              [
                9,
                5
              ]
            ],
            "text": "cuando se encuentra en presencia de un gran rey. Cuando está en compañía de miembros de su "
          },
          {
            "bbox": [
              68.03094482421875,
              544.9869995117188,
              427.5625305175781,
              553.0789794921875
            ],
            "ids": [
              [
                9,
                6
              ]
            ],
            "text": "casa y de su familia habla de manera diferente y utiliza sus palabras con mucha más libertad que "
          },
          {
            "bbox": [
              68.03094482421875,
              555.1869506835938,
              427.5684814453125,
              563.2789306640625
            ],
            "ids": [
              [
                9,
                7
              ]
            ],
            "text": "cuando se encuentra en una asamblea de nobles. Más aún cuando la persona reconoce que sobre "
          },
          {
            "bbox": [
              68.03094482421875,
              565.2509155273438,
              427.5599060058594,
              573.9209594726562
            ],
            "ids": [
              [
                9,
                8
              ]
            ],
            "text": "ella se encuentra el Gran Rey, HaKadosh Baruj Hu, cuya gloria llena el mundo entero, Quien "
          },
          {
            "bbox": [
              68.03094482421875,
              575.5869750976562,
              427.5497131347656,
              583.721435546875
            ],
            "ids": [
              [
                9,
                9
              ]
            ],
            "text": "observa sus acciones como está escrito, “‘¿Acaso podrá ocultarse el hombre en lugares secretos "
          },
          {
            "bbox": [
              68.03094482421875,
              585.7869873046875,
              427.55999755859375,
              593.8789672851562
            ],
            "ids": [
              [
                9,
                10
              ]
            ],
            "text": "para que Yo no lo vea?’, dice HaShem” (Jeremías 23:24). El temor a HaShem que experimenta "
          },
          {
            "bbox": [
              68.03094482421875,
              595.9869995117188,
              427.5499572753906,
              604.0789794921875
            ],
            "ids": [
              [
                9,
                11
              ]
            ],
            "text": "la persona la imbuye instantáneamente de reverencia, pero también de humildad, de modo que "
          },
          {
            "bbox": [
              68.03094482421875,
              606.1869506835938,
              427.5641174316406,
              614.3214111328125
            ],
            "ids": [
              [
                9,
                12
              ]
            ],
            "text": "siempre siente que está en Su presencia. Nunca debe sentir vergüenza alguna cuando los demás se "
          },
          {
            "bbox": [
              68.03094482421875,
              616.386962890625,
              427.56854248046875,
              624.5469360351562
            ],
            "ids": [
              [
                9,
                13
              ]
            ],
            "text": "burlan de sus devociones a HaShem. Que siempre se conduzca con modestia. Y cuando se acueste "
          },
          {
            "bbox": [
              68.03094482421875,
              626.5869750976562,
              427.56610107421875,
              634.7469482421875
            ],
            "ids": [
              [
                9,
                14
              ]
            ],
            "text": "en su lecho deberá saber delante de Quién está yaciendo; y tan pronto como se despierte del sueño "
          },
          {
            "bbox": [
              68.03094482421875,
              636.7869873046875,
              412.86773681640625,
              644.9469604492188
            ],
            "ids": [
              [
                9,
                15
              ]
            ],
            "text": "deberá levantarse con celeridad para el servicio a su Creador, Quien es bendecido y exaltado."
          }
        ]
      }
    ]
  },

            "bbox": [
              255.4488983154297,
              615.1585693359375,
              444.0976257324219,
              621.9700927734375
            ],
            "ids": [
              [
                13,
                2
              ]
            ],
            "text": "que el levantarse en la noche para estudiar Torá es lo que nos "
          },
          {
            "bbox": [
              255.4488983154297,
              624.1585693359375,
              374.7783203125,
              630.9700927734375
            ],
            "ids": [

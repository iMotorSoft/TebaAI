                4,
                1
              ],
              [
                15,
                1
              ]
            ],
            "text": "superior, entra en la emuná. Esto es como en el versículo, mañana; grande es "
          },
          {
            "bbox": [
              53.62196350097656,
              515.6309814453125,
              415.22918701171875,
              525.7909545898438
            ],
            "ids": [
              [
                4,
                2
              ],
              [
                15,
                2
              ]
            ],
            "text": "“Nuevas son cada mañana; grande es tu emuná”, aludiendo a la Tu emuná”."
          },
          {
            "bbox": [
              53.6219482421875,
              527.4495849609375,
              439.78399658203125,
              537.7909545898438
            ],
            "ids": [
              [
                4,
                3
              ],
              [
                15,
                3
              ]
            ],

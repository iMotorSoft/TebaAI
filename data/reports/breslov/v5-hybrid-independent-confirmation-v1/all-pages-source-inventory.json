            "bbox": [
              53.858299255371094,
              511.0059509277344,
              442.23431396484375,
              520.9659423828125
            ],
            "ids": [
              [
                7,
                6
              ]
            ],
            "text": "con nuestros diferentes estados de ánimo y sentimientos, día tras día, momento a "
          },
          {
            "bbox": [

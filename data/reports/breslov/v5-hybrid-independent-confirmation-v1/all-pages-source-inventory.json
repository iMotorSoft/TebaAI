            "bbox": [
              252.6142578125,
              533.2674560546875,
              441.2452392578125,
              540.0936279296875
            ],
            "ids": [
              [
                9,
                15
              ]
            ],
            "text": "hecho de que Maljut se asocia con la letra hebrea dalet ( .)ד"

              53.85821533203125,
              554.3179931640625,
              442.3302917480469,
              564.468017578125
            ],
            "ids": [
              [
                4,
                15
              ]
            ],
            "text": "ese punto también esté mezclado con muchas impurezas, éste tiene que tener "
          }

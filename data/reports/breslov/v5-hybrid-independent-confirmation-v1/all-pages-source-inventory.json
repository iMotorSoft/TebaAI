              175.02365112304688,
              348.7001953125,
              185.364990234375
            ],
            "ids": [
              [
                1,
                0
              ]
            ],
            "text": "la emuná se eliminan todas las cuestiones que la socavan y "
          },
          {
            "bbox": [
              54.08819580078125,
              187.02365112304688,
              348.7872009277344,
              197.44317626953125
            ],
            "ids": [
              [
                1,
                1
              ]
            ],
            "text": "HaKadosh Baruj Hu y Su Shejiná se unen en un estado de ijud. La "
          },
          {
            "bbox": [
              54.08819580078125,
              199.02365112304688,
              348.78729248046875,
              209.44317626953125
            ],
            "ids": [
              [
                1,
                2
              ]
            ],
            "text": "emuná, la Shejiná, ruega entonces y pide delante de HaShem "
          },
          {
            "bbox": [
              54.08819580078125,
              211.22499084472656,
              348.7842102050781,
              221.37498474121094
            ],
            "ids": [
              [
                1,
                3
              ]
            ],
            "text": "en aras de los que están espiritualmente lejos, solicitando "
          },
          {
            "bbox": [
              54.08819580078125,
              221.42498779296875,
              145.418212890625,
              233.37498474121094
            ],
            "ids": [
              [
                1,
                4
              ]
            ],
            "text": "que Él los acerque."
          }
        ]
      },
      {
        "index": 5,
        "class": "text",
        "bbox": [
          54.08799743652344,
          238.00357055664062,
          348.7872009277344,
          284.2781677246094
        ],
        "lines": [
          {
            "bbox": [
              82.48819732666016,
              238.00357055664062,
              348.7872009277344,
              248.27816772460938
            ],
            "ids": [
              [
                1,
                5
              ]
            ],
            "text": "Este ijud está aludido en el versículo “Entonces Iehudá "
          },
          {
            "bbox": [
              54.08819580078125,
              250.0599822998047,
              348.7861328125,
              260.1999816894531
            ],
            "ids": [
              [
                1,
                6
              ]
            ],
            "text": "se acercó a [Iosef]”. Los comentarios explican que esto es “el "
          },
          {
            "bbox": [
              54.088165283203125,
              262.218994140625,
              348.6980285644531,
              272.1999816894531
            ],
            "ids": [
              [
                1,
                7
              ]
            ],
            "text": "acercarse de un rey a otro rey”,[29] aludiendo a la unificación de "
          },
          {
            "bbox": [
              54.08799743652344,
              273.858642578125,
              219.52084350585938,
              284.2781677246094
            ],
            "ids": [
              [
                1,
                8
              ]
            ],
            "text": "HaKadosh Baruj Hu con la Shejiná.[30]"
          }
        ]
      },
      {
        "index": 6,
        "class": "text",
        "bbox": [
          354.33099365234375,
          174.97010803222656,
          441.4749755859375,
          248.2421417236328
        ],
        "lines": [
          {
            "bbox": [
              354.33099365234375,
              174.97010803222656,
              425.91497802734375,
              181.0500946044922
            ],
            "ids": [
              [
                12,
                0
              ]
            ],
            "text": "“Entonces Iehudá se "
          },
          {
            "bbox": [
              354.33099365234375,
              184.5701141357422,
              433.46697998046875,
              192.1861114501953
            ],
            "ids": [
              [
                12,
                1
              ]
            ],
            "text": "acercó [a Iosef] y dijo, "
          },
          {
            "bbox": [
              354.33099365234375,
              194.1701202392578,
              441.4749755859375,
              201.78611755371094
            ],
            "ids": [
              [
                12,
                2
              ]
            ],
            "text": "‘Por favor, mi señor, que "
          },
          {
            "bbox": [
              354.33099365234375,
              203.77012634277344,
              436.13897705078125,
              211.38612365722656
            ],
            "ids": [
              [
                12,
                3
              ]
            ],
            "text": "su siervo pueda decirle "
          },
          {
            "bbox": [
              354.33099365234375,
              213.37013244628906,
              439.2509765625,
              221.026123046875
            ],
            "ids": [
              [
                12,
                4
              ]
            ],
            "text": "algo personalmente. No "
          },
          {
            "bbox": [
              354.33099365234375,
              223.3781280517578,
              431.69097900390625,
              230.29812622070312
            ],
            "ids": [
              [
                12,
                5
              ]
            ],
            "text": "se irrite con su siervo, "
          },
          {
            "bbox": [
              354.33099365234375,
              232.5701446533203,
              432.58697509765625,
              240.18614196777344
            ],
            "ids": [
              [
                12,
                6
              ]
            ],
            "text": "pues usted es como el "
          },
          {
            "bbox": [
              354.33099365234375,
              242.17015075683594,
              384.114990234375,
              248.2421417236328
            ],
            "ids": [
              [
                12,
                7
              ]
            ],
            "text": "faraón’”."
          }
        ]
      },
      {
        "index": 7,
        "class": "text",
        "bbox": [
          354.33099365234375,
          252.24996948242188,
          402.3739929199219,
          258.8261413574219
        ],
        "lines": [
          {
            "bbox": [
              354.33099365234375,
              252.24996948242188,
              402.3739929199219,
              258.8261413574219
            ],
            "ids": [
              [
                12,
                8
              ]
            ],
            "text": "(Bereshit 44:18)"
          }
        ]
      },
      {
        "index": 8,
        "class": "text",
        "bbox": [
          82.48819732666016,
          298.219970703125,
          411.5861511230469,
          331.03997802734375
        ],
        "lines": [
          {
            "bbox": [
              82.48819732666016,
              298.219970703125,
              411.5861511230469,
              307.739990234375
            ],
            "ids": [
              [
                2,
                0
              ]
            ],
            "text": "El Midrash enseña que Iehudá le dijo a Iosef, “Pues usted es como el faraón” "
          },
          {
            "bbox": [
              82.48819732666016,
              310.219970703125,
              411.5820617675781,
              319.739990234375
            ],
            "ids": [
              [
                2,
                1
              ]
            ],
            "text": "- así como el faraón decreta pero no lleva a cabo, también usted decreta pero "
          },
          {
            "bbox": [
              82.48819732666016,
              322.0599670410156,
              251.06719970703125,
              331.03997802734375
            ],
            "ids": [
              [
                2,
                2
              ]
            ],
            "text": "no lleva a cabo” (Bereshit Rabah 93:6)."
          }
        ]
      },
      {
        "index": 9,
        "class": "text",
        "bbox": [
          54.08800506591797,
          345.1976318359375,
          442.56024169921875,
          449.2889709472656
        ],
        "lines": [
          {
            "bbox": [
              82.48822021484375,
              345.1976318359375,
              442.4702453613281,
              355.6171569824219
            ],
            "ids": [
              [
                3,
                0
              ]
            ],
            "text": "Cuando están unidos en un ijud, la Shejiná Le ruega HaKadosh Baruj Hu para "
          },
          {
            "bbox": [
              54.0882568359375,
              357.5789794921875,
              442.56024169921875,
              367.5389709472656
            ],
            "ids": [
              [
                3,
                1
              ]
            ],
            "text": "que demuestre compasión ante los que están espiritualmente lejos. Ella dice, “Pues "
          },
          {
            "bbox": [
              54.0882568359375,
              369.1976318359375,
              442.4702453613281,
              379.71630859375
            ],
            "ids": [
              [
                3,
                2
              ]
            ],
            "text": "usted es como el faraón”. En otras palabras, “Tú eres conocido sólo a partir de feraó, "
          },
          {
            "bbox": [
              54.088287353515625,
              381.5580139160156,
              442.4710998535156,
              391.5389709472656
            ],
            "ids": [
              [
                3,
                3
              ]
            ],
            "text": "de lo que está revelado[31] - es decir, un mundo gobernado ostensiblemente por la "
          },
          {
            "bbox": [
              54.08800506591797,
              393.1976318359375,
              442.4750061035156,
              403.6171569824219
            ],
            "ids": [
              [
                3,
                4
              ]
            ],
            "text": "naturaleza, en la cual está oculta Tu hashgajá. Es este ocultamiento el que hace que "
          },
          {
            "bbox": [
              54.0880126953125,
              405.1976318359375,
              441.8070373535156,
              415.6171569824219
            ],
            "ids": [
              [
                3,
                5
              ]
            ],
            "text": "la gente se equivoque con respecto a la emuná”. Así la Shejiná Le ruega HaKadosh "
          },
          {
            "bbox": [
              54.088043212890625,
              417.1976318359375,
              442.47113037109375,
              427.6171569824219
            ],
            "ids": [
              [
                3,
                6
              ]
            ],
            "text": "Baruj Hu para que le haga conocer a la gente Su hashgajá. ¿Cómo? Permitiendo "
          },
          {
            "bbox": [
              54.088043212890625,
              427.7789611816406,
              442.453125,
              439.5389709472656
            ],
            "ids": [
              [
                3,
                7
              ]
            ],
            "text": "que aquellos que están lejos de Él sean testigos del Tzadik revocando las leyes de la "
          },
          {
            "bbox": [
              54.088043212890625,
              441.5580139160156,
              111.90984344482422,
              449.2889709472656
            ],
            "ids": [
              [
                3,
                8
              ]
            ],
            "text": "naturaleza.[32]"
          }
        ]
      },
      {
        "index": 10,
        "class": "text",
        "bbox": [
          54.088287353515625,
          454.61297607421875,
          442.560302734375,
          490.37298583984375
        ],
        "lines": [
          {
            "bbox": [
              82.48829650878906,
              454.61297607421875,
              442.55828857421875,
              466.37298583984375
            ],
            "ids": [
              [
                4,
                0
              ]
            ],
            "text": " Éste es el significado de la enseñanza del Midrash, “Así como el faraón "
          },
          {
            "bbox": [
              54.088287353515625,
              468.4129943847656,
              442.560302734375,
              478.37298583984375
            ],
            "ids": [
              [
                4,
                1
              ]
            ],
            "text": "decreta, i.e., la naturaleza dicta un cierto curso de acción, de causa y efecto, pero "
          },
          {
            "bbox": [
              54.08831787109375,
              480.23297119140625,
              442.47125244140625,
              490.37298583984375
            ],
            "ids": [
              [
                4,
                2
              ]
            ],
            "text": "no lleva a cabo”, pues el Tzadik lo anula, “Tú también decretas que el mundo sea "
          }
        ]
      },
      {
        "index": 11,
        "class": "text",
        "bbox": [
          223.7449951171875,
          508.4019775390625,
          271.7160339355469,
          515.5010986328125
        ],
        "lines": [
          {
            "bbox": [
              223.7449951171875,
              508.4019775390625,
              271.7160339355469,
              515.5010986328125
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Notas y Fuentes���������������"
          }
        ]
      },
      {
        "index": 12,
        "class": "text",
        "bbox": [
          53.858299255371094,
          530.0785522460938,
          126.48979949951172,
          535.3886108398438

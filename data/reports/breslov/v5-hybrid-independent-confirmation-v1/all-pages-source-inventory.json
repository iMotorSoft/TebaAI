          445.0771789550781,
          646.798095703125
        ],
        "lines": [
          {
            "bbox": [
              85.09294891357422,
              624.6759643554688,
              445.0610046386719,
              634.635986328125
            ],
            "ids": [
              [
                8,
                0
              ]
            ],
            "text": "Más aún, hubo veces en que el Rabí Natán añadió varios tópicos en un solo "
          },
          {
            "bbox": [
              56.69294738769531,
              636.6531372070312,
              445.0771789550781,
              646.798095703125
            ],
            "ids": [
              [
                8,
                1
              ]
            ],
            "text": "discurso. Nesiat Kapaim 5 comienza con las leyes de la bendición de los sacerdotes, "
          }
        ]
      }
    ]
